; emit_module.wir
;
; Top-level LLVM module emission.
;
; Responsibilities:
;   - emit module declarations and string globals
;   - walk top-level AST declarations
;   - emit external declarations and function definitions
;
; This is the final emission entry point after parsing has produced an AST.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Program emission
; =============================================================================

;
; emit_program
;
; Emits LLVM text for `program`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;   program_node - AST_PROGRAM node index.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_program
      (params
        (ctx ptr)
        (program_node i64))
      (returns i32)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          node_count
          i64
          (call_i64
            ast_count
            (local_get ast)))
        (call_i32
          emit_module_header
          (param_get ctx))
        (call_i32
          emit_runtime_declarations
          (param_get ctx))
        (if
          (condition
            (ne_i32
              (call_i32
                emit_string_globals
                (param_get ctx))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          i
          i64
          (const_i64 0))
        (while
          (condition
            (lt_i64
              (local_get i)
              (local_get node_count)))
          (do
            (if
              (condition
                (eq_i32
                  (call_i32
                    ast_kind_at
                    (local_get ast)
                    (local_get i))
                  (call_i32 ast_function)))
              (then
                (do
                  (if
                    (condition
                      (ne_i32
                        (call_i32
                          emit_function
                          (param_get ctx)
                          (local_get i))
                        (const_i32 0)))
                    (then
                      (do
                        (return
                          (const_i32 1))))
                    (else
                      (do)))))
              (else
                (do)))
            (set
              i
              (add_i64
                (local_get i)
                (const_i64 1)))))
        (return
          (const_i32 0))))

; =============================================================================
; LLVM module entry point
; =============================================================================

;
; emit_llvm
;
; Emits LLVM text for `llvm`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   source - source buffer pointer.
;   ast - AST container pointer.
;   program_node - AST_PROGRAM node index.
;   output - output buffer pointer.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_llvm
      (params
        (source ptr)
        (ast ptr)
        (program_node i64)
        (output ptr))
      (returns i32)
      (do
        (let
          ctx
          ptr
          (call_ptr
            emit_context_new
            (param_get source)
            (param_get ast)
            (param_get output)))
        (if
          (condition
            (eq_ptr
              (local_get ctx)
              (const_null)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          status
          i32
          (call_i32
            emit_program
            (local_get ctx)
            (param_get program_node)))
        (call_void
          emit_context_free
          (local_get ctx))
        (return
          (local_get status))))))
