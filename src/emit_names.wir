; SPDX-License-Identifier: Apache-2.0
; emit_names.wir
;
; LLVM name and small formatting helpers.
;
; Responsibilities:
;   - emit temporary and label names with deterministic counters
;   - emit indentation and comments used by generated LLVM
;   - allocate the next temp or label id from the emission context
;
; Deterministic names keep golden LLVM comparisons stable.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Name formatting
; =============================================================================

;
; emit_temp_name
;
; Writes an LLVM temporary name for an existing temp id.
; Name spelling stays deterministic for golden LLVM comparisons.
;
; Parameters:
;   ctx - emission context pointer.
;   id - deterministic numeric id.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_temp_name
      (params
        (ctx ptr)
        (id i64))
      (returns i32)
      (do
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr "%t"))
        (return
          (call_i32
            emit_i64_as_i32
            (param_get ctx)
            (param_get id)))))

;
; emit_indent
;
; Writes one standard indentation unit to the output buffer.
; Formatting helpers keep generated LLVM text consistent.
;
; Parameters:
;   ctx - emission context pointer.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_indent
      (params
        (ctx ptr))
      (returns i32)
      (do
        (return
          (call_i32
            emit_cstr
            (param_get ctx)
            (const_string_ptr "  ")))))

;
; emit_temp_def_name
;
; Writes the left-hand side name for a new LLVM temporary definition.
; Definitions and references share the same temp id spelling.
;
; Parameters:
;   ctx - emission context pointer.
;   id - deterministic numeric id.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_temp_def_name
      (params
        (ctx ptr)
        (id i64))
      (returns i32)
      (do
        (call_i32
          emit_indent
          (param_get ctx))
        (return
          (call_i32
            emit_temp_name
            (param_get ctx)
            (param_get id)))))

;
; emit_comment
;
; Writes an LLVM comment containing a source text slice.
; Debug output uses this to leave breadcrumbs in generated LLVM.
;
; Parameters:
;   ctx - emission context pointer.
;   text - text pointer.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_comment
      (params
        (ctx ptr)
        (text ptr))
      (returns i32)
      (do
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr "  ; "))
        (call_i32
          emit_cstr
          (param_get ctx)
          (param_get text))
        (return
          (call_i32
            emit_newline
            (param_get ctx)))))

; =============================================================================
; Counter allocation
; =============================================================================

;
; next_temp
;
; Allocates the next deterministic temporary id from the context.
; The context counter is the single source of temporary numbering.
;
; Parameters:
;   ctx - emission context pointer.
;
; Returns:
;   allocated id.
;
(fn next_temp
      (params
        (ctx ptr))
      (returns i64)
      (do
        (let
          old
          i64
          (call_i64
            ctx_temp_counter
            (param_get ctx)))
        (call_void
          ctx_set_temp_counter
          (param_get ctx)
          (add_i64
            (local_get old)
            (const_i64 1)))
        (return
          (local_get old))))

;
; next_label
;
; Allocates the next deterministic label id from the context.
; Control-flow emission uses this to avoid label collisions.
;
; Parameters:
;   ctx - emission context pointer.
;
; Returns:
;   allocated id.
;
(fn next_label
      (params
        (ctx ptr))
      (returns i64)
      (do
        (let
          old
          i64
          (call_i64
            ctx_label_counter
            (param_get ctx)))
        (call_void
          ctx_set_label_counter
          (param_get ctx)
          (add_i64
            (local_get old)
            (const_i64 1)))
        (return
          (local_get old))))
))
