; emit_names.wir
;
; LLVM name and small formatting helpers.
;
; Responsibilities:
;   - emit temporary and label names with deterministic counters
;   - emit indentation and comments used by generated LLVM
;   - allocate the next temp or label id from the emission context
;
; Deterministic names keep golden LLVM comparisons stable.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Name formatting
; =============================================================================

; emit_temp_name
;
; Emits or computes LLVM output for temp name.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   id - Deterministic numeric id.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.

(fn
      emit_temp_name
      (params
        (ctx ptr)
        (id i64))
      (returns i32)
      (do
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr "%t"))
        (return
          (call_i32
            emit_i64_as_i32
            (param_get ctx)
            (param_get id)))))

; emit_indent
;
; Emits or computes LLVM output for indent.
;
;
; Parameters:
;   ctx - EmitContext pointer.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.

(fn
      emit_indent
      (params
        (ctx ptr))
      (returns i32)
      (do
        (return
          (call_i32
            emit_cstr
            (param_get ctx)
            (const_string_ptr "  ")))))

; emit_temp_def_name
;
; Emits or computes LLVM output for temp def name.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   id - Deterministic numeric id.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.

(fn
      emit_temp_def_name
      (params
        (ctx ptr)
        (id i64))
      (returns i32)
      (do
        (call_i32
          emit_indent
          (param_get ctx))
        (return
          (call_i32
            emit_temp_name
            (param_get ctx)
            (param_get id)))))

; emit_comment
;
; Emits or computes LLVM output for comment.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   text - Text pointer.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.

(fn
      emit_comment
      (params
        (ctx ptr)
        (text ptr))
      (returns i32)
      (do
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr "  ; "))
        (call_i32
          emit_cstr
          (param_get ctx)
          (param_get text))
        (return
          (call_i32
            emit_newline
            (param_get ctx)))))

; =============================================================================
; Counter allocation
; =============================================================================

; next_temp
;
; Implements next temp for the weavec1 bootstrap compiler.
;
;
; Parameters:
;   ctx - EmitContext pointer.
; Returns:
;   i64 result value.

(fn
      next_temp
      (params
        (ctx ptr))
      (returns i64)
      (do
        (let
          old
          i64
          (call_i64
            ctx_temp_counter
            (param_get ctx)))
        (call_void
          ctx_set_temp_counter
          (param_get ctx)
          (add_i64
            (local_get old)
            (const_i64 1)))
        (return
          (local_get old))))

; next_label
;
; Implements next label for the weavec1 bootstrap compiler.
;
;
; Parameters:
;   ctx - EmitContext pointer.
; Returns:
;   i64 result value.

(fn
      next_label
      (params
        (ctx ptr))
      (returns i64)
      (do
        (let
          old
          i64
          (call_i64
            ctx_label_counter
            (param_get ctx)))
        (call_void
          ctx_set_label_counter
          (param_get ctx)
          (add_i64
            (local_get old)
            (const_i64 1)))
        (return
          (local_get old))))
))
