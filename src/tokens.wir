; =============================================================================
; Token value accessors
; =============================================================================

;
; tokens_kinds
;
; Reads the token-kind array pointer.
; Each token index has a matching entry in all parallel arrays.
;
; Parameters:
;   tokens - token stream pointer.
;
; Returns:
;   token-kind array pointer.
;
(fn tokens_kinds
      (params
        (tokens ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (call_ptr
              tokens_kinds_field
              (param_get tokens))))))

;
; tokens_starts
;
; Reads the token-start array pointer.
; Starts are source byte offsets into the original source buffer.
;
; Parameters:
;   tokens - token stream pointer.
;
; Returns:
;   token-kind array pointer.
;
(fn tokens_starts
      (params
        (tokens ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (call_ptr
              tokens_starts_field
              (param_get tokens))))))

;
; tokens_lengths
;
; Reads the token-length array pointer.
; Lengths preserve token spans without copying text.
;
; Parameters:
;   tokens - token stream pointer.
;
; Returns:
;   token-start array pointer.
;
(fn tokens_lengths
      (params
        (tokens ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (call_ptr
              tokens_lengths_field
              (param_get tokens))))))

;
; tokens_values
;
; Reads the token-value array pointer.
; Integer literals store parsed numeric values here.
;
; Parameters:
;   tokens - token stream pointer.
;
; Returns:
;   token-length array pointer.
;
(fn tokens_values
      (params
        (tokens ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (call_ptr
              tokens_values_field
              (param_get tokens))))))

;
; tokens_count
;
; Reads the number of tokens currently stored.
; The count also identifies the next append position.
;
; Parameters:
;   tokens - token stream pointer.
;
; Returns:
;   token-value array pointer.
;
(fn tokens_count
      (params
        (tokens ptr))
      (returns i64)
      (do
        (return
          (load_i64
            (call_ptr
              tokens_count_field
              (param_get tokens))))))

;
; tokens_capacity
;
; Reads the allocated token capacity.
; Reserve logic compares this against requested token counts.
;
; Parameters:
;   tokens - token stream pointer.
;
; Returns:
;   current token count.
;
(fn tokens_capacity
      (params
        (tokens ptr))
      (returns i64)
      (do
        (return
          (load_i64
            (call_ptr
              tokens_capacity_field
              (param_get tokens))))))

; =============================================================================
; Token mutators
; =============================================================================

;
; tokens_set_kinds
;
; Writes the token storage `kinds` field.
; Keeping writes behind helpers makes token-array growth easier to audit.
;
; Parameters:
;   tokens - token stream pointer.
;   kinds - token-kind array pointer.
;
; Returns:
;   allocated token capacity.
;
(fn tokens_set_kinds
      (params
        (tokens ptr)
        (kinds ptr))
      (returns void)
      (do
        (store_ptr
          (call_ptr
            tokens_kinds_field
            (param_get tokens))
          (param_get kinds))
        (return_void)))

;
; tokens_set_starts
;
; Writes the token storage `starts` field.
; Keeping writes behind helpers makes token-array growth easier to audit.
;
; Parameters:
;   tokens - token stream pointer.
;   starts - token-start array pointer.
;
; Returns:
;   no value.
;
(fn tokens_set_starts
      (params
        (tokens ptr)
        (starts ptr))
      (returns void)
      (do
        (store_ptr
          (call_ptr
            tokens_starts_field
            (param_get tokens))
          (param_get starts))
        (return_void)))

;
; tokens_set_lengths
;
; Writes the token storage `lengths` field.
; Keeping writes behind helpers makes token-array growth easier to audit.
;
; Parameters:
;   tokens - token stream pointer.
;   lengths - token-length array pointer.
;
; Returns:
;   no value.
;
(fn tokens_set_lengths
      (params
        (tokens ptr)
        (lengths ptr))
      (returns void)
      (do
        (store_ptr
          (call_ptr
            tokens_lengths_field
            (param_get tokens))
          (param_get lengths))
        (return_void)))

;
; tokens_set_values
;
; Writes the token storage `values` field.
; Keeping writes behind helpers makes token-array growth easier to audit.
;
; Parameters:
;   tokens - token stream pointer.
;   values - token-value array pointer.
;
; Returns:
;   no value.
;
(fn tokens_set_values
      (params
        (tokens ptr)
        (values ptr))
      (returns void)
      (do
        (store_ptr
          (call_ptr
            tokens_values_field
            (param_get tokens))
          (param_get values))
        (return_void)))

;
; tokens_set_count
;
; Writes the token storage `count` field.
; Keeping writes behind helpers makes token-array growth easier to audit.
;
; Parameters:
;   tokens - token stream pointer.
;   count - number of nodes, bytes, or entries.
;
; Returns:
;   no value.
;
(fn tokens_set_count
      (params
        (tokens ptr)
        (count i64))
      (returns void)
      (do
        (store_i64
          (call_ptr
            tokens_count_field
            (param_get tokens))
          (param_get count))
        (return_void)))

;
; tokens_set_capacity
;
; Writes the token storage `capacity` field.
; Keeping writes behind helpers makes token-array growth easier to audit.
;
; Parameters:
;   tokens - token stream pointer.
;   capacity - allocated entry capacity.
;
; Returns:
;   no value.
;
(fn tokens_set_capacity
      (params
        (tokens ptr)
        (capacity i64))
      (returns void)
      (do
        (store_i64
          (call_ptr
            tokens_capacity_field
            (param_get tokens))
          (param_get capacity))
        (return_void)))

; =============================================================================
; Token storage allocation
; =============================================================================

;
; tokens_new
;
; Allocates and initializes token storage.
; All parallel arrays start with the same capacity.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Returns:
;   token storage pointer, or null on allocation failure.
;
(fn tokens_new
      (params)
      (returns ptr)
      (do
        (let
          tokens
          ptr
          (call_ptr
            malloc
            (call_i64 tokens_size)))
        (if
          (condition
            (eq_ptr
              (local_get tokens)
              (const_null)))
          (then
            (do
              (return
                (const_null))))
          (else
            (do)))
        (let
          capacity
          i64
          (call_i64 tokens_initial_capacity))
        (let
          kinds
          ptr
          (call_ptr
            malloc
            (mul_i64
              (local_get capacity)
              (const_i64 4))))
        (let
          starts
          ptr
          (call_ptr
            malloc
            (mul_i64
              (local_get capacity)
              (const_i64 8))))
        (let
          lengths
          ptr
          (call_ptr
            malloc
            (mul_i64
              (local_get capacity)
              (const_i64 8))))
        (let
          values
          ptr
          (call_ptr
            malloc
            (mul_i64
              (local_get capacity)
              (const_i64 4))))
        (if
          (condition
            (or_bool
              (or_bool
                (eq_ptr
                  (local_get kinds)
                  (const_null))
                (eq_ptr
                  (local_get starts)
                  (const_null)))
              (or_bool
                (eq_ptr
                  (local_get lengths)
                  (const_null))
                (eq_ptr
                  (local_get values)
                  (const_null)))))
          (then
            (do
              (if
                (condition
                  (ne_ptr
                    (local_get kinds)
                    (const_null)))
                (then
                  (do
                    (call_void
                      free
                      (local_get kinds))))
                (else
                  (do)))
              (if
                (condition
                  (ne_ptr
                    (local_get starts)
                    (const_null)))
                (then
                  (do
                    (call_void
                      free
                      (local_get starts))))
                (else
                  (do)))
              (if
                (condition
                  (ne_ptr
                    (local_get lengths)
                    (const_null)))
                (then
                  (do
                    (call_void
                      free
                      (local_get lengths))))
                (else
                  (do)))
              (if
                (condition
                  (ne_ptr
                    (local_get values)
                    (const_null)))
                (then
                  (do
                    (call_void
                      free
                      (local_get values))))
                (else
                  (do)))
              (call_void
                free
                (local_get tokens))
              (return
                (const_null))))
          (else
            (do)))
        (call_void
          tokens_set_kinds
          (local_get tokens)
          (local_get kinds))
        (call_void
          tokens_set_starts
          (local_get tokens)
          (local_get starts))
        (call_void
          tokens_set_lengths
          (local_get tokens)
          (local_get lengths))
        (call_void
          tokens_set_values
          (local_get tokens)
          (local_get values))
        (call_void
          tokens_set_count
          (local_get tokens)
          (const_i64 0))
        (call_void
          tokens_set_capacity
          (local_get tokens)
          (local_get capacity))
        (return
          (local_get tokens))))

;
; tokens_free
;
; Releases token storage and all owned arrays.
; Source text spans are not owned by the token stream.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   tokens - token stream pointer.
;
; Returns:
;   no value.
;
(fn tokens_free
      (params
        (tokens ptr))
      (returns void)
      (do
        (if
          (condition
            (eq_ptr
              (param_get tokens)
              (const_null)))
          (then
            (do
              (return_void)))
          (else
            (do)))
        (let
          kinds
          ptr
          (call_ptr
            tokens_kinds
            (param_get tokens)))
        (let
          starts
          ptr
          (call_ptr
            tokens_starts
            (param_get tokens)))
        (let
          lengths
          ptr
          (call_ptr
            tokens_lengths
            (param_get tokens)))
        (let
          values
          ptr
          (call_ptr
            tokens_values
            (param_get tokens)))
        (if
          (condition
            (ne_ptr
              (local_get kinds)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get kinds))))
          (else
            (do)))
        (if
          (condition
            (ne_ptr
              (local_get starts)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get starts))))
          (else
            (do)))
        (if
          (condition
            (ne_ptr
              (local_get lengths)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get lengths))))
          (else
            (do)))
        (if
          (condition
            (ne_ptr
              (local_get values)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get values))))
          (else
            (do)))
        (call_void
          free
          (param_get tokens))
        (return_void)))

; =============================================================================
; Token storage growth
; =============================================================================

;
; tokens_reserve
;
; Ensures token storage can hold the requested count.
; All parallel arrays grow together to preserve index alignment.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   tokens - token stream pointer.
;   needed - minimum required capacity.
;
; Returns:
;   0 on success.
;   nonzero on allocation failure.
;
(fn tokens_reserve
      (params
        (tokens ptr)
        (needed i64))
      (returns i32)
      (do
        (if
          (condition
            (eq_ptr
              (param_get tokens)
              (const_null)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          capacity
          i64
          (call_i64
            tokens_capacity
            (param_get tokens)))
        (if
          (condition
            (le_i64
              (param_get needed)
              (local_get capacity)))
          (then
            (do
              (return
                (const_i32 0))))
          (else
            (do)))
        (let
          new_capacity
          i64
          (local_get capacity))
        (while
          (condition
            (lt_i64
              (local_get new_capacity)
              (param_get needed)))
          (do
            (set
              new_capacity
              (mul_i64
