; Token mutators
; =============================================================================

; tokens_set_kinds
;
; Stores a new token storage `kinds` pointer or count value.
;
; Parameters:
;   tokens - Token stream pointer.
;
;   kinds - Token kind array pointer.
; Returns:
;   no value.

(fn
      tokens_set_kinds
      (params
        (tokens ptr)
        (kinds ptr))
      (returns void)
      (do
        (store_ptr
          (call_ptr
            tokens_kinds_field
            (param_get tokens))
          (param_get kinds))
        (return_void)))

