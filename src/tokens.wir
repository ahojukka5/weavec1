; =============================================================================
; Token storage layout
; =============================================================================

;
; tokens_size
;
; Returns the size in bytes of the token storage header.
; The header owns parallel arrays for kind, start, length, and value.
;
; Returns:
;   token storage header size in bytes.
;
(fn tokens_size
      (params)
      (returns i64)
      (do
        (return
          (const_i64 48))))

;
; tokens_initial_capacity
;
; Returns the initial capacity for a token stream.
; Small files avoid immediate growth while large files can still reserve.
;
; Returns:
;   token storage header size in bytes.
;
(fn tokens_initial_capacity
      (params)
      (returns i64)
      (do
        (return
          (const_i64 256))))

; =============================================================================
; Token field accessors
; =============================================================================

;
; tokens_kinds_field
;
; Returns the address of the token storage `kinds` field.
; Token storage uses parallel arrays, so field offsets stay centralized here.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   tokens - token stream pointer.
;
; Returns:
;   initial token capacity.
;
(fn tokens_kinds_field
      (params
        (tokens ptr))
      (returns ptr)
      (do
        (return
          (param_get tokens))))

;
; tokens_starts_field
;
; Returns the address of the token storage `starts` field.
; Token storage uses parallel arrays, so field offsets stay centralized here.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   tokens - token stream pointer.
;
; Returns:
;   pointer to the `starts` field.
;
(fn tokens_starts_field
      (params
        (tokens ptr))
      (returns ptr)
      (do
        (return
          (ptr_add
            (param_get tokens)
            (const_i64 8)))))

