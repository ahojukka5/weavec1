        (return_void)))

; =============================================================================
; Token storage allocation
; =============================================================================

; tokens_new
;
; Provides token storage behavior for new.
;
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.

(fn
      tokens_new
      (params)
      (returns ptr)
      (do
        (let
          tokens
          ptr
          (call_ptr
            malloc
            (call_i64 tokens_size)))
        (if
          (condition
            (eq_ptr
              (local_get tokens)
              (const_null)))
          (then
            (do
              (return
                (const_null))))
          (else
            (do)))
        (let
          capacity
          i64
          (call_i64 tokens_initial_capacity))
        (let
          kinds
          ptr
          (call_ptr
            malloc
            (mul_i64
              (local_get capacity)
              (const_i64 4))))
        (let
          starts
          ptr
          (call_ptr
            malloc
            (mul_i64
              (local_get capacity)
              (const_i64 8))))
        (let
          lengths
          ptr
          (call_ptr
            malloc
            (mul_i64
              (local_get capacity)
              (const_i64 8))))
        (let
          values
          ptr
          (call_ptr
            malloc
            (mul_i64
              (local_get capacity)
              (const_i64 4))))
        (if
          (condition
            (or_bool
              (or_bool
                (eq_ptr
                  (local_get kinds)
                  (const_null))
                (eq_ptr
                  (local_get starts)
                  (const_null)))
              (or_bool
                (eq_ptr
                  (local_get lengths)
                  (const_null))
                (eq_ptr
                  (local_get values)
                  (const_null)))))
          (then
            (do
              (if
                (condition
                  (ne_ptr
                    (local_get kinds)
                    (const_null)))
                (then
                  (do
                    (call_void
                      free
                      (local_get kinds))))
                (else
                  (do)))
              (if
                (condition
                  (ne_ptr
                    (local_get starts)
                    (const_null)))
                (then
                  (do
                    (call_void
                      free
                      (local_get starts))))
                (else
                  (do)))
              (if
                (condition
                  (ne_ptr
                    (local_get lengths)
                    (const_null)))
                (then
                  (do
                    (call_void
                      free
                      (local_get lengths))))
                (else
                  (do)))
              (if
                (condition
                  (ne_ptr
                    (local_get values)
                    (const_null)))
                (then
                  (do
                    (call_void
                      free
                      (local_get values))))
                (else
                  (do)))
              (call_void
                free
                (local_get tokens))
              (return
                (const_null))))
          (else
            (do)))
        (call_void
          tokens_set_kinds
          (local_get tokens)
          (local_get kinds))
        (call_void
          tokens_set_starts
          (local_get tokens)
          (local_get starts))
        (call_void
          tokens_set_lengths
          (local_get tokens)
          (local_get lengths))
        (call_void
          tokens_set_values
          (local_get tokens)
          (local_get values))
        (call_void
          tokens_set_count
          (local_get tokens)
          (const_i64 0))
        (call_void
          tokens_set_capacity
          (local_get tokens)
          (local_get capacity))
        (return
          (local_get tokens))))

; tokens_free
;
; Provides token storage behavior for free.
;
;
; Parameters:
;   tokens - Token stream pointer.
; Returns:
;   no value.

(fn
      tokens_free
      (params
        (tokens ptr))
      (returns void)
      (do
        (if
          (condition
            (eq_ptr
              (param_get tokens)
              (const_null)))
          (then
            (do
              (return_void)))
          (else
            (do)))
        (let
          kinds
          ptr
          (call_ptr
            tokens_kinds
            (param_get tokens)))
        (let
          starts
          ptr
          (call_ptr
            tokens_starts
            (param_get tokens)))
        (let
          lengths
          ptr
          (call_ptr
            tokens_lengths
            (param_get tokens)))
        (let
          values
          ptr
          (call_ptr
            tokens_values
            (param_get tokens)))
        (if
          (condition
            (ne_ptr
              (local_get kinds)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get kinds))))
          (else
            (do)))
        (if
          (condition
            (ne_ptr
              (local_get starts)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get starts))))
          (else
            (do)))
        (if
          (condition
            (ne_ptr
              (local_get lengths)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get lengths))))
          (else
            (do)))
        (if
          (condition
            (ne_ptr
              (local_get values)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get values))))
          (else
            (do)))
        (call_void
          free
          (param_get tokens))
        (return_void)))

; =============================================================================
; Token storage growth
; =============================================================================

; tokens_reserve
;
; Provides token storage behavior for reserve.
;
; Parameters:
;   tokens - Token stream pointer.
;
;   needed - Required capacity.
; Returns:
;   i32 result value.

(fn
      tokens_reserve
      (params
        (tokens ptr)
        (needed i64))
      (returns i32)
      (do
        (if
          (condition
            (eq_ptr
              (param_get tokens)
              (const_null)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          capacity
          i64
          (call_i64
            tokens_capacity
            (param_get tokens)))
        (if
          (condition
            (le_i64
              (param_get needed)
              (local_get capacity)))
          (then
            (do
              (return
                (const_i32 0))))
          (else
            (do)))
        (let
          new_capacity
          i64
          (local_get capacity))
        (while
          (condition
            (lt_i64
              (local_get new_capacity)
              (param_get needed)))
          (do
            (set
              new_capacity
              (mul_i64
                (local_get new_capacity)
                (const_i64 2)))))
        (let
