; SPDX-License-Identifier: Apache-2.0
; tokens.wir
;
; Token constants and token stream storage.
;
; Responsibilities:
;   - define token kind integer constants
;   - allocate, grow, and free token arrays
;   - append token kind and source span triples
;   - provide typed accessors for parser modules
;
; Token storage uses parallel arrays for kind, start offset, and length.

(core-module
  (core-version 2)
  (decls

