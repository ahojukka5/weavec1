        (ctx ptr)
        (program_node i64))
      (returns i32)
      (body
        (let ast ptr
          (call_ptr ctx_ast
            (param_get ctx)))

        (let node_count i64
          (call_i64 ast_count
            (local_get ast)))

        (call_i32 emit_module_header
          (param_get ctx))

        (let i i64
          (const_i64 0))

        (while
          (lt_i64
            (local_get i)
            (local_get node_count))
          (body
            (block
              (if
                (eq_i32
                  (call_i32 ast_kind_at
                    (local_get ast)
                    (local_get i))
                  (call_i32 ast_function))
                (then
                  (if
                    (ne_i32
                      (call_i32 emit_function
                        (param_get ctx)
                        (local_get i))
                      (const_i32 0))
                    (then (return (const_i32 1)))
                    (else (block))))
                (else (block)))

              (set i
                (add_i64
                  (local_get i)
                  (const_i64 1))))))

        (return
          (const_i32 0))))

    ; -------------------------------------------------------------------------
    ; Public entry point
    ; -------------------------------------------------------------------------

    (fn emit_llvm
      (params
        (source ptr)
        (ast ptr)
        (program_node i64)
        (output ptr))
      (returns i32)
      (body
        (let ctx ptr
          (call_ptr emit_context_new
            (param_get source)
            (param_get ast)
            (param_get output)))

        (if
          (eq_ptr (local_get ctx) (const_null))
          (then (return (const_i32 1)))
          (else (block)))

        (let status i32
          (call_i32 emit_program
            (local_get ctx)
            (param_get program_node)))

        (call_void emit_context_free
          (local_get ctx))

        (return
          (local_get status))))))
