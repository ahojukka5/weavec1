              (local_get text)
              (local_get length)
              (const_string_ptr "ptr_add")
              (const_i64 7)))
          (then
            (do
              (return
                (call_i32 op_ptr_add))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "cast_i64_to_i32")
              (const_i64 15)))
          (then
            (do
              (return
                (call_i32 op_cast_i64_to_i32))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "cast_i32_to_i64")
              (const_i64 15)))
          (then
