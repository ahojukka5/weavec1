    (fn
      parser_parse_expression
      (params
        (parser ptr))
      (returns i64)
      (do
        (if
          (condition
            (call_bool
              parser_match
              (param_get parser)
              (call_i32 token_int)))
          (then
            (do
              (let
                value
                i32
                (call_i32
                  token_value_at
                  (call_ptr
                    parser_tokens
                    (param_get parser))
                  (call_i64
                    parser_index
                    (param_get parser))))
              (call_void
                parser_advance
                (param_get parser))
              (return
                (call_i64
                  ast_make_const_i32
                  (call_ptr
                    parser_ast
                    (param_get parser))
                  (local_get value)))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              parser_match
              (param_get parser)
              (call_i32 token_string)))
          (then
            (do
              (let
                string_start
                i64
                (call_i64
                  parser_current_start
                  (param_get parser)))
              (let
                string_length
                i64
                (call_i64
                  parser_current_length
                  (param_get parser)))
              (call_void
                parser_advance
                (param_get parser))
              (return
                (call_i64
                  ast_make_const_string
                  (call_ptr
                    parser_ast
                    (param_get parser))
                  (local_get string_start)
                  (local_get string_length)))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              parser_match
              (param_get parser)
              (call_i32 token_lparen)))
          (then
            (do
              (return
                (call_i64
                  parser_parse_list_expression
                  (param_get parser)))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              parser_match
              (param_get parser)
              (call_i32 token_ident)))
          (then
            (do
              (let
                ident_start
                i64
                (call_i64
                  parser_ident_start
                  (param_get parser)))
              (let
                ident_length
                i64
                (call_i64
                  parser_ident_length
                  (param_get parser)))
              (call_void
                parser_advance
                (param_get parser))
              (return
                (call_i64
                  ast_make_name_ref
                  (call_ptr
                    parser_ast
                    (param_get parser))
                  (call_i32 ast_local_get)
                  (local_get ident_start)
                  (local_get ident_length)))))
          (else
            (do)))
        (return
          (const_i64 -1))))
    (fn
      parser_parse_condition_slot
      (params
        (parser ptr))
      (returns i64)
      (do
        (let
          current_kind
          i32
          (call_i32
            parser_current_kind
            (param_get parser)))
        (if
          (condition
            (eq_i32
              (local_get current_kind)
              (call_i32 token_lparen)))
          (then
            (do
              (let
                tokens
                ptr
                (call_ptr
                  parser_tokens
                  (param_get parser)))
              (let
                head_index
                i64
                (add_i64
                  (call_i64
                    parser_index
                    (param_get parser))
                  (const_i64 1)))
              (if
                (condition
                  (eq_i32
                    (call_i32
                      token_kind_at
                      (local_get tokens)
                      (local_get head_index))
                    (call_i32 token_condition)))
                (then
                  (do
                    (if
                      (condition
                        (ne_i32
                          (call_i32
                            parser_expect
                            (param_get parser)
                            (call_i32 token_lparen))
                          (const_i32 0)))
                      (then
                        (do
                          (return
                            (const_i64 -1))))
                      (else
                        (do)))
                    (if
                      (condition
                        (ne_i32
                          (call_i32
                            parser_expect
                            (param_get parser)
                            (call_i32 token_condition))
                          (const_i32 0)))
                      (then
                        (do
                          (return
                            (const_i64 -1))))
                      (else
                        (do)))
                    (let
                      condition_expr
                      i64
                      (call_i64
                        parser_parse_expression
                        (param_get parser)))
                    (if
                      (condition
                        (lt_i64
                          (local_get condition_expr)
                          (const_i64 0)))
                      (then
                        (do
                          (return
                            (const_i64 -1))))
                      (else
                        (do)))
                    (if
                      (condition
                        (ne_i32
                          (call_i32
                            parser_expect
                            (param_get parser)
                            (call_i32 token_rparen))
                          (const_i32 0)))
                      (then
                        (do
                          (return
                            (const_i64 -1))))
                      (else
                        (do)))
                    (return
                      (local_get condition_expr))))
                (else
                  (do)))))
          (else
            (do)))
        (return
          (const_i64 -1))))
))
