              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "and_bool")
              (const_i64 8)))
          (then
            (do
              (return
                (call_i32 op_and_bool))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
