; SPDX-License-Identifier: Apache-2.0
; parser_expr.wir
;
; WIR expression parsing.
;
; Responsibilities:
;   - look up operator identifiers
;   - parse expression subtrees
;   - parse constants, calls, comparisons, arithmetic, and pointer operations
;   - parse condition slots used by control-flow forms
;
; This module intentionally focuses only on expression-level syntax. Statement
; and declaration parsing are handled elsewhere.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Operator lookup
; =============================================================================

;
; parser_lookup_op
;
; Looks up the operator id named by the parser's current identifier token.
; The current token must already be positioned on the operator identifier.
;
; Notes:
;   The lookup is intentionally a linear comparison chain. The bootstrap
;   compiler favors explicit, auditable dispatch over compact tables.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   operator id on success.
;   -1 when the identifier is not a supported WIR operator.
;
(fn parser_lookup_op
      (params
        (parser ptr))
      (returns i32)
      (do
        (let
          source
          ptr
          (call_ptr
            parser_source
            (param_get parser)))
        (let
          text
          ptr
          (ptr_add
            (call_ptr
              source_data
              (local_get source))
            (call_i64
              parser_ident_start
              (param_get parser))))
        (let
          length
          i64
          (call_i64
            parser_ident_length
            (param_get parser)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "add_i32")
              (const_i64 7)))
          (then
            (do
              (return
                (call_i32 op_add_i32))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "add_i64")
              (const_i64 7)))
          (then
            (do
              (return
                (call_i32 op_add_i64))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "sub_i64")
              (const_i64 7)))
          (then
            (do
              (return
                (call_i32 op_sub_i64))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "mul_i64")
              (const_i64 7)))
          (then
            (do
              (return
                (call_i32 op_mul_i64))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "div_i64")
              (const_i64 7)))
          (then
            (do
              (return
                (call_i32 op_div_i64))))
          (else
            (do)))
        (if
          (condition
