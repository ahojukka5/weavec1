; emit_text.wir
;
; Low-level text emission helpers.
;
; Responsibilities:
;   - append C strings and individual bytes to output buffers
;   - emit integer values as text
;   - copy source slices into generated LLVM text
;
; These helpers are intentionally small wrappers around buffer operations.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Text buffer emission
; =============================================================================

; emit_cstr
;
; Emits or computes LLVM output for cstr.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   text - Text pointer.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn emit_cstr
      (params
        (ctx ptr)
        (text ptr))
      (returns i32)
      (do
        (return
          (call_i32
            buffer_append_cstr
            (call_ptr
              ctx_output
              (param_get ctx))
            (param_get text)))))

; emit_byte
;
; Emits or computes LLVM output for byte.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   byte - Byte value.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn emit_byte
      (params
        (ctx ptr)
        (byte i32))
      (returns i32)
      (do
        (return
          (call_i32
            buffer_append_byte
            (call_ptr
              ctx_output
              (param_get ctx))
            (param_get byte)))))

; emit_i32
;
; Emits or computes LLVM output for i32.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   value - Value to store or emit.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn emit_i32
      (params
        (ctx ptr)
        (value i32))
      (returns i32)
      (do
        (return
          (call_i32
            buffer_append_i32
            (call_ptr
              ctx_output
              (param_get ctx))
            (param_get value)))))

; emit_i64_as_i32
;
; Emits or computes LLVM output for i64 as i32.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   value - Value to store or emit.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn emit_i64_as_i32
      (params
        (ctx ptr)
        (value i64))
      (returns i32)
      (do
        (return
          (call_i32
            emit_i32
            (param_get ctx)
            (cast_i64_to_i32
              (param_get value))))))

; emit_source_slice
;
; Emits or computes LLVM output for source slice.
;
; Parameters:
;   ctx - EmitContext pointer.
;   start - Source byte offset.
;
;   length - Byte length.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn emit_source_slice
      (params
        (ctx ptr)
        (start i64)
        (length i64))
      (returns i32)
      (do
        (return
          (call_i32
            buffer_append_bytes
            (call_ptr
              ctx_output
              (param_get ctx))
            (ptr_add
              (call_ptr
                source_data
                (call_ptr
                  ctx_source
                  (param_get ctx)))
              (param_get start))
            (param_get length)))))

; emit_newline
;
; Emits or computes LLVM output for newline.
;
;
; Parameters:
;   ctx - EmitContext pointer.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn emit_newline
      (params
        (ctx ptr))
      (returns i32)
      (do
        (return
          (call_i32
            emit_byte
            (param_get ctx)
            (const_i32 10)))))
))
