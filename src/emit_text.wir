; emit_text.wir
;
; Low-level text emission helpers.
;
; Responsibilities:
;   - append C strings and individual bytes to output buffers
;   - emit integer values as text
;   - copy source slices into generated LLVM text
;
; These helpers are intentionally small wrappers around buffer operations.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Text buffer emission
; =============================================================================

;
; emit_cstr
;
; Emits LLVM text for `cstr`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;   text - text pointer.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_cstr
      (params
        (ctx ptr)
        (text ptr))
      (returns i32)
      (do
        (return
          (call_i32
            buffer_append_cstr
            (call_ptr
              ctx_output
              (param_get ctx))
            (param_get text)))))

;
; emit_byte
;
; Emits LLVM text for `byte`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;   byte - byte value to emit or escape.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_byte
      (params
        (ctx ptr)
        (byte i32))
      (returns i32)
      (do
        (return
          (call_i32
            buffer_append_byte
            (call_ptr
              ctx_output
              (param_get ctx))
            (param_get byte)))))

;
; emit_i32
;
; Emits LLVM text for `i32`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;   value - value to store, emit, or compare.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_i32
      (params
        (ctx ptr)
        (value i32))
      (returns i32)
      (do
        (return
          (call_i32
            buffer_append_i32
            (call_ptr
              ctx_output
              (param_get ctx))
            (param_get value)))))

;
; emit_i64_as_i32
;
; Emits LLVM text for `i64 as i32`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;   value - value to store, emit, or compare.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_i64_as_i32
      (params
        (ctx ptr)
        (value i64))
      (returns i32)
      (do
        (return
          (call_i32
            emit_i32
            (param_get ctx)
            (cast_i64_to_i32
              (param_get value))))))

;
; emit_source_slice
;
; Emits LLVM text for `source slice`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;   start - source byte offset where lexing begins.
;   length - byte length.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_source_slice
      (params
        (ctx ptr)
        (start i64)
        (length i64))
      (returns i32)
      (do
        (return
          (call_i32
            buffer_append_bytes
            (call_ptr
              ctx_output
              (param_get ctx))
            (ptr_add
              (call_ptr
                source_data
                (call_ptr
                  ctx_source
                  (param_get ctx)))
              (param_get start))
            (param_get length)))))

;
; emit_newline
;
; Emits LLVM text for `newline`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_newline
      (params
        (ctx ptr))
      (returns i32)
      (do
        (return
          (call_i32
            emit_byte
            (param_get ctx)
            (const_i32 10)))))
))
