;
; ctx_source
;
; Reads the emission context `source` field.
; Accessors keep the manual context layout hidden from emitters.
;
; Parameters:
;   ctx - emission context pointer.
;
; Returns:
;   context `source` field value.
;
(fn ctx_source
      (params
        (ctx ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (call_ptr
              ctx_source_field
              (param_get ctx))))))

