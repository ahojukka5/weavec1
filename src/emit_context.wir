; SPDX-License-Identifier: Apache-2.0
; emit_context.wir
;
; LLVM emission context storage.
;
; Responsibilities:
;   - define the mutable state carried through emission
;   - manage counters for temporary, label, and string names
;   - store local and parameter binding tables
;   - keep source, AST, and output buffers available to emitters
;
; The context is intentionally a manual fixed-layout record for bootstrap
; transparency and simple self-hosted code generation.

(core-module
  (core-version 2)
  (decls

; =============================================================================
; Context layout constants
; =============================================================================

;
; emit_context_size
;
; Returns the context size used by emission context storage.
; These constants document the manual context and binding record layout.
;
; Returns:
;   emission context record size in bytes.
;
(fn emit_context_size
      (params)
      (returns i64)
      (do
        (return
          (const_i64 88))))

;
; emit_binding_size
;
; Returns the binding size used by emission context storage.
; These constants document the manual context and binding record layout.
;
; Returns:
;   emission context record size in bytes.
;
(fn emit_binding_size
      (params)
      (returns i64)
      (do
        (return
          (const_i64 24))))

;
; emit_max_bindings
;
; Returns the max bindings used by emission context storage.
; These constants document the manual context and binding record layout.
;
; Returns:
;   binding record size in bytes.
;
(fn emit_max_bindings
      (params)
      (returns i64)
      (do
        (return
          (const_i64 256))))

; =============================================================================
; Context field address accessors
; =============================================================================

;
; ctx_source_field
;
; Returns the address of the emission context `source` field.
; Context field helpers centralize offsets in the manual record layout.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   ctx - emission context pointer.
;
; Returns:
;   maximum local or parameter binding count.
;
(fn ctx_source_field
      (params
        (ctx ptr))
      (returns ptr)
      (do
        (return
          (param_get ctx))))

;
; ctx_ast_field
;
; Returns the address of the emission context `ast` field.
; Context field helpers centralize offsets in the manual record layout.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   ctx - emission context pointer.
;
; Returns:
;   pointer to the `ast` field.
;
(fn ctx_ast_field
      (params
        (ctx ptr))
      (returns ptr)
      (do
        (return
          (ptr_add
            (param_get ctx)
            (const_i64 8)))))

