; emit_context.wir
;
; LLVM emission context storage.
;
; Responsibilities:
;   - define the mutable state carried through emission
;   - manage counters for temporary, label, and string names
;   - store local and parameter binding tables
;   - keep source, AST, and output buffers available to emitters
;
; The context is intentionally a manual fixed-layout record for bootstrap
; transparency and simple self-hosted code generation.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Context layout constants
; =============================================================================

; emit_context_size
;
; Emits or computes LLVM output for context size.
;
; Returns:
;   i64 result value.

(fn
      emit_context_size
      (params)
      (returns i64)
      (do
        (return
          (const_i64 88))))

; emit_binding_size
;
; Emits or computes LLVM output for binding size.
;
; Returns:
;   i64 result value.

(fn
      emit_binding_size
      (params)
      (returns i64)
      (do
        (return
          (const_i64 24))))

; emit_max_bindings
;
; Emits or computes LLVM output for max bindings.
;
; Returns:
;   i64 result value.

(fn
      emit_max_bindings
      (params)
      (returns i64)
      (do
        (return
          (const_i64 256))))

