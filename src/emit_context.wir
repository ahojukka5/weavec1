; ctx_set_source
;
; Stores a new value in the emission context `source` field.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   v - Value to store.
; Returns:
;   no value.

(fn
      ctx_set_source
      (params
        (ctx ptr)
        (v ptr))
      (returns void)
      (do
        (store_ptr
          (call_ptr
            ctx_source_field
            (param_get ctx))
          (param_get v))
        (return_void)))

