; =============================================================================
; Context mutators
; =============================================================================

;
; ctx_set_source
;
; Writes the emission context `source` field.
; Emitters use mutators instead of writing context offsets inline.
;
; Parameters:
;   ctx - emission context pointer.
;   v - value to store into the record field.
;
; Returns:
;   no value.
;
(fn ctx_set_source
      (params
        (ctx ptr)
        (v ptr))
      (returns void)
      (do
        (store_ptr
          (call_ptr
            ctx_source_field
            (param_get ctx))
          (param_get v))
        (return_void)))

;
