; ctx_source_field
;
; Returns the address of the `source` field inside an emission context.
;
;
; Parameters:
;   ctx - EmitContext pointer.
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.

(fn
      ctx_source_field
      (params
        (ctx ptr))
      (returns ptr)
      (do
        (return
          (param_get ctx))))

