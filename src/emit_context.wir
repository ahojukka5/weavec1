; =============================================================================
; Context allocation
; =============================================================================

; emit_context_new
;
; Emits or computes LLVM output for context new.
;
; Parameters:
;   source - Source buffer pointer.
;   ast - AST container pointer.
;
;   output - Output buffer pointer.
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.

(fn
      emit_context_new
      (params
        (source ptr)
        (ast ptr)
        (output ptr))
      (returns ptr)
      (do
        (let
          ctx
          ptr
          (call_ptr
            malloc
            (call_i64 emit_context_size)))
        (if
          (condition
            (eq_ptr
              (local_get ctx)
              (const_null)))
          (then
            (do
              (return
                (const_null))))
          (else
            (do)))
        (let
          locals
          ptr
          (call_ptr
            malloc
            (mul_i64
              (call_i64 emit_max_bindings)
              (call_i64 emit_binding_size))))
        (if
          (condition
            (eq_ptr
              (local_get locals)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get ctx))
              (return
                (const_null))))
          (else
            (do)))
        (let
          param_bindings
          ptr
          (call_ptr
            malloc
            (mul_i64
              (call_i64 emit_max_bindings)
              (call_i64 emit_binding_size))))
        (if
          (condition
            (eq_ptr
              (local_get param_bindings)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get locals))
              (call_void
                free
                (local_get ctx))
              (return
                (const_null))))
          (else
            (do)))
        (call_void
          ctx_set_source
          (local_get ctx)
          (param_get source))
        (call_void
          ctx_set_ast
          (local_get ctx)
          (param_get ast))
        (call_void
          ctx_set_output
          (local_get ctx)
          (param_get output))
        (call_void
          ctx_set_temp_counter
          (local_get ctx)
          (const_i64 0))
        (call_void
          ctx_set_label_counter
          (local_get ctx)
          (const_i64 0))
        (call_void
          ctx_set_string_counter
          (local_get ctx)
          (const_i64 0))
        (call_void
          ctx_set_locals
          (local_get ctx)
          (local_get locals))
        (call_void
          ctx_set_local_count
          (local_get ctx)
          (const_i64 0))
        (call_void
          ctx_set_params
          (local_get ctx)
          (local_get param_bindings))
        (call_void
          ctx_set_param_count
          (local_get ctx)
          (const_i64 0))
        (call_void
          ctx_set_return_type
          (local_get ctx)
          (call_i32 type_i32))
        (return
          (local_get ctx))))

; emit_context_free
;
; Emits or computes LLVM output for context free.
;
;
; Parameters:
;   ctx - EmitContext pointer.
; Returns:
;   no value.

(fn
      emit_context_free
      (params
        (ctx ptr))
      (returns void)
      (do
        (if
          (condition
            (eq_ptr
              (param_get ctx)
              (const_null)))
          (then
            (do
              (return_void)))
          (else
            (do)))
        (let
          locals
          ptr
          (call_ptr
            ctx_locals
            (param_get ctx)))
        (let
          param_bindings
          ptr
          (call_ptr
            ctx_params
            (param_get ctx)))
        (if
          (condition
            (ne_ptr
              (local_get locals)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get locals))))
          (else
            (do)))
        (if
          (condition
            (ne_ptr
              (local_get param_bindings)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get param_bindings))))
          (else
            (do)))
        (call_void
          free
          (param_get ctx))
        (return_void)))
))
