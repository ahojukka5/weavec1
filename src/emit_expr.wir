; emit_binary_expr
;
; Emits or computes LLVM output for binary expr.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   i64 result value.

(fn
      emit_binary_expr
      (params
        (ctx ptr)
        (node i64))
      (returns i64)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          op
          i32
          (cast_i64_to_i32
            (call_i64
              ast_op_type_at
              (local_get ast)
              (param_get node))))
        (let
          lhs_node
          i64
          (call_i64
            ast_a_at
            (local_get ast)
            (param_get node)))
        (let
          rhs_node
          i64
          (call_i64
            ast_b_at
            (local_get ast)
            (param_get node)))
        (let
          lhs_is_immediate
          bool
          (call_bool
            emit_is_immediate_expr
            (param_get ctx)
            (local_get lhs_node)))
        (let
          rhs_is_immediate
          bool
          (call_bool
            emit_is_immediate_expr
            (param_get ctx)
            (local_get rhs_node)))
        (let
          lhs
          i64
          (const_i64 0))
        (let
          rhs
          i64
          (const_i64 0))
        (if
          (condition
            (not_bool
              (local_get lhs_is_immediate)))
          (then
            (do
              (set
                lhs
                (call_i64
                  emit_expr
                  (param_get ctx)
                  (local_get lhs_node)))))
          (else
            (do)))
        (if
          (condition
            (not_bool
              (local_get rhs_is_immediate)))
          (then
            (do
              (set
                rhs
                (call_i64
                  emit_expr
                  (param_get ctx)
                  (local_get rhs_node)))))
          (else
            (do)))
        (if
          (condition
            (or_bool
              (and_bool
                (not_bool
                  (local_get lhs_is_immediate))
                (lt_i64
                  (local_get lhs)
                  (const_i64 0)))
              (and_bool
                (not_bool
                  (local_get rhs_is_immediate))
                (lt_i64
                  (local_get rhs)
                  (const_i64 0)))))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (let
          temp
          i64
          (call_i64
            next_temp
            (param_get ctx)))
        (if
          (condition
            (eq_i32
              (local_get op)
              (call_i32 op_ptr_add)))
          (then
            (do
              (call_i32
                emit_temp_def_name
                (param_get ctx)
                (local_get temp))
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr " = getelementptr i8, ptr "))
              (call_i32
                emit_expr_operand
                (param_get ctx)
                (local_get lhs_node)
                (local_get lhs))
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr ", i64 "))
              (call_i32
                emit_expr_operand
                (param_get ctx)
                (local_get rhs_node)
                (local_get rhs))
              (call_i32
                emit_newline
                (param_get ctx))
              (return
                (local_get temp))))
          (else
            (do)))
        (call_i32
          emit_temp_def_name
          (param_get ctx)
          (local_get temp))
        (call_i32
          emit_binary_op_text
          (param_get ctx)
          (local_get op))
        (call_i32
          emit_expr_operand
          (param_get ctx)
          (local_get lhs_node)
          (local_get lhs))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr ", "))
        (call_i32
          emit_expr_operand
          (param_get ctx)
          (local_get rhs_node)
          (local_get rhs))
        (call_i32
          emit_newline
          (param_get ctx))
        (return
          (local_get temp))))
))
