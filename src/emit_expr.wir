; emit_expr.wir
;
; LLVM emission for expression AST nodes.
;
; Responsibilities:
;   - dispatch expression nodes by AST kind
;   - emit constants, unary expressions, binary expressions, loads, and calls
;   - choose when operands can be printed directly versus stored in temporaries
;   - determine LLVM expression text and types needed by statement emitters
;
; The emitter favors direct, readable LLVM text over compact abstraction.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Expression dispatch
; =============================================================================

; emit_expr
;
; Emits or computes LLVM output for expr.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   i64 result value.

(fn
      emit_expr
      (params
        (ctx ptr)
        (node i64))
      (returns i64)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          kind
          i32
          (call_i32
            ast_kind_at
            (local_get ast)
            (param_get node)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_const_i32)))
          (then
            (do
              (return
                (call_i64
                  emit_const_i32_expr
                  (param_get ctx)
                  (param_get node)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_binary)))
          (then
            (do
              (return
                (call_i64
                  emit_binary_expr
                  (param_get ctx)
                  (param_get node)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_const_i64)))
          (then
            (do
              (return
                (call_i64
                  emit_const_i64_expr
                  (param_get ctx)
                  (param_get node)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_const_bool)))
          (then
            (do
              (return
                (call_i64
                  emit_const_bool_expr
                  (param_get ctx)
                  (param_get node)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_const_null)))
          (then
            (do
              (return
                (call_i64
                  emit_const_null_expr
                  (param_get ctx)
                  (param_get node)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_const_string)))
          (then
            (do
              (return
                (call_i64
                  emit_const_string_expr
                  (param_get ctx)
                  (param_get node)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_arg)))
          (then
            (do
              (return
                (call_i64
                  emit_expr
                  (param_get ctx)
                  (call_i64
                    ast_a_at
                    (local_get ast)
                    (param_get node))))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_unary)))
          (then
            (do
              (return
                (call_i64
                  emit_unary_expr
                  (param_get ctx)
                  (param_get node)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_load)))
          (then
            (do
              (return
                (call_i64
                  emit_load_expr
                  (param_get ctx)
                  (param_get node)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_call)))
          (then
            (do
              (return
                (call_i64
                  emit_call_expr
                  (param_get ctx)
                  (param_get node)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_param_get)))
          (then
            (do
              (return
                (call_i64
                  emit_param_get_expr
                  (param_get ctx)
                  (param_get node)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_local_get)))
          (then
            (do
              (return
                (call_i64
                  emit_local_get_expr
                  (param_get ctx)
                  (param_get node)))))
          (else
            (do)))
        (return
          (const_i64 -1))))

; =============================================================================
; Operand classification
; =============================================================================

; emit_is_immediate_expr
;
; Emits or computes LLVM output for is immediate expr.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   true when the predicate matches.
;   false otherwise.

(fn
      emit_is_immediate_expr
      (params
        (ctx ptr)
        (node i64))
      (returns bool)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          kind
          i32
          (call_i32
            ast_kind_at
            (local_get ast)
            (param_get node)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_arg)))
          (then
            (do
              (return
                (call_bool
                  emit_is_immediate_expr
                  (param_get ctx)
                  (call_i64
                    ast_a_at
                    (local_get ast)
                    (param_get node))))))
          (else
            (do)))
        (return
          (or_bool
            (or_bool
              (eq_i32
                (local_get kind)
                (call_i32 ast_const_i32))
              (eq_i32
                (local_get kind)
                (call_i32 ast_const_i64)))
            (or_bool
              (eq_i32
                (local_get kind)
                (call_i32 ast_const_bool))
              (or_bool
                (eq_i32
                  (local_get kind)
                  (call_i32 ast_const_null))
                (eq_i32
                  (local_get kind)
                  (call_i32 ast_param_get))))))))

; emit_expr_operand
;
; Emits or computes LLVM output for expr operand.
;
; Parameters:
;   ctx - EmitContext pointer.
;   node - AST node index.
;
;   temp - Temporary id.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.

(fn
      emit_expr_operand
      (params
        (ctx ptr)
        (node i64)
        (temp i64))
      (returns i32)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          kind
          i32
          (call_i32
            ast_kind_at
            (local_get ast)
            (param_get node)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_arg)))
          (then
            (do
              (return
                (call_i32
                  emit_expr_operand
                  (param_get ctx)
                  (call_i64
                    ast_a_at
                    (local_get ast)
                    (param_get node))
                  (param_get temp)))))
          (else
            (do)))
        (if
          (condition
            (or_bool
              (or_bool
                (eq_i32
                  (local_get kind)
                  (call_i32 ast_const_i32))
                (eq_i32
                  (local_get kind)
                  (call_i32 ast_const_i64)))
              (eq_i32
                (local_get kind)
                (call_i32 ast_const_bool))))
          (then
            (do
              (return
                (call_i32
                  emit_i64_as_i32
                  (param_get ctx)
                  (call_i64
                    ast_a_at
                    (local_get ast)
                    (param_get node))))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_const_null)))
          (then
            (do
              (return
                (call_i32
                  emit_cstr
                  (param_get ctx)
                  (const_string_ptr "null")))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get kind)
              (call_i32 ast_param_get)))
          (then
            (do
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr "%"))
              (return
                (call_i32
                  emit_source_slice
                  (param_get ctx)
                  (call_i64
                    ast_text_start_at
                    (local_get ast)
                    (param_get node))
                  (call_i64
                    ast_text_len_at
                    (local_get ast)
                    (param_get node))))))
          (else
            (do)))
        (return
          (call_i32
            emit_temp_name
            (param_get ctx)
            (param_get temp)))))

; =============================================================================
; Memory loads
; =============================================================================

; emit_load_expr
;
; Emits or computes LLVM output for load expr.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   i64 result value.

(fn
      emit_load_expr
      (params
        (ctx ptr)
        (node i64))
      (returns i64)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          op
          i32
          (cast_i64_to_i32
            (call_i64
              ast_op_type_at
              (local_get ast)
              (param_get node))))
        (let
          ptr_node
          i64
          (call_i64
            ast_a_at
            (local_get ast)
            (param_get node)))
        (let
          ptr_value
          i64
          (call_i64
            emit_expr
            (param_get ctx)
            (local_get ptr_node)))
        (if
          (condition
            (lt_i64
              (local_get ptr_value)
              (const_i64 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (let
          temp
          i64
          (call_i64
            next_temp
            (param_get ctx)))
        (if
          (condition
            (not_bool
              (or_bool
                (or_bool
                  (or_bool
                    (eq_i32
                      (local_get op)
                      (call_i32 op_load_i32))
                    (eq_i32
                      (local_get op)
                      (call_i32 op_load_i64)))
                  (eq_i32
                    (local_get op)
                    (call_i32 op_load_ptr)))
                (eq_i32
                  (local_get op)
                  (call_i32 op_load_u8)))))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (call_i32
          emit_temp_def_name
          (param_get ctx)
          (local_get temp))
        (if
          (condition
            (eq_i32
              (local_get op)
              (call_i32 op_load_i32)))
          (then
            (do
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr " = load i32, ptr "))))
          (else
            (do
              (if
                (condition
                  (eq_i32
                    (local_get op)
                    (call_i32 op_load_i64)))
                (then
                  (do
                    (call_i32
                      emit_cstr
                      (param_get ctx)
                      (const_string_ptr " = load i64, ptr "))))
                (else
                  (do
                    (if
                      (condition
                        (eq_i32
                          (local_get op)
                          (call_i32 op_load_ptr)))
                      (then
                        (do
                          (call_i32
                            emit_cstr
                            (param_get ctx)
                            (const_string_ptr " = load ptr, ptr "))))
                      (else
                        (do
                          (call_i32
                            emit_cstr
                            (param_get ctx)
                            (const_string_ptr " = load i8, ptr ")))))))))))
        (call_i32
          emit_temp_name
          (param_get ctx)
          (local_get ptr_value))
        (call_i32
          emit_newline
          (param_get ctx))
        (if
          (condition
            (eq_i32
              (local_get op)
              (call_i32 op_load_u8)))
          (then
            (do
              (let
                wide_temp
                i64
                (call_i64
                  next_temp
                  (param_get ctx)))
              (call_i32
                emit_temp_def_name
                (param_get ctx)
                (local_get wide_temp))
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr " = zext i8 "))
              (call_i32
                emit_temp_name
                (param_get ctx)
                (local_get temp))
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr " to i32"))
              (call_i32
                emit_newline
                (param_get ctx))
              (return
                (local_get wide_temp))))
          (else
            (do)))
        (return
          (local_get temp))))

; =============================================================================
; Constant emission
; =============================================================================

; emit_const_i32_expr
;
; Emits or computes LLVM output for const i32 expr.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   i64 result value.

(fn
      emit_const_i32_expr
      (params
        (ctx ptr)
        (node i64))
      (returns i64)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          temp
          i64
          (call_i64
            next_temp
            (param_get ctx)))
        (call_i32
          emit_temp_def_name
          (param_get ctx)
          (local_get temp))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr " = add i32 0, "))
        (call_i32
          emit_i64_as_i32
          (param_get ctx)
          (call_i64
            ast_a_at
            (local_get ast)
            (param_get node)))
        (call_i32
          emit_newline
          (param_get ctx))
        (return
          (local_get temp))))

; emit_const_i64_expr
;
; Emits or computes LLVM output for const i64 expr.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   i64 result value.

(fn
      emit_const_i64_expr
      (params
        (ctx ptr)
        (node i64))
      (returns i64)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          temp
          i64
          (call_i64
            next_temp
            (param_get ctx)))
        (call_i32
          emit_temp_def_name
          (param_get ctx)
          (local_get temp))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr " = add i64 0, "))
        (call_i32
          emit_i64_as_i32
          (param_get ctx)
          (call_i64
            ast_a_at
            (local_get ast)
            (param_get node)))
        (call_i32
          emit_newline
          (param_get ctx))
        (return
          (local_get temp))))

; =============================================================================
; Unary emission
; =============================================================================

; emit_unary_expr
;
; Emits or computes LLVM output for unary expr.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   i64 result value.

(fn
      emit_unary_expr
      (params
        (ctx ptr)
        (node i64))
      (returns i64)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          op
          i32
          (cast_i64_to_i32
            (call_i64
              ast_op_type_at
              (local_get ast)
              (param_get node))))
        (let
          arg_node
          i64
          (call_i64
            ast_a_at
            (local_get ast)
            (param_get node)))
        (let
          arg_value
          i64
          (call_i64
            emit_expr
            (param_get ctx)
            (local_get arg_node)))
        (if
          (condition
            (lt_i64
              (local_get arg_value)
              (const_i64 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (let
          temp
          i64
          (call_i64
            next_temp
            (param_get ctx)))
        (if
          (condition
            (eq_i32
              (local_get op)
              (call_i32 op_cast_i64_to_i32)))
          (then
            (do
              (call_i32
                emit_temp_def_name
                (param_get ctx)
                (local_get temp))
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr " = trunc i64 "))
              (call_i32
                emit_temp_name
                (param_get ctx)
                (local_get arg_value))
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr " to i32"))
              (call_i32
                emit_newline
                (param_get ctx))
              (return
                (local_get temp))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get op)
              (call_i32 op_cast_i32_to_i64)))
          (then
            (do
              (call_i32
                emit_temp_def_name
                (param_get ctx)
                (local_get temp))
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr " = sext i32 "))
              (call_i32
                emit_temp_name
                (param_get ctx)
                (local_get arg_value))
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr " to i64"))
              (call_i32
                emit_newline
                (param_get ctx))
              (return
                (local_get temp))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get op)
              (call_i32 op_not_bool)))
          (then
            (do
              (call_i32
                emit_temp_def_name
                (param_get ctx)
                (local_get temp))
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr " = xor i1 "))
              (call_i32
                emit_temp_name
                (param_get ctx)
                (local_get arg_value))
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr ", true"))
              (call_i32
                emit_newline
                (param_get ctx))
              (return
                (local_get temp))))
          (else
            (do)))
        (return
          (const_i64 -1))))

; emit_const_bool_expr
;
; Emits or computes LLVM output for const bool expr.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   i64 result value.

(fn
      emit_const_bool_expr
      (params
        (ctx ptr)
        (node i64))
      (returns i64)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          temp
          i64
          (call_i64
            next_temp
            (param_get ctx)))
        (call_i32
          emit_temp_def_name
          (param_get ctx)
          (local_get temp))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr " = or i1 false, "))
        (if
          (condition
            (ne_i64
              (call_i64
                ast_a_at
                (local_get ast)
                (param_get node))
              (const_i64 0)))
          (then
            (do
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr "true"))))
          (else
            (do
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr "false")))))
        (call_i32
          emit_newline
          (param_get ctx))
        (return
          (local_get temp))))

; emit_const_null_expr
;
; Emits or computes LLVM output for const null expr.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   i64 result value.

(fn
      emit_const_null_expr
      (params
        (ctx ptr)
        (node i64))
      (returns i64)
      (do
        (let
          temp
          i64
          (call_i64
            next_temp
            (param_get ctx)))
        (call_i32
          emit_temp_def_name
          (param_get ctx)
          (local_get temp))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr " = getelementptr i8, ptr null, i64 0"))
        (call_i32
          emit_newline
          (param_get ctx))
        (return
          (local_get temp))))

; emit_const_string_expr
;
; Emits or computes LLVM output for const string expr.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   i64 result value.

(fn
      emit_const_string_expr
      (params
        (ctx ptr)
        (node i64))
      (returns i64)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          temp
          i64
          (call_i64
            next_temp
            (param_get ctx)))
        (call_i32
          emit_temp_def_name
          (param_get ctx)
          (local_get temp))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr " = getelementptr ["))
        (call_i32
          emit_i64_as_i32
          (param_get ctx)
          (add_i64
            (call_i64
              emit_string_decoded_length
              (param_get ctx)
              (param_get node))
            (const_i64 1)))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr " x i8], ptr @.str"))
        (call_i32
          emit_i64_as_i32
          (param_get ctx)
          (param_get node))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr ", i64 0, i64 0"))
        (call_i32
          emit_newline
          (param_get ctx))
        (return
          (local_get temp))))

; =============================================================================
; Binary emission
; =============================================================================

; emit_binary_op_text
;
; Emits or computes LLVM output for binary op text.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   op - Operator id.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.

(fn
      emit_binary_op_text
      (params
        (ctx ptr)
        (op i32))
      (returns i32)
      (do
        (if
          (condition
            (eq_i32
              (param_get op)
              (call_i32 op_add_i32)))
          (then
            (do
              (return
                (call_i32
                  emit_cstr
                  (param_get ctx)
                  (const_string_ptr " = add i32 ")))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (param_get op)
              (call_i32 op_sub_i32)))
          (then
            (do
              (return
                (call_i32
                  emit_cstr
                  (param_get ctx)
                  (const_string_ptr " = sub i32 ")))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (param_get op)
              (call_i32 op_mul_i32)))
