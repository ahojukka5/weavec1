; parser_types.wir
;
; Parser helpers for identifiers and WIR type names.
;
; Responsibilities:
;   - expose current identifier source spans
;   - parse textual type names into AST type ids
;   - set parser errors for unknown types
;
; Type parsing is deliberately narrow and mirrors the constants in ast_kinds.wir.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Identifier spans
; =============================================================================

; parser_ident_start
;
; Provides parser behavior for ident start.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   i64 result value.
(fn parser_ident_start
      (params
        (parser ptr))
      (returns i64)
      (do
        (return
          (call_i64
            parser_current_start
            (param_get parser)))))

; parser_ident_length
;
; Provides parser behavior for ident length.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   i64 result value.
(fn parser_ident_length
      (params
        (parser ptr))
      (returns i64)
      (do
        (return
          (call_i64
            parser_current_length
            (param_get parser)))))

; =============================================================================
; Type parsing
; =============================================================================

; parser_parse_type
;
; Provides parser behavior for parse type.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   i32 result value.
(fn parser_parse_type
      (params
        (parser ptr))
      (returns i32)
      (do
        (if
          (condition
            (ne_i32
              (call_i32
                parser_current_kind
                (param_get parser))
              (call_i32 token_ident)))
          (then
            (do
              (return
                (const_i32 -1))))
          (else
            (do)))
        (let
          source
          ptr
          (call_ptr
            parser_source
            (param_get parser)))
        (let
          text
          ptr
          (ptr_add
            (call_ptr
              source_data
              (local_get source))
            (call_i64
              parser_ident_start
              (param_get parser))))
        (let
          length
          i64
          (call_i64
            parser_ident_length
            (param_get parser)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "void")
              (const_i64 4)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (return
                (call_i32 type_void))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "i32")
              (const_i64 3)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (return
                (call_i32 type_i32))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "i64")
              (const_i64 3)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (return
                (call_i32 type_i64))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "bool")
              (const_i64 4)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (return
                (call_i32 type_bool))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get text)
              (local_get length)
              (const_string_ptr "ptr")
              (const_i64 3)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (return
                (call_i32 type_ptr))))
          (else
            (do)))
        (return
          (const_i32 -1))))
))
