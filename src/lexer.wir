; lexer.wir
;
; Source buffer and lexical analysis.
;
; Responsibilities:
;   - own source text storage and path metadata
;   - classify bytes used by the lexer
;   - lex identifiers, integers, strings, comments, and punctuation
;   - append token kinds and source spans to token storage
;
; The lexer works byte-by-byte by design so bootstrap behavior is predictable.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Source storage
; =============================================================================

;
; source_size
;
; Returns the size in bytes of a source record.
; The record stores source bytes, length, and path metadata.
;
; Returns:
;   source record byte size.
;
(fn source_size
      (params)
      (returns i64)
      (do
        (return
          (const_i64 24))))

;
; source_new
;
; Allocates and initializes a source record from file contents.
; The source owns the loaded byte buffer used by lexer and parser spans.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   data - byte array pointer.
;   length - byte length.
;   path - source or output path pointer.
;
; Returns:
;   source pointer, or null on allocation failure.
;
(fn source_new
      (params
        (data ptr)
        (length i64)
        (path ptr))
      (returns ptr)
      (do
        (let
          source
          ptr
          (call_ptr
            malloc
            (call_i64 source_size)))
        (if
          (condition
            (eq_ptr
              (local_get source)
              (const_null)))
          (then
            (do
              (return
                (const_null))))
          (else
            (do)))
        (store_ptr
          (local_get source)
          (param_get data))
        (store_i64
          (ptr_add
            (local_get source)
            (const_i64 8))
          (param_get length))
        (store_ptr
          (ptr_add
            (local_get source)
            (const_i64 16))
          (param_get path))
        (return
          (local_get source))))

;
; source_free
;
; Releases a source record and owned file contents.
; Token and AST spans become invalid after the source is freed.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   source - source buffer pointer.
;
; Returns:
;   no value.
;
(fn source_free
      (params
        (source ptr))
      (returns void)
      (do
        (if
          (condition
            (ne_ptr
              (param_get source)
              (const_null)))
          (then
            (do
              (call_void
                free
                (param_get source))))
          (else
            (do)))
        (return_void)))

;
; source_data
;
; Reads the source byte pointer.
; Lexer and parser span helpers index into this byte array.
;
; Parameters:
;   source - source buffer pointer.
;
; Returns:
;   source byte pointer.
;
(fn source_data
      (params
        (source ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (param_get source)))))

;
; source_length
;
; Reads the source byte length.
; Lexing stops when this length is reached.
;
; Parameters:
;   source - source buffer pointer.
;
; Returns:
;   source byte length.
;
(fn source_length
      (params
        (source ptr))
      (returns i64)
      (do
        (return
          (load_i64
            (ptr_add
              (param_get source)
              (const_i64 8))))))

;
; source_path
;
; Reads the source path pointer.
; Diagnostics can use this path when reporting source failures.
;
; Parameters:
;   source - source buffer pointer.
;
; Returns:
;   source path pointer.
;
(fn source_path
      (params
        (source ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (ptr_add
              (param_get source)
              (const_i64 16))))))

;
; source_byte_at
;
; Reads one byte from source text by index.
; The lexer uses this for deterministic byte-by-byte scanning.
;
; Parameters:
;   source - source buffer pointer.
;   index - zero-based node, token, or byte index.
;
; Returns:
;   byte value at the requested index.
;
(fn source_byte_at
      (params
        (source ptr)
        (index i64))
      (returns i32)
      (do
        (return
          (load_u8
            (ptr_add
              (call_ptr
                source_data
                (param_get source))
              (param_get index))))))

; =============================================================================
; Byte classification
; =============================================================================

;
; is_whitespace
;
; Returns whether the tested value satisfies `whitespace`.
; The predicate is kept small so parser, lexer, and runtime checks stay readable.
;
; Parameters:
;   ch - byte value being classified or lexed.
;
; Returns:
;   1 when true.
;   0 when false.
;
(fn is_whitespace
      (params
        (ch i32))
      (returns bool)
      (do
        (return
          (or_bool
            (or_bool
              (eq_i32
                (param_get ch)
                (const_i32 32))
              (eq_i32
                (param_get ch)
                (const_i32 9)))
            (or_bool
              (eq_i32
                (param_get ch)
                (const_i32 10))
              (eq_i32
                (param_get ch)
                (const_i32 13)))))))

;
; is_digit
;
; Returns whether the tested value satisfies `digit`.
; The predicate is kept small so parser, lexer, and runtime checks stay readable.
;
; Parameters:
;   ch - byte value being classified or lexed.
;
; Returns:
;   1 when true.
;   0 when false.
;
(fn is_digit
      (params
        (ch i32))
      (returns bool)
      (do
        (return
          (and_bool
            (ge_i32
              (param_get ch)
              (const_i32 48))
            (le_i32
              (param_get ch)
              (const_i32 57))))))

;
; is_alpha
;
; Returns whether the tested value satisfies `alpha`.
; The predicate is kept small so parser, lexer, and runtime checks stay readable.
;
; Parameters:
;   ch - byte value being classified or lexed.
;
; Returns:
;   1 when true.
;   0 when false.
;
(fn is_alpha
      (params
        (ch i32))
      (returns bool)
      (do
        (return
          (or_bool
            (and_bool
              (ge_i32
                (param_get ch)
                (const_i32 97))
              (le_i32
                (param_get ch)
                (const_i32 122)))
            (and_bool
              (ge_i32
                (param_get ch)
                (const_i32 65))
              (le_i32
                (param_get ch)
                (const_i32 90)))))))

;
; is_ident_start
;
; Returns whether the tested value satisfies `ident start`.
; The predicate is kept small so parser, lexer, and runtime checks stay readable.
;
; Parameters:
;   ch - byte value being classified or lexed.
;
; Returns:
;   1 when true.
;   0 when false.
;
(fn is_ident_start
      (params
        (ch i32))
      (returns bool)
      (do
        (return
          (or_bool
            (call_bool
              is_alpha
              (param_get ch))
            (eq_i32
              (param_get ch)
              (const_i32 95))))))

;
; is_ident_continue
;
; Returns whether the tested value satisfies `ident continue`.
; The predicate is kept small so parser, lexer, and runtime checks stay readable.
;
; Parameters:
;   ch - byte value being classified or lexed.
;
; Returns:
;   1 when true.
;   0 when false.
;
(fn is_ident_continue
      (params
        (ch i32))
      (returns bool)
      (do
        (return
          (or_bool
            (or_bool
              (call_bool
                is_ident_start
                (param_get ch))
              (call_bool
                is_digit
                (param_get ch)))
            (eq_i32
              (param_get ch)
              (const_i32 45))))))

; =============================================================================
; Keyword lookup
; =============================================================================

;
; keyword_kind
;
; Maps an identifier byte slice to a keyword token kind when it matches.
; The linear keyword checks keep the lexer table-free and easy to inspect.
;
; Parameters:
;   text - text pointer.
;   length - byte length.
;
; Returns:
;   keyword token id on match.
;   token_ident when the slice is not a keyword.
;
(fn keyword_kind
      (params
        (text ptr)
        (length i64))
      (returns i32)
      (do
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "fn")
              (const_i64 2)))
          (then
            (do
              (return
                (call_i32 token_fn))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "return")
              (const_i64 6)))
          (then
            (do
              (return
                (call_i32 token_return))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "return_void")
              (const_i64 11)))
          (then
            (do
              (return
                (call_i32 token_return_void))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "if")
              (const_i64 2)))
          (then
            (do
              (return
                (call_i32 token_if))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "while")
              (const_i64 5)))
          (then
            (do
              (return
                (call_i32 token_while))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "let")
              (const_i64 3)))
          (then
            (do
              (return
                (call_i32 token_let))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "set")
              (const_i64 3)))
          (then
            (do
              (return
                (call_i32 token_set))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "core-module")
              (const_i64 11)))
          (then
            (do
              (return
                (call_i32 token_core_module))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "core-version")
              (const_i64 12)))
          (then
            (do
              (return
                (call_i32 token_core_version))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "decls")
              (const_i64 5)))
          (then
            (do
              (return
                (call_i32 token_decls))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "extern")
              (const_i64 6)))
          (then
            (do
              (return
                (call_i32 token_extern))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "params")
              (const_i64 6)))
          (then
            (do
              (return
                (call_i32 token_params))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "returns")
              (const_i64 7)))
          (then
            (do
              (return
                (call_i32 token_returns))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "do")
              (const_i64 2)))
          (then
            (do
              (return
                (call_i32 token_do))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "condition")
              (const_i64 9)))
          (then
            (do
              (return
                (call_i32 token_condition))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "then")
              (const_i64 4)))
          (then
            (do
              (return
                (call_i32 token_then))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "block")
              (const_i64 5)))
          (then
            (do
              (return
                (call_i32 token_block))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (param_get text)
              (param_get length)
              (const_string_ptr "debug")
              (const_i64 5)))
          (then
            (do
              (return
                (call_i32 token_debug))))
          (else
            (do)))
        (return
          (call_i32 token_ident))))

; =============================================================================
; Token-specific lexing
; =============================================================================

;
; lex_integer
;
; Lexes integer and appends tokens to token storage.
; The lexer records source spans instead of copying token text.
;
; Parameters:
;   source - source buffer pointer.
;   tokens - token stream pointer.
;   start - source byte offset where lexing begins.
;
; Returns:
;   next source byte index on success, or 0 on fatal lexing failure.
;
(fn lex_integer
      (params
        (source ptr)
        (tokens ptr)
        (start i64))
      (returns i64)
      (do
        (let
          length
          i64
          (call_i64
            source_length
            (param_get source)))
        (let
          index
          i64
          (param_get start))
        (if
          (condition
            (and_bool
              (lt_i64
                (local_get index)
                (local_get length))
              (eq_i32
                (call_i32
                  source_byte_at
                  (param_get source)
                  (local_get index))
                (const_i32 45))))
          (then
            (do
              (set
                index
                (add_i64
                  (local_get index)
                  (const_i64 1)))))
          (else
            (do)))
        (while
          (condition
            (and_bool
              (lt_i64
                (local_get index)
                (local_get length))
              (call_bool
                is_digit
                (call_i32
                  source_byte_at
                  (param_get source)
                  (local_get index)))))
          (do
            (set
              index
              (add_i64
                (local_get index)
                (const_i64 1)))))
        (let
          token_length
          i64
          (sub_i64
            (local_get index)
            (param_get start)))
        (if
          (condition
            (eq_i64
              (local_get token_length)
              (const_i64 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (let
          text
          ptr
          (ptr_add
            (call_ptr
              source_data
              (param_get source))
            (param_get start)))
        (let
          value
          i32
          (call_i32
            atoi
            (local_get text)))
        (if
          (condition
            (ne_i32
              (call_i32
                tokens_push
                (param_get tokens)
                (call_i32 token_int)
                (param_get start)
                (local_get token_length)
                (local_get value))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (return
          (local_get index))))

;
; lex_identifier
;
; Lexes identifier and appends tokens to token storage.
; The lexer records source spans instead of copying token text.
;
; Parameters:
;   source - source buffer pointer.
;   tokens - token stream pointer.
;   start - source byte offset where lexing begins.
;
; Returns:
;   next source byte index on success, or 0 on fatal lexing failure.
;
(fn lex_identifier
      (params
        (source ptr)
        (tokens ptr)
        (start i64))
      (returns i64)
      (do
        (let
          length
          i64
          (call_i64
            source_length
            (param_get source)))
        (let
          index
          i64
          (param_get start))
        (while
          (condition
            (and_bool
              (lt_i64
                (local_get index)
                (local_get length))
              (call_bool
                is_ident_continue
                (call_i32
                  source_byte_at
                  (param_get source)
                  (local_get index)))))
          (do
            (set
              index
              (add_i64
                (local_get index)
                (const_i64 1)))))
        (let
          token_length
          i64
          (sub_i64
            (local_get index)
            (param_get start)))
        (let
          text
          ptr
          (ptr_add
            (call_ptr
              source_data
              (param_get source))
            (param_get start)))
        (let
          kind
          i32
          (call_i32
            keyword_kind
            (local_get text)
            (local_get token_length)))
        (if
          (condition
            (ne_i32
              (call_i32
                tokens_push
                (param_get tokens)
                (local_get kind)
                (param_get start)
                (local_get token_length)
                (const_i32 0))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (return
          (local_get index))))

;
; lex_string
;
; Lexes string and appends tokens to token storage.
; The lexer records source spans instead of copying token text.
;
; Parameters:
;   source - source buffer pointer.
;   tokens - token stream pointer.
;   start - source byte offset where lexing begins.
;
; Returns:
;   next source byte index on success, or 0 on fatal lexing failure.
;
(fn lex_string
      (params
        (source ptr)
        (tokens ptr)
        (start i64))
      (returns i64)
      (do
        (let
          length
          i64
          (call_i64
            source_length
            (param_get source)))
        (let
          content_start
          i64
          (add_i64
            (param_get start)
            (const_i64 1)))
        (let
          index
          i64
          (local_get content_start))
        (let
          escaped
          i32
          (const_i32 0))
        (while
          (condition
            (lt_i64
              (local_get index)
              (local_get length)))
          (do
            (let
              ch
              i32
              (call_i32
                source_byte_at
                (param_get source)
                (local_get index)))
            (if
              (condition
                (ne_i32
                  (local_get escaped)
                  (const_i32 0)))
              (then
                (do
                  (set
                    escaped
                    (const_i32 0))
                  (set
                    index
                    (add_i64
                      (local_get index)
                      (const_i64 1)))))
              (else
                (do
                  (if
                    (condition
                      (eq_i32
                        (local_get ch)
                        (const_i32 34)))
                    (then
                      (do
                        (let
                          content_length
                          i64
                          (sub_i64
                            (local_get index)
                            (local_get content_start)))
                        (if
                          (condition
                            (ne_i32
                              (call_i32
                                tokens_push
                                (param_get tokens)
                                (call_i32 token_string)
                                (local_get content_start)
                                (local_get content_length)
                                (const_i32 0))
                              (const_i32 0)))
                          (then
                            (do
                              (return
                                (const_i64 -1))))
                          (else
                            (do)))
                        (return
                          (add_i64
                            (local_get index)
                            (const_i64 1)))))
                    (else
                      (do)))
                  (if
                    (condition
                      (eq_i32
                        (local_get ch)
                        (const_i32 92)))
                    (then
                      (do
                        (set
                          escaped
                          (const_i32 1))))
                    (else
                      (do)))
                  (set
                    index
                    (add_i64
                      (local_get index)
                      (const_i64 1))))))))
        (return
          (const_i64 -1))))

;
; skip_comment
;
; Skips a line comment and returns the first byte after it.
; Comments do not produce tokens.
;
; Parameters:
;   source - source buffer pointer.
;   start - source byte offset where lexing begins.
;
; Returns:
;   source byte index after the comment.
;
(fn skip_comment
      (params
        (source ptr)
        (start i64))
      (returns i64)
      (do
        (let
          length
          i64
          (call_i64
            source_length
            (param_get source)))
        (let
          index
          i64
          (param_get start))
        (while
          (condition
            (lt_i64
              (local_get index)
              (local_get length)))
          (do
            (let
              ch
              i32
              (call_i32
                source_byte_at
                (param_get source)
                (local_get index)))
            (if
              (condition
                (eq_i32
                  (local_get ch)
                  (const_i32 10)))
              (then
                (do
                  (return
                    (local_get index))))
              (else
                (do)))
            (set
              index
              (add_i64
                (local_get index)
                (const_i64 1)))))
        (return
          (local_get index))))

;
; lex_punctuation
;
; Lexes punctuation and appends tokens to token storage.
; The lexer records source spans instead of copying token text.
;
; Parameters:
;   source - source buffer pointer.
;   tokens - token stream pointer.
;   index - zero-based node, token, or byte index.
;   ch - byte value being classified or lexed.
;
; Returns:
;   next source byte index on success, or 0 on fatal lexing failure.
;
(fn lex_punctuation
      (params
        (source ptr)
        (tokens ptr)
        (index i64)
        (ch i32))
      (returns i64)
      (do
        (if
          (condition
            (eq_i32
              (param_get ch)
              (const_i32 40)))
          (then
            (do
              (if
                (condition
                  (ne_i32
                    (call_i32
                      tokens_push
                      (param_get tokens)
                      (call_i32 token_lparen)
                      (param_get index)
                      (const_i64 1)
                      (const_i32 0))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (return
                (add_i64
                  (param_get index)
                  (const_i64 1)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (param_get ch)
              (const_i32 41)))
          (then
            (do
              (if
                (condition
                  (ne_i32
                    (call_i32
                      tokens_push
                      (param_get tokens)
                      (call_i32 token_rparen)
                      (param_get index)
                      (const_i64 1)
                      (const_i32 0))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (return
                (add_i64
                  (param_get index)
                  (const_i64 1)))))
          (else
            (do)))
        (return
          (const_i64 -1))))

; =============================================================================
; Lexer entry point
; =============================================================================

;
; lex
;
; Lexes full source buffer and appends tokens to token storage.
; The lexer records source spans instead of copying token text.
;
; Parameters:
;   source - source buffer pointer.
;   tokens - token stream pointer.
;
; Returns:
;   next source byte index on success, or 0 on fatal lexing failure.
;
(fn lex
      (params
        (source ptr)
        (tokens ptr))
      (returns i32)
      (do
        (if
          (condition
            (or_bool
              (eq_ptr
                (param_get source)
                (const_null))
              (eq_ptr
                (param_get tokens)
                (const_null))))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          length
          i64
          (call_i64
            source_length
            (param_get source)))
        (let
          index
          i64
          (const_i64 0))
        (while
          (condition
            (lt_i64
              (local_get index)
              (local_get length)))
          (do
            (let
              ch
              i32
              (call_i32
                source_byte_at
                (param_get source)
                (local_get index)))
            (let
              handled
              i32
              (const_i32 0))
            (if
              (condition
                (call_bool
                  is_whitespace
                  (local_get ch)))
              (then
                (do
                  (set
                    index
                    (add_i64
                      (local_get index)
                      (const_i64 1)))
                  (set
                    handled
                    (const_i32 1))))
              (else
                (do)))
            (if
              (condition
                (and_bool
                  (eq_i32
                    (local_get handled)
                    (const_i32 0))
                  (eq_i32
                    (local_get ch)
                    (const_i32 59))))
              (then
                (do
                  (set
                    index
                    (call_i64
                      skip_comment
                      (param_get source)
                      (local_get index)))
                  (set
                    handled
                    (const_i32 1))))
              (else
                (do)))
            (if
              (condition
                (and_bool
                  (eq_i32
                    (local_get handled)
                    (const_i32 0))
                  (call_bool
                    is_ident_start
                    (local_get ch))))
              (then
                (do
                  (set
                    index
                    (call_i64
                      lex_identifier
                      (param_get source)
                      (param_get tokens)
                      (local_get index)))
                  (set
                    handled
                    (const_i32 1))))
              (else
                (do)))
            (if
              (condition
                (and_bool
                  (eq_i32
                    (local_get handled)
                    (const_i32 0))
                  (call_bool
                    is_digit
                    (local_get ch))))
              (then
                (do
                  (set
                    index
                    (call_i64
                      lex_integer
                      (param_get source)
                      (param_get tokens)
                      (local_get index)))
                  (set
                    handled
                    (const_i32 1))))
              (else
                (do)))
            (if
              (condition
                (and_bool
                  (eq_i32
                    (local_get handled)
                    (const_i32 0))
                  (and_bool
                    (eq_i32
                      (local_get ch)
                      (const_i32 45))
                    (and_bool
                      (lt_i64
                        (add_i64
                          (local_get index)
                          (const_i64 1))
                        (call_i64
                          source_length
                          (param_get source)))
                      (call_bool
                        is_digit
                        (call_i32
                          source_byte_at
                          (param_get source)
                          (add_i64
                            (local_get index)
                            (const_i64 1))))))))
              (then
                (do
                  (set
                    index
                    (call_i64
                      lex_integer
                      (param_get source)
                      (param_get tokens)
                      (local_get index)))
                  (set
                    handled
                    (const_i32 1))))
              (else
                (do)))
            (if
              (condition
                (and_bool
                  (eq_i32
                    (local_get handled)
                    (const_i32 0))
                  (eq_i32
                    (local_get ch)
                    (const_i32 34))))
              (then
                (do
                  (set
                    index
                    (call_i64
                      lex_string
                      (param_get source)
                      (param_get tokens)
                      (local_get index)))
                  (set
                    handled
                    (const_i32 1))))
              (else
                (do)))
            (if
              (condition
                (eq_i32
                  (local_get handled)
                  (const_i32 0)))
              (then
                (do
                  (set
                    index
                    (call_i64
                      lex_punctuation
                      (param_get source)
                      (param_get tokens)
                      (local_get index)
                      (local_get ch)))))
              (else
                (do)))
            (if
              (condition
                (lt_i64
                  (local_get index)
                  (const_i64 0)))
              (then
                (do
                  (return
                    (const_i32 1))))
              (else
                (do)))))
        (if
          (condition
            (ne_i32
              (call_i32
                tokens_push
                (param_get tokens)
                (call_i32 token_eof)
                (local_get length)
                (const_i64 0)
                (const_i32 0))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do
              (return
                (const_i32 0)))))))))
