; emit_sections.wir
;
; LLVM module section and declaration helpers.
;
; Responsibilities:
;   - emit module headers
;   - detect whether runtime declarations are needed
;   - emit external runtime declarations on demand
;
; The declaration checks are simple AST scans so generated LLVM stays minimal
; without adding a separate analysis phase.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Module header emission
; =============================================================================

;
; emit_module_header
;
; Emits LLVM text for `module header`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_module_header
      (params
        (ctx ptr))
      (returns i32)
      (do
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr "; generated by weavec1"))
        (call_i32
          emit_newline
          (param_get ctx))
        (let
          source
          ptr
          (call_ptr
            ctx_source
            (param_get ctx)))
        (let
          source_path
          ptr
          (call_ptr
            source_path
            (local_get source)))
        (if
          (condition
            (ne_ptr
              (local_get source_path)
              (const_null)))
          (then
            (do
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr "; source: "))
              (call_i32
                emit_cstr
                (param_get ctx)
                (local_get source_path))
              (call_i32
                emit_newline
                (param_get ctx))))
          (else
            (do)))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr "; core-version: 1"))
        (call_i32
          emit_newline
          (param_get ctx))
        (call_i32
          emit_newline
          (param_get ctx))
        (return
          (const_i32 0))))

; =============================================================================
; Runtime usage scans
; =============================================================================

;
; emit_uses_call_name
;
; Emits LLVM text for `uses call name`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;   name - function parameter.
;   name_len - name byte length.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_uses_call_name
      (params
        (ctx ptr)
        (name ptr)
        (name_len i64))
      (returns bool)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          source
          ptr
          (call_ptr
            ctx_source
            (param_get ctx)))
        (let
          i
          i64
          (const_i64 0))
        (let
          node_count
          i64
          (call_i64
            ast_count
            (local_get ast)))
        (while
          (condition
            (lt_i64
              (local_get i)
              (local_get node_count)))
          (do
            (if
              (condition
                (eq_i32
                  (call_i32
                    ast_kind_at
                    (local_get ast)
                    (local_get i))
                  (call_i32 ast_call)))
              (then
                (do
                  (if
                    (condition
                      (call_bool
                        bytes_equal
                        (ptr_add
                          (call_ptr
                            source_data
                            (local_get source))
                          (call_i64
                            ast_text_start_at
                            (local_get ast)
                            (local_get i)))
                        (call_i64
                          ast_text_len_at
                          (local_get ast)
                          (local_get i))
                        (param_get name)
                        (param_get name_len)))
                    (then
                      (do
                        (return
                          (const_bool true))))
                    (else
                      (do)))))
              (else
                (do)))
            (set
              i
              (add_i64
                (local_get i)
                (const_i64 1)))))
        (return
          (const_bool false))))

; =============================================================================
; Runtime declaration emission
; =============================================================================

;
; emit_declare_if_used
;
; Emits LLVM text for `declare if used`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;   name - function parameter.
;   name_len - name byte length.
;   decl - LLVM declaration text pointer.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_declare_if_used
      (params
        (ctx ptr)
        (name ptr)
        (name_len i64)
        (decl ptr))
      (returns i32)
      (do
        (if
          (condition
            (call_bool
              emit_uses_call_name
              (param_get ctx)
              (param_get name)
              (param_get name_len)))
          (then
            (do
              (call_i32
                emit_cstr
                (param_get ctx)
                (param_get decl))
              (call_i32
                emit_newline
                (param_get ctx))))
          (else
            (do)))
        (return
          (const_i32 0))))

;
; emit_uses_node_kind
;
; Emits LLVM text for `uses node kind`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;   kind - token or AST kind id.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_uses_node_kind
      (params
        (ctx ptr)
        (kind i32))
      (returns bool)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          i
          i64
          (const_i64 0))
        (let
          node_count
          i64
          (call_i64
            ast_count
            (local_get ast)))
        (while
          (condition
            (lt_i64
              (local_get i)
              (local_get node_count)))
          (do
            (if
              (condition
                (eq_i32
                  (call_i32
                    ast_kind_at
                    (local_get ast)
                    (local_get i))
                  (param_get kind)))
              (then
                (do
                  (return
                    (const_bool true))))
              (else
                (do)))
            (set
              i
              (add_i64
                (local_get i)
                (const_i64 1)))))
        (return
          (const_bool false))))

;
; emit_declare_puts_if_used
;
; Emits LLVM text for `declare puts if used`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_declare_puts_if_used
      (params
        (ctx ptr))
      (returns i32)
      (do
        (if
          (condition
            (or_bool
              (call_bool
                emit_uses_call_name
                (param_get ctx)
                (const_string_ptr "puts")
                (const_i64 4))
              (call_bool
                emit_uses_node_kind
                (param_get ctx)
                (call_i32 ast_print))))
          (then
            (do
              (call_i32
                emit_cstr
                (param_get ctx)
                (const_string_ptr "declare i32 @puts(ptr)"))
              (call_i32
                emit_newline
                (param_get ctx))))
          (else
            (do)))
        (return
          (const_i32 0))))

;
; emit_uses_runtime_declaration
;
; Emits LLVM text for `uses runtime declaration`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_uses_runtime_declaration
      (params
        (ctx ptr))
      (returns bool)
      (do
        (if
          (condition
            (or_bool
              (or_bool
                (or_bool
                  (call_bool
                    emit_uses_call_name
                    (param_get ctx)
                    (const_string_ptr "malloc")
                    (const_i64 6))
                  (call_bool
                    emit_uses_call_name
                    (param_get ctx)
                    (const_string_ptr "realloc")
                    (const_i64 7)))
                (or_bool
                  (call_bool
                    emit_uses_call_name
                    (param_get ctx)
                    (const_string_ptr "free")
                    (const_i64 4))
                  (call_bool
                    emit_uses_call_name
                    (param_get ctx)
                    (const_string_ptr "memcpy")
                    (const_i64 6))))
              (or_bool
                (or_bool
                  (call_bool
                    emit_uses_call_name
                    (param_get ctx)
                    (const_string_ptr "puts")
                    (const_i64 4))
                  (call_bool
                    emit_uses_node_kind
                    (param_get ctx)
                    (call_i32 ast_print)))
                (or_bool
                  (call_bool
                    emit_uses_call_name
                    (param_get ctx)
                    (const_string_ptr "weave_rt_read_file")
                    (const_i64 18))
                  (call_bool
                    emit_uses_call_name
                    (param_get ctx)
                    (const_string_ptr "weave_rt_write_file")
                    (const_i64 19))))))
          (then
            (do
              (return
                (const_bool true))))
          (else
            (do)))
        (if
          (condition
            (or_bool
              (or_bool
                (or_bool
                  (call_bool
                    emit_uses_call_name
                    (param_get ctx)
                    (const_string_ptr "strlen")
                    (const_i64 6))
                  (call_bool
                    emit_uses_call_name
                    (param_get ctx)
                    (const_string_ptr "strcmp")
                    (const_i64 6)))
                (or_bool
                  (call_bool
                    emit_uses_call_name
                    (param_get ctx)
                    (const_string_ptr "strncmp")
                    (const_i64 7))
                  (call_bool
                    emit_uses_call_name
                    (param_get ctx)
                    (const_string_ptr "atoi")
                    (const_i64 4))))
              (or_bool
                (call_bool
                  emit_uses_call_name
                  (param_get ctx)
                  (const_string_ptr "putchar")
                  (const_i64 7))
                (call_bool
                  emit_uses_call_name
                  (param_get ctx)
                  (const_string_ptr "weave_rt_fatal")
                  (const_i64 14)))))
          (then
            (do
              (return
                (const_bool true))))
          (else
            (do)))
        (return
          (const_bool false))))

;
; emit_runtime_declarations
;
; Emits LLVM text for `runtime declarations`.
; The emitter writes textual LLVM directly to the output buffer for bootstrap clarity.
;
; Parameters:
;   ctx - emission context pointer.
;
; Returns:
;   0 on success.
;   nonzero on emission failure.
;
(fn emit_runtime_declarations
      (params
        (ctx ptr))
      (returns i32)
      (do
        (if
          (condition
            (not_bool
              (call_bool
                emit_uses_runtime_declaration
                (param_get ctx))))
          (then
            (do
              (return
                (const_i32 0))))
          (else
            (do)))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr "; declarations"))
        (call_i32
          emit_newline
          (param_get ctx))
        (call_i32
          emit_newline
          (param_get ctx))
        (call_i32
          emit_declare_if_used
          (param_get ctx)
          (const_string_ptr "malloc")
          (const_i64 6)
          (const_string_ptr "declare ptr @malloc(i64)"))
        (call_i32
          emit_declare_if_used
          (param_get ctx)
          (const_string_ptr "realloc")
          (const_i64 7)
          (const_string_ptr "declare ptr @realloc(ptr, i64)"))
        (call_i32
          emit_declare_if_used
          (param_get ctx)
          (const_string_ptr "free")
          (const_i64 4)
          (const_string_ptr "declare void @free(ptr)"))
        (call_i32
          emit_declare_if_used
          (param_get ctx)
          (const_string_ptr "memcpy")
          (const_i64 6)
          (const_string_ptr "declare ptr @memcpy(ptr, ptr, i64)"))
        (call_i32
          emit_declare_if_used
          (param_get ctx)
          (const_string_ptr "strlen")
          (const_i64 6)
          (const_string_ptr "declare i64 @strlen(ptr)"))
        (call_i32
          emit_declare_if_used
          (param_get ctx)
          (const_string_ptr "strcmp")
          (const_i64 6)
          (const_string_ptr "declare i32 @strcmp(ptr, ptr)"))
        (call_i32
          emit_declare_if_used
          (param_get ctx)
          (const_string_ptr "strncmp")
          (const_i64 7)
          (const_string_ptr "declare i32 @strncmp(ptr, ptr, i64)"))
        (call_i32
          emit_declare_if_used
          (param_get ctx)
          (const_string_ptr "atoi")
          (const_i64 4)
          (const_string_ptr "declare i32 @atoi(ptr)"))
        (call_i32
          emit_declare_puts_if_used
          (param_get ctx))
        (call_i32
          emit_declare_if_used
          (param_get ctx)
          (const_string_ptr "putchar")
          (const_i64 7)
          (const_string_ptr "declare i32 @putchar(i32)"))
        (call_i32
          emit_declare_if_used
          (param_get ctx)
          (const_string_ptr "weave_rt_read_file")
          (const_i64 18)
          (const_string_ptr "declare ptr @weave_rt_read_file(ptr, ptr)"))
        (call_i32
          emit_declare_if_used
          (param_get ctx)
          (const_string_ptr "weave_rt_write_file")
          (const_i64 19)
          (const_string_ptr "declare i32 @weave_rt_write_file(ptr, ptr, i64)"))
        (call_i32
          emit_declare_if_used
          (param_get ctx)
          (const_string_ptr "weave_rt_fatal")
          (const_i64 14)
          (const_string_ptr "declare void @weave_rt_fatal(ptr)"))
        (call_i32
          emit_newline
          (param_get ctx))
        (return
          (const_i32 0))))
))
