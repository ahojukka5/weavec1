; main.wir
;
; Command-line entry point for weavec1.
;
; Responsibilities:
;   - validate command-line arguments
;   - print user-facing usage and banner text
;   - invoke the compiler driver for input and output paths
;
; The compiler pipeline itself lives in driver.wir.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; CLI entry point
; =============================================================================

; print_usage
;
; Implements print usage for the weavec1 bootstrap compiler.
;
; Returns:
;   no value.
(fn print_usage
      (params)
      (returns void)
      (do
        (call_i32
          puts
          (const_string_ptr "usage: weavec1 <input.wir> <output.ll>"))
        (return_void)))

; print_banner
;
; Implements print banner for the weavec1 bootstrap compiler.
;
; Returns:
;   no value.
(fn print_banner
      (params)
      (returns void)
      (do
        (call_i32
          puts
          (const_string_ptr "weavec1 - Weave bootstrap compiler"))
        (return_void)))

; main
;
; Implements main for the weavec1 bootstrap compiler.
;
; Parameters:
;   argc - Argument count.
;
;   argv - Argument vector pointer.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn main
      (params
        (argc i32)
        (argv ptr))
      (returns i32)
      (do
        (call_void print_banner)
        (if
          (condition
            (ne_i32
              (param_get argc)
              (const_i32 3)))
          (then
            (do
              (call_void print_usage)
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          input_path
          ptr
          (load_ptr
            (ptr_add
              (param_get argv)
              (const_i64 8))))
        (let
          output_path
          ptr
          (load_ptr
            (ptr_add
              (param_get argv)
              (const_i64 16))))
        (if
          (condition
            (or_bool
              (eq_ptr
                (local_get input_path)
                (const_null))
              (eq_ptr
                (local_get output_path)
                (const_null))))
          (then
            (do
              (call_void print_usage)
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          status
          i32
          (call_i32
            compile_file
            (local_get input_path)
            (local_get output_path)))
        (if
          (condition
            (ne_i32
              (local_get status)
              (const_i32 0)))
          (then
            (do
              (call_i32
                puts
                (const_string_ptr "weavec1: compilation failed"))
              (return
                (const_i32 1))))
          (else
            (do)))
        (call_i32
          puts
          (const_string_ptr "weavec1: compilation succeeded"))
        (return
          (const_i32 0))))))
