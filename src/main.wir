; SPDX-License-Identifier: Apache-2.0
; main.wir
;
; Command-line entry point for weavec1.
;
; Responsibilities:
;   - validate command-line arguments
;   - print user-facing usage and banner text
;   - invoke the compiler driver for input and output paths
;
; The compiler pipeline itself lives in driver.wir.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; CLI entry point
; =============================================================================

;
; print_usage
;
; Prints the command-line usage.
; CLI text is isolated from compiler pipeline logic.
;
; Returns:
;   no value.
;
(fn print_usage
      (params)
      (returns void)
      (do
        (call_i32
          puts
          (const_string_ptr "usage: weavec1 <input.wir> <output.ll>"))
        (return_void)))

;
; print_banner
;
; Prints the command-line banner.
; CLI text is isolated from compiler pipeline logic.
;
; Returns:
;   no value.
;
(fn print_banner
      (params)
      (returns void)
      (do
        (call_i32
          puts
          (const_string_ptr "weavec1 - Weave bootstrap compiler"))
        (return_void)))

;
; main
;
; Runs the command-line entry point for this executable.
; Argument validation happens here before control passes to the driver.
;
; Parameters:
;   argc - argument count passed to the executable.
;   argv - argument vector passed to the executable.
;
; Returns:
;   process exit status.
;
(fn main
      (params
        (argc i32)
        (argv ptr))
      (returns i32)
      (do
        (call_void print_banner)
        (if
          (condition
            (ne_i32
              (param_get argc)
              (const_i32 3)))
          (then
            (do
              (call_void print_usage)
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          input_path
          ptr
          (load_ptr
            (ptr_add
              (param_get argv)
              (const_i64 8))))
        (let
          output_path
          ptr
          (load_ptr
            (ptr_add
              (param_get argv)
              (const_i64 16))))
        (if
          (condition
            (or_bool
              (eq_ptr
                (local_get input_path)
                (const_null))
              (eq_ptr
                (local_get output_path)
                (const_null))))
          (then
            (do
              (call_void print_usage)
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          status
          i32
          (call_i32
            compile_file
            (local_get input_path)
            (local_get output_path)))
        (if
          (condition
            (ne_i32
              (local_get status)
              (const_i32 0)))
          (then
            (do
              (call_i32
                puts
                (const_string_ptr "weavec1: compilation failed"))
              (return
                (const_i32 1))))
          (else
            (do)))
        (call_i32
          puts
          (const_string_ptr "weavec1: compilation succeeded"))
        (return
          (const_i32 0))))))
