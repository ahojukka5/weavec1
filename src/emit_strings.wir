; emit_strings.wir
;
; LLVM string literal emission.
;
; Responsibilities:
;   - assign deterministic string global names
;   - decode WIR string escape sequences
;   - emit LLVM byte arrays and string contents
;   - emit all string globals referenced by the AST
;
; Escape handling is explicit to keep bootstrap behavior visible.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; String global names
; =============================================================================

; emit_string_global
;
; Emits or computes LLVM output for string global.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn emit_string_global
      (params
        (ctx ptr)
        (node i64))
      (returns i32)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr "@.str"))
        (call_i32
          emit_i64_as_i32
          (param_get ctx)
          (param_get node))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr " = private unnamed_addr constant ["))
        (call_i32
          emit_i64_as_i32
          (param_get ctx)
          (add_i64
            (call_i64
              emit_string_decoded_length
              (param_get ctx)
              (param_get node))
            (const_i64 1)))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr " x i8] c"))
        (call_i32
          emit_byte
          (param_get ctx)
          (const_i32 34))
        (call_i32
          emit_string_contents
          (param_get ctx)
          (param_get node))
        (call_i32
          emit_escape_2
          (param_get ctx)
          (const_i32 48)
          (const_i32 48))
        (call_i32
          emit_byte
          (param_get ctx)
          (const_i32 34))
        (call_i32
          emit_newline
          (param_get ctx))
        (return
          (const_i32 0))))

; =============================================================================
; String decoding
; =============================================================================

; emit_string_decoded_length
;
; Emits or computes LLVM output for string decoded length.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   i64 result value.
(fn emit_string_decoded_length
      (params
        (ctx ptr)
        (node i64))
      (returns i64)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          start
          i64
          (call_i64
            ast_text_start_at
            (local_get ast)
            (param_get node)))
        (let
          end
          i64
          (add_i64
            (local_get start)
            (call_i64
              ast_text_len_at
              (local_get ast)
              (param_get node))))
        (let
          source
          ptr
          (call_ptr
            ctx_source
            (param_get ctx)))
        (let
          index
          i64
          (local_get start))
        (let
          length
          i64
          (const_i64 0))
        (while
          (condition
            (lt_i64
              (local_get index)
              (local_get end)))
          (do
            (if
              (condition
                (and_bool
                  (eq_i32
                    (call_i32
                      source_byte_at
                      (local_get source)
                      (local_get index))
                    (const_i32 92))
                  (lt_i64
                    (add_i64
                      (local_get index)
                      (const_i64 1))
                    (local_get end))))
              (then
                (do
                  (set
                    index
                    (add_i64
                      (local_get index)
                      (const_i64 2)))))
              (else
                (do
                  (set
                    index
                    (add_i64
                      (local_get index)
                      (const_i64 1))))))
            (set
              length
              (add_i64
                (local_get length)
                (const_i64 1)))))
        (return
          (local_get length))))

; emit_escape_2
;
; Emits or computes LLVM output for escape 2.
;
; Parameters:
;   ctx - EmitContext pointer.
;   a - First AST payload field.
;
;   b - Second AST payload field.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn emit_escape_2
      (params
        (ctx ptr)
        (a i32)
        (b i32))
      (returns i32)
      (do
        (if
          (condition
            (ne_i32
              (call_i32
                emit_byte
                (param_get ctx)
                (const_i32 92))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                emit_byte
                (param_get ctx)
                (param_get a))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (return
          (call_i32
            emit_byte
            (param_get ctx)
            (param_get b)))))

; emit_string_byte
;
; Emits or computes LLVM output for string byte.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   byte - Byte value.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn emit_string_byte
      (params
        (ctx ptr)
        (byte i32))
      (returns i32)
      (do
        (if
          (condition
            (eq_i32
              (param_get byte)
              (const_i32 34)))
          (then
            (do
              (return
                (call_i32
                  emit_escape_2
                  (param_get ctx)
                  (const_i32 50)
                  (const_i32 50)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (param_get byte)
              (const_i32 92)))
          (then
            (do
              (return
                (call_i32
                  emit_escape_2
                  (param_get ctx)
                  (const_i32 53)
                  (const_i32 67)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (param_get byte)
              (const_i32 10)))
          (then
            (do
              (return
                (call_i32
                  emit_escape_2
                  (param_get ctx)
                  (const_i32 48)
                  (const_i32 65)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (param_get byte)
              (const_i32 0)))
          (then
            (do
              (return
                (call_i32
                  emit_escape_2
                  (param_get ctx)
                  (const_i32 48)
                  (const_i32 48)))))
          (else
            (do)))
        (return
          (call_i32
            emit_byte
            (param_get ctx)
            (param_get byte)))))

; emit_string_escape
;
; Emits or computes LLVM output for string escape.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   byte - Byte value.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn emit_string_escape
      (params
        (ctx ptr)
        (byte i32))
      (returns i32)
      (do
        (if
          (condition
            (eq_i32
              (param_get byte)
              (const_i32 110)))
          (then
            (do
              (return
                (call_i32
                  emit_escape_2
                  (param_get ctx)
                  (const_i32 48)
                  (const_i32 65)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (param_get byte)
              (const_i32 48)))
          (then
            (do
              (return
                (call_i32
                  emit_escape_2
                  (param_get ctx)
                  (const_i32 48)
                  (const_i32 48)))))
          (else
            (do)))
        (return
          (call_i32
            emit_string_byte
            (param_get ctx)
            (param_get byte)))))

; emit_string_contents
;
; Emits or computes LLVM output for string contents.
;
; Parameters:
;   ctx - EmitContext pointer.
;
;   node - AST node index.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn emit_string_contents
      (params
        (ctx ptr)
        (node i64))
      (returns i32)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          start
          i64
          (call_i64
            ast_text_start_at
            (local_get ast)
            (param_get node)))
        (let
          end
          i64
          (add_i64
            (local_get start)
            (call_i64
              ast_text_len_at
              (local_get ast)
              (param_get node))))
        (let
          source
          ptr
          (call_ptr
            ctx_source
            (param_get ctx)))
        (let
          index
          i64
          (local_get start))
        (while
          (condition
            (lt_i64
              (local_get index)
              (local_get end)))
          (do
            (let
              byte
              i32
              (call_i32
                source_byte_at
                (local_get source)
                (local_get index)))
            (if
              (condition
                (and_bool
                  (eq_i32
                    (local_get byte)
                    (const_i32 92))
                  (lt_i64
                    (add_i64
                      (local_get index)
                      (const_i64 1))
                    (local_get end))))
              (then
                (do
                  (if
                    (condition
                      (ne_i32
                        (call_i32
                          emit_string_escape
                          (param_get ctx)
                          (call_i32
                            source_byte_at
                            (local_get source)
                            (add_i64
                              (local_get index)
                              (const_i64 1))))
                        (const_i32 0)))
                    (then
                      (do
                        (return
                          (const_i32 1))))
                    (else
                      (do)))
                  (set
                    index
                    (add_i64
                      (local_get index)
                      (const_i64 2)))))
              (else
                (do
                  (if
                    (condition
                      (ne_i32
                        (call_i32
                          emit_string_byte
                          (param_get ctx)
                          (local_get byte))
                        (const_i32 0)))
                    (then
                      (do
                        (return
                          (const_i32 1))))
                    (else
                      (do)))
                  (set
                    index
                    (add_i64
                      (local_get index)
                      (const_i64 1))))))))
        (return
          (const_i32 0))))

; =============================================================================
; String global emission
; =============================================================================

; emit_string_globals
;
; Emits or computes LLVM output for string globals.
;
;
; Parameters:
;   ctx - EmitContext pointer.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn emit_string_globals
      (params
        (ctx ptr))
      (returns i32)
      (do
        (let
          ast
          ptr
          (call_ptr
            ctx_ast
            (param_get ctx)))
        (let
          node_count
          i64
          (call_i64
            ast_count
            (local_get ast)))
        (let
          i
          i64
          (const_i64 0))
        (if
          (condition
            (not_bool
              (call_bool
                emit_uses_node_kind
                (param_get ctx)
                (call_i32 ast_const_string))))
          (then
            (do
              (return
                (const_i32 0))))
          (else
            (do)))
        (call_i32
          emit_cstr
          (param_get ctx)
          (const_string_ptr "; string literals"))
        (call_i32
          emit_newline
          (param_get ctx))
        (call_i32
          emit_newline
          (param_get ctx))
        (while
          (condition
            (lt_i64
              (local_get i)
              (local_get node_count)))
          (do
            (if
              (condition
                (eq_i32
                  (call_i32
                    ast_kind_at
                    (local_get ast)
                    (local_get i))
                  (call_i32 ast_const_string)))
              (then
                (do
                  (if
                    (condition
                      (ne_i32
                        (call_i32
                          emit_string_global
                          (param_get ctx)
                          (local_get i))
                        (const_i32 0)))
                    (then
                      (do
                        (return
                          (const_i32 1))))
                    (else
                      (do)))))
              (else
                (do)))
            (set
              i
              (add_i64
                (local_get i)
                (const_i64 1)))))
        (call_i32
          emit_newline
          (param_get ctx))
        (return
          (const_i32 0))))
))
