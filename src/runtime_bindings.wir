; runtime_bindings.wir
;
; Runtime function declarations used by generated LLVM.
;
; Responsibilities:
;   - declare file IO and fatal error hooks
;   - provide tiny pointer predicates used by WIR source
;
; Implementations are supplied by the runtime linked with emitted LLVM.

(core-module
  (core-version 1)
  (decls
    (extern
      malloc
      (params
        (size i64))
      (returns ptr))
    (extern
      realloc
      (params
        (old ptr)
        (size i64))
      (returns ptr))
    (extern
      free
      (params
        (p ptr))
      (returns void))
    (extern
      memcpy
      (params
        (dst ptr)
        (src ptr)
        (count i64))
      (returns ptr))
    (extern
      strlen
      (params
        (text ptr))
      (returns i64))
    (extern
      strcmp
      (params
        (a ptr)
        (b ptr))
      (returns i32))
    (extern
      strncmp
      (params
        (a ptr)
        (b ptr)
        (count i64))
      (returns i32))
    (extern
      atoi
      (params
        (text ptr))
      (returns i32))
    (extern
      puts
      (params
        (text ptr))
      (returns i32))
    (extern
      putchar
      (params
        (ch i32))
      (returns i32))
    (extern
      weave_rt_read_file
      (params
        (path ptr)
        (out_len ptr))
      (returns ptr))
    (extern
      weave_rt_write_file
      (params
        (path ptr)
        (data ptr)
        (length i64))
      (returns i32))
    (extern
      weave_rt_fatal
      (params
        (message ptr))
      (returns void))

; =============================================================================
; Runtime bindings
; =============================================================================

; read_file
;
; Implements read file for the weavec1 bootstrap compiler.
;
; Parameters:
;   path - Path string pointer.
;
;   out_len - Output length pointer.
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.
(fn read_file
      (params
        (path ptr)
        (out_len ptr))
      (returns ptr)
      (do
        (return
          (call_ptr
            weave_rt_read_file
            (param_get path)
            (param_get out_len)))))

; write_file
;
; Implements write file for the weavec1 bootstrap compiler.
;
; Parameters:
;   path - Path string pointer.
;   data - Byte pointer.
;
;   length - Byte length.
; Returns:
;   i32 result value.
(fn write_file
      (params
        (path ptr)
        (data ptr)
        (length i64))
      (returns i32)
      (do
        (return
          (call_i32
            weave_rt_write_file
            (param_get path)
            (param_get data)
            (param_get length)))))

; fatal
;
; Implements fatal for the weavec1 bootstrap compiler.
;
;
; Parameters:
;   message - Message string pointer or source offset.
; Returns:
;   i32 result value.
(fn fatal
      (params
        (message ptr))
      (returns i32)
      (do
        (call_void
          weave_rt_fatal
          (param_get message))
        (return
          (const_i32 1))))

; is_null
;
; Returns whether a byte or value satisfies null.
;
;
; Parameters:
;   p - Pointer value.
; Returns:
;   true when the predicate matches.
;   false otherwise.
(fn is_null
      (params
        (p ptr))
      (returns bool)
      (do
        (return
          (eq_ptr
            (param_get p)
            (const_null)))))

; not_null
;
; Implements not null for the weavec1 bootstrap compiler.
;
;
; Parameters:
;   p - Pointer value.
; Returns:
;   true when the predicate matches.
;   false otherwise.
(fn not_null
      (params
        (p ptr))
      (returns bool)
      (do
        (return
          (ne_ptr
            (param_get p)
            (const_null)))))))
