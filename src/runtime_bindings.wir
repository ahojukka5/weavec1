(core-module
  (core-version 1)
  (decls
    (extern
      malloc
      (params
        (size i64))
      (returns ptr))
    (extern
      realloc
      (params
        (old ptr)
        (size i64))
      (returns ptr))
    (extern
      free
      (params
        (p ptr))
      (returns void))
    (extern
      memcpy
      (params
        (dst ptr)
        (src ptr)
        (count i64))
      (returns ptr))
    (extern
      strlen
      (params
        (text ptr))
      (returns i64))
    (extern
      strcmp
      (params
        (a ptr)
        (b ptr))
      (returns i32))
    (extern
      strncmp
      (params
        (a ptr)
        (b ptr)
        (count i64))
      (returns i32))
    (extern
      atoi
      (params
        (text ptr))
      (returns i32))
    (extern
      puts
      (params
        (text ptr))
      (returns i32))
    (extern
      putchar
      (params
        (ch i32))
      (returns i32))
    (extern
      weave_rt_read_file
      (params
        (path ptr)
        (out_len ptr))
      (returns ptr))
    (extern
      weave_rt_write_file
      (params
        (path ptr)
        (data ptr)
        (length i64))
      (returns i32))
    (extern
      weave_rt_fatal
      (params
        (message ptr))
      (returns void))
    (fn
      read_file
      (params
        (path ptr)
        (out_len ptr))
      (returns ptr)
      (do
        (return
          (call_ptr
            weave_rt_read_file
            (param_get path)
            (param_get out_len)))))
    (fn
      write_file
      (params
        (path ptr)
        (data ptr)
        (length i64))
      (returns i32)
      (do
        (return
          (call_i32
            weave_rt_write_file
            (param_get path)
            (param_get data)
            (param_get length)))))
    (fn
      fatal
      (params
        (message ptr))
      (returns i32)
      (do
        (call_void
          weave_rt_fatal
          (param_get message))
        (return
          (const_i32 1))))
    (fn
      is_null
      (params
        (p ptr))
      (returns bool)
      (do
        (return
          (eq_ptr
            (param_get p)
            (const_null)))))
    (fn
      not_null
      (params
        (p ptr))
      (returns bool)
      (do
        (return
          (ne_ptr
            (param_get p)
            (const_null)))))))
