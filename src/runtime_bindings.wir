; SPDX-License-Identifier: Apache-2.0
; runtime_bindings.wir
;
; Runtime and libc declarations used by the Stage 1 compiler binary.
;
; Responsibilities:
;   - declare the allocation, text, output, and file IO hooks used by the compiler
;   - expose the two versioned file IO bindings through typed WIR wrappers
;
; Implementations are supplied by libc and the runtime linked with emitted LLVM.

(core-module
  (core-version 2)
  (decls
    (extern
      malloc
      (params
        (size i64))
      (returns ptr))
    (extern
      realloc
      (params
        (old ptr)
        (size i64))
      (returns ptr))
    (extern
      free
      (params
        (p ptr))
      (returns void))
    (extern
      memcpy
      (params
        (dst ptr)
        (src ptr)
        (count i64))
      (returns ptr))
    (extern
      strlen
      (params
        (text ptr))
      (returns i64))
    (extern
      strncmp
      (params
        (a ptr)
        (b ptr)
        (count i64))
      (returns i32))
    (extern
      atoi
      (params
        (text ptr))
      (returns i32))
    (extern
      puts
      (params
        (text ptr))
      (returns i32))
    (extern
      putchar
      (params
        (ch i32))
      (returns i32))
    (extern
      weave_rt_read_file
      (params
        (path ptr)
        (out_len ptr))
      (returns ptr))
    (extern
      weave_rt_write_file
      (params
        (path ptr)
        (data ptr)
        (length i64))
      (returns i32))

; =============================================================================
; Runtime bindings
; =============================================================================

;
; read_file
;
; Declares the runtime binding for `read_file`.
; The implementation is supplied by the runtime linked with generated LLVM.
;
; Parameters:
;   path - source or output path pointer.
;   out_len - output pointer receiving the read byte length.
;
; Returns:
;   pointer to loaded bytes, or null on read failure.
;
(fn read_file
      (params
        (path ptr)
        (out_len ptr))
      (returns ptr)
      (do
        (return
          (call_ptr
            weave_rt_read_file
            (param_get path)
            (param_get out_len)))))

;
; write_file
;
; Declares the runtime binding for `write_file`.
; The implementation is supplied by the runtime linked with generated LLVM.
;
; Parameters:
;   path - source or output path pointer.
;   data - byte array pointer.
;   length - byte length.
;
; Returns:
;   0 on success.
;   nonzero on write failure.
;
(fn write_file
      (params
        (path ptr)
        (data ptr)
        (length i64))
      (returns i32)
      (do
        (return
          (call_i32
            weave_rt_write_file
            (param_get path)
            (param_get data)
            (param_get length)))))
))
