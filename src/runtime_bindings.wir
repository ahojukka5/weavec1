; SPDX-License-Identifier: Apache-2.0
; runtime_bindings.wir
;
; Runtime function declarations used by generated LLVM.
;
; Responsibilities:
;   - declare file IO and fatal error hooks
;   - provide tiny pointer predicates used by WIR source
;
; Implementations are supplied by the runtime linked with emitted LLVM.

(core-module
  (core-version 1)
  (decls
    (extern
      malloc
      (params
        (size i64))
      (returns ptr))
    (extern
      realloc
      (params
        (old ptr)
        (size i64))
      (returns ptr))
    (extern
      free
      (params
        (p ptr))
      (returns void))
    (extern
      memcpy
      (params
        (dst ptr)
        (src ptr)
        (count i64))
      (returns ptr))
    (extern
      strlen
      (params
        (text ptr))
      (returns i64))
    (extern
      strcmp
      (params
        (a ptr)
        (b ptr))
      (returns i32))
    (extern
      strncmp
      (params
        (a ptr)
        (b ptr)
        (count i64))
      (returns i32))
    (extern
      atoi
      (params
        (text ptr))
      (returns i32))
    (extern
      puts
      (params
        (text ptr))
      (returns i32))
    (extern
      putchar
      (params
        (ch i32))
      (returns i32))
    (extern
      weave_rt_read_file
      (params
        (path ptr)
        (out_len ptr))
      (returns ptr))
    (extern
      weave_rt_write_file
      (params
        (path ptr)
        (data ptr)
        (length i64))
      (returns i32))
    (extern
      weave_rt_fatal
      (params
        (message ptr))
      (returns void))

; =============================================================================
; Runtime bindings
; =============================================================================

;
; read_file
;
; Declares the runtime binding for `read_file`.
; The implementation is supplied by the runtime linked with generated LLVM.
;
; Parameters:
;   path - source or output path pointer.
;   out_len - output pointer receiving the read byte length.
;
; Returns:
;   pointer to loaded bytes, or null on read failure.
;
(fn read_file
      (params
        (path ptr)
        (out_len ptr))
      (returns ptr)
      (do
        (return
          (call_ptr
            weave_rt_read_file
            (param_get path)
            (param_get out_len)))))

;
; write_file
;
; Declares the runtime binding for `write_file`.
; The implementation is supplied by the runtime linked with generated LLVM.
;
; Parameters:
;   path - source or output path pointer.
;   data - byte array pointer.
;   length - byte length.
;
; Returns:
;   pointer to loaded bytes, or null on read failure.
;
(fn write_file
      (params
        (path ptr)
        (data ptr)
        (length i64))
      (returns i32)
      (do
        (return
          (call_i32
            weave_rt_write_file
            (param_get path)
            (param_get data)
            (param_get length)))))

;
; fatal
;
; Declares the runtime binding for `fatal`.
; The implementation is supplied by the runtime linked with generated LLVM.
;
; Parameters:
;   message - message text pointer.
;
; Returns:
;   0 on success.
;   nonzero on write failure.
;
(fn fatal
      (params
        (message ptr))
      (returns i32)
      (do
        (call_void
          weave_rt_fatal
          (param_get message))
        (return
          (const_i32 1))))

;
; is_null
;
; Returns whether the tested value satisfies `null`.
; The predicate is kept small so parser, lexer, and runtime checks stay readable.
;
; Parameters:
;   p - pointer value.
;
; Returns:
;   no value; the runtime aborts execution.
;
(fn is_null
      (params
        (p ptr))
      (returns bool)
      (do
        (return
          (eq_ptr
            (param_get p)
            (const_null)))))

;
; not_null
;
; Returns whether the tested value satisfies `not null`.
; The predicate is kept small so parser, lexer, and runtime checks stay readable.
;
; Parameters:
;   p - pointer value.
;
; Returns:
;   1 when true.
;   0 when false.
;
(fn not_null
      (params
        (p ptr))
      (returns bool)
      (do
        (return
          (ne_ptr
            (param_get p)
            (const_null)))))))
