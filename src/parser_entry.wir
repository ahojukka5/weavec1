; parser_entry.wir
;
; Top-level parser entry point.
;
; Responsibilities:
;   - validate parser state before parsing
;   - call the top-level declaration parser
;   - provide a small public parse API for the driver
;
; A negative return value reports parse failure.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Parser entry point
; =============================================================================

; parse
;
; Implements parse for the weavec1 bootstrap compiler.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   AST node index on success.
;   -1 on parse or allocation failure.
(fn parse
      (params
        (parser ptr))
      (returns i64)
      (do
        (if
          (condition
            (eq_ptr
              (param_get parser)
              (const_null)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (return
          (call_i64
            parser_parse_toplevel
            (param_get parser)))))))
