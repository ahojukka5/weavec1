; SPDX-License-Identifier: Apache-2.0
; parser_entry.wir
;
; Top-level parser entry point.
;
; Responsibilities:
;   - validate parser state before parsing
;   - call the top-level declaration parser
;   - provide a small public parse API for the driver
;
; A negative return value reports parse failure.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Parser entry point
; =============================================================================

;
; parse
;
; Validates parser state and parses the top-level program.
; This is the public parser entry point used by the compiler driver.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   AST_PROGRAM node index on success.
;   -1 on parse failure.
;
(fn parse
      (params
        (parser ptr))
      (returns i64)
      (do
        (if
          (condition
            (eq_ptr
              (param_get parser)
              (const_null)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (return
          (call_i64
            parser_parse_toplevel
            (param_get parser)))))))
