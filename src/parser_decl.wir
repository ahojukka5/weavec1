; parser_decl.wir
;
; Parsing for top-level declarations.
;
; Responsibilities:
;   - parse function declarations and definitions
;   - parse extern declarations
;   - build the top-level program AST node
;
; This module owns declaration structure. Statement and expression parsing are
; delegated to parser_stmt.wir and parser_expr.wir.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Function declaration parsing
; =============================================================================

; parser_parse_function
;
; Provides parser behavior for parse function.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   AST node index on success.
;   -1 on parse or allocation failure.
(fn parser_parse_function
      (params
        (parser ptr))
      (returns i64)
      (do
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_lparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (call_i32
                parser_current_kind
                (param_get parser))
              (call_i32 token_extern)))
          (then
            (do
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_skip_extern_opened
                      (param_get parser))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (return
                (call_i64
                  ast_make_extern
                  (call_ptr
                    parser_ast
                    (param_get parser))
                  (call_i32 type_void)
                  (const_i64 0)
                  (const_i64 0)
                  (const_i64 0)
                  (const_i64 0)))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_fn))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_current_kind
                (param_get parser))
              (call_i32 token_ident)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (let
          name_start
          i64
          (call_i64
            parser_current_start
            (param_get parser)))
        (let
          name_len
          i64
          (call_i64
            parser_current_length
            (param_get parser)))
        (call_void
          parser_advance
          (param_get parser))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_lparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_params))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (let
          param_first
          i64
          (call_i64
            ast_count
            (call_ptr
              parser_ast
              (param_get parser))))
        (let
          param_count
          i64
          (const_i64 0))
        (while
          (condition
            (not_bool
              (call_bool
                parser_match
                (param_get parser)
                (call_i32 token_rparen))))
          (do
            (if
              (condition
                (ne_i32
                  (call_i32
                    parser_expect
                    (param_get parser)
                    (call_i32 token_lparen))
                  (const_i32 0)))
              (then
                (do
                  (return
                    (const_i64 -1))))
              (else
                (do)))
            (if
              (condition
                (ne_i32
                  (call_i32
                    parser_current_kind
                    (param_get parser))
                  (call_i32 token_ident)))
              (then
                (do
                  (return
                    (const_i64 -1))))
              (else
                (do)))
            (let
              param_name_start
              i64
              (call_i64
                parser_current_start
                (param_get parser)))
            (let
              param_name_len
              i64
              (call_i64
                parser_current_length
                (param_get parser)))
            (call_void
              parser_advance
              (param_get parser))
            (let
              type_id
              i32
              (call_i32
                parser_parse_type
                (param_get parser)))
            (if
              (condition
                (lt_i32
                  (local_get type_id)
                  (const_i32 0)))
              (then
                (do
                  (return
                    (const_i64 -1))))
              (else
                (do)))
            (if
              (condition
                (ne_i32
                  (call_i32
                    parser_expect
                    (param_get parser)
                    (call_i32 token_rparen))
                  (const_i32 0)))
              (then
                (do
                  (return
                    (const_i64 -1))))
              (else
                (do)))
            (call_i64
              ast_make_param
              (call_ptr
                parser_ast
                (param_get parser))
              (local_get type_id)
              (local_get param_name_start)
              (local_get param_name_len))
            (set
              param_count
              (add_i64
                (local_get param_count)
                (const_i64 1)))))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_rparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_lparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_returns))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (let
          return_type
          i32
          (call_i32
            parser_parse_type
            (param_get parser)))
        (if
          (condition
            (lt_i32
              (local_get return_type)
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_rparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (let
          do_node
          i64
          (call_i64
            parser_parse_stmt
            (param_get parser)))
        (if
          (condition
            (lt_i64
              (local_get do_node)
              (const_i64 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_rparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (return
          (call_i64
            ast_make_function
            (call_ptr
              parser_ast
              (param_get parser))
            (local_get return_type)
            (local_get param_first)
            (local_get param_count)
            (local_get do_node)
            (local_get name_start)
            (local_get name_len)))))

; =============================================================================
; Extern declaration parsing
; =============================================================================

; parser_skip_extern_opened
;
; Provides parser behavior for skip extern opened.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   i32 result value.
(fn parser_skip_extern_opened
      (params
        (parser ptr))
      (returns i32)
      (do
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_extern))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_current_kind
                (param_get parser))
              (call_i32 token_ident)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (call_void
          parser_advance
          (param_get parser))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_lparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_params))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (while
          (condition
            (not_bool
              (call_bool
                parser_match
                (param_get parser)
                (call_i32 token_rparen))))
          (do
            (if
              (condition
                (ne_i32
                  (call_i32
                    parser_expect
                    (param_get parser)
                    (call_i32 token_lparen))
                  (const_i32 0)))
              (then
                (do
                  (return
                    (const_i32 1))))
              (else
                (do)))
            (if
              (condition
                (ne_i32
                  (call_i32
                    parser_current_kind
                    (param_get parser))
                  (call_i32 token_ident)))
              (then
                (do
                  (return
                    (const_i32 1))))
              (else
                (do)))
            (call_void
              parser_advance
              (param_get parser))
            (if
              (condition
                (lt_i32
                  (call_i32
                    parser_parse_type
                    (param_get parser))
                  (const_i32 0)))
              (then
                (do
                  (return
                    (const_i32 1))))
              (else
                (do)))
            (if
              (condition
                (ne_i32
                  (call_i32
                    parser_expect
                    (param_get parser)
                    (call_i32 token_rparen))
                  (const_i32 0)))
              (then
                (do
                  (return
                    (const_i32 1))))
              (else
                (do)))))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_rparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_lparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_returns))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (if
          (condition
            (lt_i32
              (call_i32
                parser_parse_type
                (param_get parser))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_rparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_rparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (return
          (const_i32 0))))

; =============================================================================
; Top-level parsing
; =============================================================================

; parser_parse_toplevel
;
; Provides parser behavior for parse toplevel.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   AST node index on success.
;   -1 on parse or allocation failure.
(fn parser_parse_toplevel
      (params
        (parser ptr))
      (returns i64)
      (do
        (if
          (condition
            (ne_i32
              (call_i32
                parser_current_kind
                (param_get parser))
              (call_i32 token_lparen)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_lparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_core_module))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_lparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_core_version))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_current_kind
                (param_get parser))
              (call_i32 token_int)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (let
          version
          i32
          (call_i32
            token_value_at
            (call_ptr
              parser_tokens
              (param_get parser))
            (call_i64
              parser_index
              (param_get parser))))
        (if
          (condition
            (ne_i32
              (local_get version)
              (const_i32 1)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (call_void
          parser_advance
          (param_get parser))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_rparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_lparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_decls))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (let
          first
          i64
          (call_i64
            ast_count
            (call_ptr
              parser_ast
              (param_get parser))))
        (let
          count
          i64
          (const_i64 0))
        (while
          (condition
            (not_bool
              (call_bool
                parser_match
                (param_get parser)
                (call_i32 token_rparen))))
          (do
            (let
              decl
              i64
              (call_i64
                parser_parse_function
                (param_get parser)))
            (if
              (condition
                (lt_i64
                  (local_get decl)
                  (const_i64 0)))
              (then
                (do
                  (return
                    (const_i64 -1))))
              (else
                (do)))
            (if
              (condition
                (eq_i32
                  (call_i32
                    ast_kind_at
                    (call_ptr
                      parser_ast
                      (param_get parser))
                    (local_get decl))
                  (call_i32 ast_function)))
              (then
                (do
                  (set
                    count
                    (add_i64
                      (local_get count)
                      (const_i64 1)))))
              (else
                (do)))))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_rparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_rparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_eof))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (return
          (call_i64
            ast_make_program
            (call_ptr
              parser_ast
              (param_get parser))
            (local_get first)
            (add_i64
              (local_get first)
              (local_get count))
            (local_get count)))))
))
