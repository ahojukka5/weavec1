; parser_state.wir
;
; Parser state storage.
;
; Responsibilities:
;   - allocate and free parser records
;   - store source, token stream, AST, cursor index, and error code
;   - expose typed field accessors for parser modules
;
; Parser state uses a manual fixed-layout record to keep bootstrapping simple.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Parser layout constants
; =============================================================================

; parser_size
;
; Provides parser behavior for size.
;
; Returns:
;   i64 result value.
(fn parser_size
      (params)
      (returns i64)
      (do
        (return
          (const_i64 40))))

; =============================================================================
; Parser allocation
; =============================================================================

; parser_new
;
; Provides parser behavior for new.
;
; Parameters:
;   source - Source buffer pointer.
;   tokens - Token stream pointer.
;
;   ast - AST container pointer.
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.
(fn parser_new
      (params
        (source ptr)
        (tokens ptr)
        (ast ptr))
      (returns ptr)
      (do
        (let
          parser
          ptr
          (call_ptr
            malloc
            (call_i64 parser_size)))
        (if
          (condition
            (eq_ptr
              (local_get parser)
              (const_null)))
          (then
            (do
              (return
                (const_null))))
          (else
            (do)))
        (store_ptr
          (local_get parser)
          (param_get source))
        (store_ptr
          (ptr_add
            (local_get parser)
            (const_i64 8))
          (param_get tokens))
        (store_ptr
          (ptr_add
            (local_get parser)
            (const_i64 16))
          (param_get ast))
        (store_i64
          (ptr_add
            (local_get parser)
            (const_i64 24))
          (const_i64 0))
        (store_i32
          (ptr_add
            (local_get parser)
            (const_i64 32))
          (const_i32 0))
        (return
          (local_get parser))))

; parser_free
;
; Provides parser behavior for free.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   no value.
(fn parser_free
      (params
        (parser ptr))
      (returns void)
      (do
        (if
          (condition
            (ne_ptr
              (param_get parser)
              (const_null)))
          (then
            (do
              (call_void
                free
                (param_get parser))))
          (else
            (do)))
        (return_void)))

; =============================================================================
; Parser accessors
; =============================================================================

; parser_source
;
; Provides parser behavior for source.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.
(fn parser_source
      (params
        (parser ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (param_get parser)))))

; parser_tokens
;
; Provides parser behavior for tokens.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.
(fn parser_tokens
      (params
        (parser ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (ptr_add
              (param_get parser)
              (const_i64 8))))))

; parser_ast
;
; Provides parser behavior for ast.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.
(fn parser_ast
      (params
        (parser ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (ptr_add
              (param_get parser)
              (const_i64 16))))))

; parser_index
;
; Provides parser behavior for index.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   i64 result value.
(fn parser_index
      (params
        (parser ptr))
      (returns i64)
      (do
        (return
          (load_i64
            (ptr_add
              (param_get parser)
              (const_i64 24))))))

; =============================================================================
; Parser mutators
; =============================================================================

; parser_set_index
;
; Provides parser behavior for set index.
;
; Parameters:
;   parser - Parser state pointer.
;
;   index - AST node index or token index.
; Returns:
;   no value.
(fn parser_set_index
      (params
        (parser ptr)
        (index i64))
      (returns void)
      (do
        (store_i64
          (ptr_add
            (param_get parser)
            (const_i64 24))
          (param_get index))
        (return_void)))

; parser_error_code
;
; Provides parser behavior for error code.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   i32 result value.
(fn parser_error_code
      (params
        (parser ptr))
      (returns i32)
      (do
        (return
          (load_i32
            (ptr_add
              (param_get parser)
              (const_i64 32))))))

; parser_set_error_code
;
; Provides parser behavior for set error code.
;
; Parameters:
;   parser - Parser state pointer.
;
;   code - Parser error code.
; Returns:
;   no value.
(fn parser_set_error_code
      (params
        (parser ptr)
        (code i32))
      (returns void)
      (do
        (store_i32
          (ptr_add
            (param_get parser)
            (const_i64 32))
          (param_get code))
        (return_void)))
))
