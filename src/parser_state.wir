; SPDX-License-Identifier: Apache-2.0
; parser_state.wir
;
; Parser state storage.
;
; Responsibilities:
;   - allocate and free parser records
;   - store source, token stream, AST, cursor index, and error code
;   - expose typed field accessors for parser modules
;
; Parser state uses a manual fixed-layout record to keep bootstrapping simple.

(core-module
  (core-version 2)
  (decls

; =============================================================================
; Parser layout constants
; =============================================================================

;
; parser_size
;
; Returns the size in bytes of the parser state record.
; The record stores source, tokens, AST, cursor, error code, and error byte offset.
;
; Returns:
;   parser record size in bytes.
;
(fn parser_size
      (params)
      (returns i64)
      (do
        (return
          (const_i64 48))))

; =============================================================================
; Parser allocation
; =============================================================================

;
; parser_new
;
; Allocates and initializes parser state for one source file.
; The parser borrows source, token, and AST storage owned by the driver.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   source - source buffer pointer.
;   tokens - token stream pointer.
;   ast - AST container pointer.
;
; Returns:
;   parser record size in bytes.
;
(fn parser_new
      (params
        (source ptr)
        (tokens ptr)
        (ast ptr))
      (returns ptr)
      (do
        (let
          parser
          ptr
          (call_ptr
            malloc
            (call_i64 parser_size)))
        (if
          (condition
            (eq_ptr
              (local_get parser)
              (const_null)))
          (then
            (do
              (return
                (const_null))))
          (else
            (do)))
        (store_ptr
          (local_get parser)
          (param_get source))
        (store_ptr
          (ptr_add
            (local_get parser)
            (const_i64 8))
          (param_get tokens))
        (store_ptr
          (ptr_add
            (local_get parser)
            (const_i64 16))
          (param_get ast))
        (store_i64
          (ptr_add
            (local_get parser)
            (const_i64 24))
          (const_i64 0))
        (store_i32
          (ptr_add
            (local_get parser)
            (const_i64 32))
          (const_i32 0))
        (store_i64
          (ptr_add
            (local_get parser)
            (const_i64 40))
          (const_i64 -1))
        (return
          (local_get parser))))

;
; parser_free
;
; Releases the parser state record.
; Borrowed source, tokens, and AST storage are freed by their owners.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   no value.
;
(fn parser_free
      (params
        (parser ptr))
      (returns void)
      (do
        (if
          (condition
            (ne_ptr
              (param_get parser)
              (const_null)))
          (then
            (do
              (call_void
                free
                (param_get parser))))
          (else
            (do)))
        (return_void)))

; =============================================================================
; Parser accessors
; =============================================================================

;
; parser_source
;
; Reads the source pointer from parser state.
; Parser helpers need source bytes for identifier and literal spans.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   source buffer pointer.
;
(fn parser_source
      (params
        (parser ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (param_get parser)))))

;
; parser_tokens
;
; Reads the token stream pointer from parser state.
; Cursor helpers index into this token stream.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   token stream pointer.
;
(fn parser_tokens
      (params
        (parser ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (ptr_add
              (param_get parser)
              (const_i64 8))))))

;
; parser_ast
;
; Reads the AST pointer from parser state.
; Parse routines append nodes through this shared AST.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   AST container pointer.
;
(fn parser_ast
      (params
        (parser ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (ptr_add
              (param_get parser)
              (const_i64 16))))))

;
; parser_index
;
; Reads the current token index from parser state.
; All parser dispatch decisions are relative to this cursor.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   AST container pointer.
;
(fn parser_index
      (params
        (parser ptr))
      (returns i64)
      (do
        (return
          (load_i64
            (ptr_add
              (param_get parser)
              (const_i64 24))))))

; =============================================================================
; Parser mutators
; =============================================================================

;
; parser_set_index
;
; Writes the current token index in parser state.
; Advance and recovery helpers use this single cursor mutator.
;
; Parameters:
;   parser - parser state pointer.
;   index - zero-based node, token, or byte index.
;
; Returns:
;   current token index.
;
(fn parser_set_index
      (params
        (parser ptr)
        (index i64))
      (returns void)
      (do
        (store_i64
          (ptr_add
            (param_get parser)
            (const_i64 24))
          (param_get index))
        (return_void)))

;
; parser_error_code
;
; Reads the parser error code.
; A nonzero code marks a previous syntax failure.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   no value.
;
(fn parser_error_code
      (params
        (parser ptr))
      (returns i32)
      (do
        (return
          (load_i32
            (ptr_add
              (param_get parser)
              (const_i64 32))))))

;
; parser_set_error_code
;
; Writes the parser error code.
; Expectation helpers use this to preserve the low-level failure convention.
;
; Parameters:
;   parser - parser state pointer.
;   code - parser error code.
;
; Returns:
;   current parser error code.
;
(fn parser_set_error_code
      (params
        (parser ptr)
        (code i32))
      (returns void)
      (do
        (store_i32
          (ptr_add
            (param_get parser)
            (const_i64 32))
          (param_get code))
        (call_void
          parser_note_error_site
          (param_get parser))
        (return_void)))

;
; parser_error_site
;
; Returns the recorded source byte offset for the first parse error, or -1.
;
(fn parser_error_site
      (params
        (parser ptr))
      (returns i64)
      (do
        (return
          (load_i64
            (ptr_add
              (param_get parser)
              (const_i64 40))))))

;
; parser_set_error_site
;
; Records the source byte offset associated with a parse error.
;
(fn parser_set_error_site
      (params
        (parser ptr)
        (site i64))
      (returns void)
      (do
        (store_i64
          (ptr_add
            (param_get parser)
            (const_i64 40))
          (param_get site))
        (return_void)))

;
; parser_note_error_site
;
; Captures the current token start offset on the first parse failure only.
;
(fn parser_note_error_site
      (params
        (parser ptr))
      (returns void)
      (do
        (if
          (condition
            (ne_i64
              (call_i64
                parser_error_site
                (param_get parser))
              (const_i64 -1)))
          (then
            (do
              (return_void)))
          (else
            (do)))
        (call_void
          parser_set_error_site
          (param_get parser)
          (call_i64
            parser_current_start
            (param_get parser)))
        (return_void)))
))
