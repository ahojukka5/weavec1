; strings.wir
;
; Growable byte buffer and byte-string helpers.
;
; Responsibilities:
;   - allocate, grow, and free output buffers
;   - append bytes, byte ranges, C strings, and integer text
;   - compare byte slices against string literals
;   - write buffers to files
;
; Buffers use a manual fixed-layout record to keep runtime dependencies small.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Buffer layout constants
; =============================================================================

; buffer_size
;
; Provides growable buffer behavior for size.
;
; Returns:
;   i64 result value.
(fn buffer_size
      (params)
      (returns i64)
      (do
        (return
          (const_i64 24))))

; buffer_initial_capacity
;
; Provides growable buffer behavior for initial capacity.
;
; Returns:
;   i64 result value.
(fn buffer_initial_capacity
      (params)
      (returns i64)
      (do
        (return
          (const_i64 256))))

; =============================================================================
; Buffer field accessors
; =============================================================================

; buffer_data_field
;
; Returns the address of the buffer `data` field.
;
;
; Parameters:
;   buffer - Growable byte buffer pointer.
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.
(fn buffer_data_field
      (params
        (buffer ptr))
      (returns ptr)
      (do
        (return
          (param_get buffer))))

; buffer_length_field
;
; Returns the address of the buffer `length` field.
;
;
; Parameters:
;   buffer - Growable byte buffer pointer.
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.
(fn buffer_length_field
      (params
        (buffer ptr))
      (returns ptr)
      (do
        (return
          (ptr_add
            (param_get buffer)
            (const_i64 8)))))

; buffer_capacity_field
;
; Returns the address of the buffer `capacity` field.
;
;
; Parameters:
;   buffer - Growable byte buffer pointer.
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.
(fn buffer_capacity_field
      (params
        (buffer ptr))
      (returns ptr)
      (do
        (return
          (ptr_add
            (param_get buffer)
            (const_i64 16)))))

; =============================================================================
; Buffer value accessors
; =============================================================================

; buffer_data
;
; Provides growable buffer behavior for data.
;
;
; Parameters:
;   buffer - Growable byte buffer pointer.
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.
(fn buffer_data
      (params
        (buffer ptr))
      (returns ptr)
      (do
        (return
          (load_ptr
            (call_ptr
              buffer_data_field
              (param_get buffer))))))

; buffer_length
;
; Provides growable buffer behavior for length.
;
;
; Parameters:
;   buffer - Growable byte buffer pointer.
; Returns:
;   i64 result value.
(fn buffer_length
      (params
        (buffer ptr))
      (returns i64)
      (do
        (return
          (load_i64
            (call_ptr
              buffer_length_field
              (param_get buffer))))))

; buffer_capacity
;
; Provides growable buffer behavior for capacity.
;
;
; Parameters:
;   buffer - Growable byte buffer pointer.
; Returns:
;   i64 result value.
(fn buffer_capacity
      (params
        (buffer ptr))
      (returns i64)
      (do
        (return
          (load_i64
            (call_ptr
              buffer_capacity_field
              (param_get buffer))))))

; =============================================================================
; Buffer mutators
; =============================================================================

; buffer_set_data
;
; Stores a new value in the buffer `data` field.
;
; Parameters:
;   buffer - Growable byte buffer pointer.
;
;   data - Byte pointer.
; Returns:
;   no value.
(fn buffer_set_data
      (params
        (buffer ptr)
        (data ptr))
      (returns void)
      (do
        (store_ptr
          (call_ptr
            buffer_data_field
            (param_get buffer))
          (param_get data))
        (return_void)))

; buffer_set_length
;
; Stores a new value in the buffer `length` field.
;
; Parameters:
;   buffer - Growable byte buffer pointer.
;
;   length - Byte length.
; Returns:
;   no value.
(fn buffer_set_length
      (params
        (buffer ptr)
        (length i64))
      (returns void)
      (do
        (store_i64
          (call_ptr
            buffer_length_field
            (param_get buffer))
          (param_get length))
        (return_void)))

; buffer_set_capacity
;
; Stores a new value in the buffer `capacity` field.
;
; Parameters:
;   buffer - Growable byte buffer pointer.
;
;   capacity - Allocated capacity.
; Returns:
;   no value.
(fn buffer_set_capacity
      (params
        (buffer ptr)
        (capacity i64))
      (returns void)
      (do
        (store_i64
          (call_ptr
            buffer_capacity_field
            (param_get buffer))
          (param_get capacity))
        (return_void)))

; =============================================================================
; Buffer allocation
; =============================================================================

; buffer_new
;
; Provides growable buffer behavior for new.
;
; Returns:
;   pointer result.
;   null only when allocation or lookup fails.
(fn buffer_new
      (params)
      (returns ptr)
      (do
        (let
          buffer
          ptr
          (call_ptr
            malloc
            (call_i64 buffer_size)))
        (if
          (condition
            (eq_ptr
              (local_get buffer)
              (const_null)))
          (then
            (do
              (return
                (const_null))))
          (else
            (do)))
        (let
          capacity
          i64
          (call_i64 buffer_initial_capacity))
        (let
          data
          ptr
          (call_ptr
            malloc
            (local_get capacity)))
        (if
          (condition
            (eq_ptr
              (local_get data)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get buffer))
              (return
                (const_null))))
          (else
            (do)))
        (store_i8
          (local_get data)
          (const_i32 0))
        (call_void
          buffer_set_data
          (local_get buffer)
          (local_get data))
        (call_void
          buffer_set_length
          (local_get buffer)
          (const_i64 0))
        (call_void
          buffer_set_capacity
          (local_get buffer)
          (local_get capacity))
        (return
          (local_get buffer))))

; buffer_free
;
; Provides growable buffer behavior for free.
;
;
; Parameters:
;   buffer - Growable byte buffer pointer.
; Returns:
;   no value.
(fn buffer_free
      (params
        (buffer ptr))
      (returns void)
      (do
        (if
          (condition
            (eq_ptr
              (param_get buffer)
              (const_null)))
          (then
            (do
              (return_void)))
          (else
            (do)))
        (let
          data
          ptr
          (call_ptr
            buffer_data
            (param_get buffer)))
        (if
          (condition
            (ne_ptr
              (local_get data)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get data))))
          (else
            (do)))
        (call_void
          free
          (param_get buffer))
        (return_void)))

; =============================================================================
; Buffer growth
; =============================================================================

; buffer_reserve
;
; Provides growable buffer behavior for reserve.
;
; Parameters:
;   buffer - Growable byte buffer pointer.
;
;   needed - Required capacity.
; Returns:
;   i32 result value.
(fn buffer_reserve
      (params
        (buffer ptr)
        (needed i64))
      (returns i32)
      (do
        (if
          (condition
            (eq_ptr
              (param_get buffer)
              (const_null)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          capacity
          i64
          (call_i64
            buffer_capacity
            (param_get buffer)))
        (if
          (condition
            (le_i64
              (param_get needed)
              (local_get capacity)))
          (then
            (do
              (return
                (const_i32 0))))
          (else
            (do)))
        (let
          new_capacity
          i64
          (local_get capacity))
        (while
          (condition
            (lt_i64
              (local_get new_capacity)
              (param_get needed)))
          (do
            (set
              new_capacity
              (mul_i64
                (local_get new_capacity)
                (const_i64 2)))))
        (let
          old_data
          ptr
          (call_ptr
            buffer_data
            (param_get buffer)))
        (let
          new_data
          ptr
          (call_ptr
            realloc
            (local_get old_data)
            (local_get new_capacity)))
        (if
          (condition
            (eq_ptr
              (local_get new_data)
              (const_null)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (call_void
          buffer_set_data
          (param_get buffer)
          (local_get new_data))
        (call_void
          buffer_set_capacity
          (param_get buffer)
          (local_get new_capacity))
        (return
          (const_i32 0))))

; =============================================================================
; Buffer append helpers
; =============================================================================

; buffer_append_byte
;
; Appends byte data to a growable buffer.
;
; Parameters:
;   buffer - Growable byte buffer pointer.
;
;   byte - Byte value.
; Returns:
;   i32 result value.
(fn buffer_append_byte
      (params
        (buffer ptr)
        (byte i32))
      (returns i32)
      (do
        (let
          length
          i64
          (call_i64
            buffer_length
            (param_get buffer)))
        (let
          new_length
          i64
          (add_i64
            (local_get length)
            (const_i64 1)))
        (let
          needed
          i64
          (add_i64
            (local_get new_length)
            (const_i64 1)))
        (if
          (condition
            (ne_i32
              (call_i32
                buffer_reserve
                (param_get buffer)
                (local_get needed))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          data
          ptr
          (call_ptr
            buffer_data
            (param_get buffer)))
        (store_i8
          (ptr_add
            (local_get data)
            (local_get length))
          (param_get byte))
        (store_i8
          (ptr_add
            (local_get data)
            (local_get new_length))
          (const_i32 0))
        (call_void
          buffer_set_length
          (param_get buffer)
          (local_get new_length))
        (return
          (const_i32 0))))

; buffer_append_bytes
;
; Appends bytes data to a growable buffer.
;
; Parameters:
;   buffer - Growable byte buffer pointer.
;   src - ptr parameter.
;
;   count - Number of entries.
; Returns:
;   i32 result value.
(fn buffer_append_bytes
      (params
        (buffer ptr)
        (src ptr)
        (count i64))
      (returns i32)
      (do
        (if
          (condition
            (and_bool
              (eq_ptr
                (param_get src)
                (const_null))
              (ne_i64
                (param_get count)
                (const_i64 0))))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          length
          i64
          (call_i64
            buffer_length
            (param_get buffer)))
        (let
          new_length
          i64
          (add_i64
            (local_get length)
            (param_get count)))
        (let
          needed
          i64
          (add_i64
            (local_get new_length)
            (const_i64 1)))
        (if
          (condition
            (ne_i32
              (call_i32
                buffer_reserve
                (param_get buffer)
                (local_get needed))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          data
          ptr
          (call_ptr
            buffer_data
            (param_get buffer)))
        (if
          (condition
            (ne_i64
              (param_get count)
              (const_i64 0)))
          (then
            (do
              (call_ptr
                memcpy
                (ptr_add
                  (local_get data)
                  (local_get length))
                (param_get src)
                (param_get count))))
          (else
            (do)))
        (store_i8
          (ptr_add
            (local_get data)
            (local_get new_length))
          (const_i32 0))
        (call_void
          buffer_set_length
          (param_get buffer)
          (local_get new_length))
        (return
          (const_i32 0))))

; buffer_append_cstr
;
; Appends cstr data to a growable buffer.
;
; Parameters:
;   buffer - Growable byte buffer pointer.
;
;   text - Text pointer.
; Returns:
;   i32 result value.
(fn buffer_append_cstr
      (params
        (buffer ptr)
        (text ptr))
      (returns i32)
      (do
        (if
          (condition
            (eq_ptr
              (param_get text)
              (const_null)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          length
          i64
          (call_i64
            strlen
            (param_get text)))
        (return
          (call_i32
            buffer_append_bytes
            (param_get buffer)
            (param_get text)
            (local_get length)))))

; buffer_append_i32
;
; Appends i32 data to a growable buffer.
;
; Parameters:
;   buffer - Growable byte buffer pointer.
;
;   value - Value to store or emit.
; Returns:
;   i32 result value.
(fn buffer_append_i32
      (params
        (buffer ptr)
        (value i32))
      (returns i32)
      (do
        (if
          (condition
            (lt_i32
              (param_get value)
              (const_i32 0)))
          (then
            (do
              (if
                (condition
                  (ne_i32
                    (call_i32
                      buffer_append_byte
                      (param_get buffer)
                      (const_i32 45))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i32 1))))
                (else
                  (do)))
              (return
                (call_i32
                  buffer_append_i32
                  (param_get buffer)
                  (mul_i32
                    (param_get value)
                    (const_i32 -1))))))
          (else
            (do)))
        (if
          (condition
            (ge_i32
              (param_get value)
              (const_i32 10)))
          (then
            (do
              (let
                prefix
                i32
                (div_i32
                  (param_get value)
                  (const_i32 10)))
              (let
                digit
                i32
                (mod_i32
                  (param_get value)
                  (const_i32 10)))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      buffer_append_i32
                      (param_get buffer)
                      (local_get prefix))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i32 1))))
                (else
                  (do)))
              (return
                (call_i32
                  buffer_append_byte
                  (param_get buffer)
                  (add_i32
                    (local_get digit)
                    (const_i32 48))))))
          (else
            (do
              (return
                (call_i32
                  buffer_append_byte
                  (param_get buffer)
                  (add_i32
                    (param_get value)
                    (const_i32 48)))))))))

; =============================================================================
; Byte comparison
; =============================================================================

; bytes_equal
;
; Implements bytes equal for the weavec1 bootstrap compiler.
;
; Parameters:
;   a - First AST payload field.
;   a_len - i64 parameter.
;   b - Second AST payload field.
;
;   b_len - Second byte string length.
; Returns:
;   true when the predicate matches.
;   false otherwise.
(fn bytes_equal
      (params
        (a ptr)
        (a_len i64)
        (b ptr)
        (b_len i64))
      (returns bool)
      (do
        (if
          (condition
            (ne_i64
              (param_get a_len)
              (param_get b_len)))
          (then
            (do
              (return
                (const_bool false))))
          (else
            (do)))
        (if
          (condition
            (and_bool
              (eq_ptr
                (param_get a)
                (const_null))
              (eq_ptr
                (param_get b)
                (const_null))))
          (then
            (do
              (return
                (const_bool true))))
          (else
            (do)))
        (if
          (condition
            (or_bool
              (eq_ptr
                (param_get a)
                (const_null))
              (eq_ptr
                (param_get b)
                (const_null))))
          (then
            (do
              (return
                (const_bool false))))
          (else
            (do)))
        (return
          (eq_i32
            (call_i32
              strncmp
              (param_get a)
              (param_get b)
              (param_get a_len))
            (const_i32 0)))))

; =============================================================================
; Buffer file output
; =============================================================================

; buffer_write_file
;
; Provides growable buffer behavior for write file.
;
; Parameters:
;   path - Path string pointer.
;
;   buffer - Growable byte buffer pointer.
; Returns:
;   i32 result value.
(fn buffer_write_file
      (params
        (path ptr)
        (buffer ptr))
      (returns i32)
      (do
        (if
          (condition
            (eq_ptr
              (param_get buffer)
              (const_null)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (return
          (call_i32
            write_file
            (param_get path)
            (call_ptr
              buffer_data
              (param_get buffer))
            (call_i64
              buffer_length
              (param_get buffer))))))))
