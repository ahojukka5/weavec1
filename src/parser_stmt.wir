                    (param_get parser))
                  (local_get block_first)
                  (local_get block_last)
                  (local_get block_count)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get head_kind)
              (call_i32 token_debug)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (call_void
                parser_advance
                (param_get parser))
              (if
                (condition
