; parser_stmt.wir
;
; WIR statement and list-expression parsing.
;
; Responsibilities:
;   - parse statement forms such as return, let, set, if, while, store, and do
;   - parse call-like list expressions used inside statements and expressions
;   - append statement and expression nodes to AST storage
;
; The parser is intentionally explicit: each recognized form is matched by name
; rather than hidden behind a compact dispatch table.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Statement parsing
; =============================================================================

;
; parser_parse_stmt
;
; Parses one statement form and appends its AST representation.
; The dispatcher recognizes WIR statement names explicitly so each supported form is visible.
;
; Notes:
;   The long dispatch chain is intentional in this bootstrap stage; it keeps
;   syntax support easy to audit without an extra table abstraction.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   AST node index on success.
;   -1 on parse failure.
;
(fn parser_parse_stmt
      (params
        (parser ptr))
      (returns i64)
      (do
        (if
          (condition
            (ne_i32
              (call_i32
                parser_current_kind
                (param_get parser))
              (call_i32 token_lparen)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (let
          tokens
          ptr
          (call_ptr
            parser_tokens
            (param_get parser)))
        (let
          index
          i64
          (call_i64
            parser_index
            (param_get parser)))
        (let
          head_kind
          i32
          (call_i32 token_eof))
        (if
          (condition
            (lt_i64
              (add_i64
                (local_get index)
                (const_i64 1))
              (call_i64
                tokens_count
                (local_get tokens))))
          (then
            (do
              (set
                head_kind
                (call_i32
                  token_kind_at
                  (local_get tokens)
                  (add_i64
                    (local_get index)
                    (const_i64 1))))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get head_kind)
              (call_i32 token_return_void)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (call_void
                parser_advance
                (param_get parser))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_expect
                      (param_get parser)
                      (call_i32 token_rparen))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (return
                (call_i64
                  ast_make_return_void
                  (call_ptr
                    parser_ast
                    (param_get parser))))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get head_kind)
              (call_i32 token_return)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (call_void
                parser_advance
                (param_get parser))
              (let
                expr
                i64
                (call_i64
                  parser_parse_expression
                  (param_get parser)))
              (if
