                (const_i64 1)))))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_rparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (return
          (call_i64
            ast_make_call
            (call_ptr
              parser_ast
              (param_get parser))
            (local_get op_id)
            (local_get arg_last)
            (local_get arg_count)
            (local_get op_start)
            (local_get op_length)))))
))
