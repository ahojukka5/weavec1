                    (else
                      (do)))
                  (set
                    block_last
                    (local_get block_stmt))
                  (set
                    block_count
                    (add_i64
                      (local_get block_count)
                      (const_i64 1)))))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_expect
                      (param_get parser)
                      (call_i32 token_rparen))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (return
                (call_i64
                  ast_make_block
                  (call_ptr
