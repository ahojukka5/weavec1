                  (local_get let_name_start)
                  (local_get let_name_len)))))
          (else
            (do)))
        (if
          (condition
            (eq_i32
              (local_get head_kind)
              (call_i32 token_set)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (call_void
                parser_advance
                (param_get parser))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_current_kind
                      (param_get parser))
                    (call_i32 token_ident)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (let
                set_name_start
                i64
                (call_i64
                  parser_current_start
                  (param_get parser)))
              (let
                set_name_len
                i64
                (call_i64
                  parser_current_length
                  (param_get parser)))
              (call_void
                parser_advance
                (param_get parser))
              (let
                set_expr
                i64
                (call_i64
                  parser_parse_expression
                  (param_get parser)))
              (if
                (condition
