                (param_get parser))
              (call_void
                parser_advance
                (param_get parser))
              (let
                block_first
                i64
                (call_i64
                  ast_count
                  (call_ptr
                    parser_ast
                    (param_get parser))))
              (let
                block_last
                i64
                (const_i64 -1))
              (let
                block_count
                i64
                (const_i64 0))
              (while
                (condition
                  (not_bool
                    (call_bool
                      parser_match
                      (param_get parser)
                      (call_i32 token_rparen))))
                (do
