; =============================================================================
; List expression parsing
; =============================================================================

;
; parser_parse_list_expression
;
; Parses a parenthesized expression form whose operator is an identifier.
; Call, arithmetic, comparison, logical, load, and pointer operations share this path.
;
; Invariants:
;   - parser points at the opening parenthesis of the list expression.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   AST node index on success.
;   -1 on parse failure.
;
(fn parser_parse_list_expression
      (params
        (parser ptr))
      (returns i64)
      (do
        (if
          (condition
            (ne_i32
              (call_i32
                parser_expect
                (param_get parser)
                (call_i32 token_lparen))
              (const_i32 0)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                parser_current_kind
                (param_get parser))
              (call_i32 token_ident)))
          (then
            (do
              (return
                (const_i64 -1))))
          (else
            (do)))
        (let
          op_start
          i64
          (call_i64
            parser_ident_start
            (param_get parser)))
        (let
          op_length
          i64
          (call_i64
            parser_ident_length
            (param_get parser)))
        (let
          source
          ptr
          (call_ptr
            parser_source
            (param_get parser)))
        (let
          op_text
          ptr
          (ptr_add
            (call_ptr
              source_data
              (local_get source))
            (local_get op_start)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get op_text)
              (local_get op_length)
              (const_string_ptr "const_i32")
              (const_i64 9)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_current_kind
                      (param_get parser))
                    (call_i32 token_int)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (let
                value
                i32
                (call_i32
                  token_value_at
                  (call_ptr
                    parser_tokens
                    (param_get parser))
                  (call_i64
                    parser_index
                    (param_get parser))))
              (call_void
                parser_advance
                (param_get parser))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_expect
                      (param_get parser)
                      (call_i32 token_rparen))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (return
                (call_i64
                  ast_make_const_i32
                  (call_ptr
                    parser_ast
                    (param_get parser))
                  (local_get value)))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get op_text)
              (local_get op_length)
              (const_string_ptr "const_i64")
              (const_i64 9)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_current_kind
                      (param_get parser))
                    (call_i32 token_int)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (let
                value64
                i32
                (call_i32
                  token_value_at
                  (call_ptr
                    parser_tokens
                    (param_get parser))
                  (call_i64
                    parser_index
                    (param_get parser))))
              (call_void
                parser_advance
                (param_get parser))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_expect
                      (param_get parser)
                      (call_i32 token_rparen))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (return
                (call_i64
                  ast_make_const_i64
                  (call_ptr
                    parser_ast
                    (param_get parser))
                  (cast_i32_to_i64
                    (local_get value64))))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get op_text)
              (local_get op_length)
              (const_string_ptr "const_bool")
              (const_i64 10)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_current_kind
                      (param_get parser))
                    (call_i32 token_ident)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (let
                bool_value
                i32
                (const_i32 0))
              (if
                (condition
                  (call_bool
                    bytes_equal
                    (local_get op_text)
                    (const_i64 0)
                    (local_get op_text)
                    (const_i64 0)))
                (then
                  (do
                    (set
                      bool_value
                      (const_i32 0))))
                (else
                  (do)))
              (if
                (condition
                  (call_bool
                    bytes_equal
                    (ptr_add
                      (call_ptr
                        source_data
                        (local_get source))
                      (call_i64
                        parser_current_start
                        (param_get parser)))
                    (call_i64
                      parser_current_length
                      (param_get parser))
                    (const_string_ptr "true")
                    (const_i64 4)))
                (then
                  (do
                    (set
                      bool_value
                      (const_i32 1))))
                (else
                  (do)))
              (call_void
                parser_advance
                (param_get parser))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_expect
                      (param_get parser)
                      (call_i32 token_rparen))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (return
                (call_i64
                  ast_make_const_bool
                  (call_ptr
                    parser_ast
                    (param_get parser))
                  (local_get bool_value)))))
          (else
            (do)))
        (if
          (condition
            (call_bool
              bytes_equal
              (local_get op_text)
              (local_get op_length)
              (const_string_ptr "const_null")
              (const_i64 10)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_expect
                      (param_get parser)
                      (call_i32 token_rparen))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (return
                (call_i64
                  ast_make_const_null
                  (call_ptr
                    parser_ast
                    (param_get parser))))))
          (else
            (do)))
        (if
          (condition
            (or_bool
