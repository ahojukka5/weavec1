                    (call_i32
                      parser_expect
                      (param_get parser)
                      (call_i32 token_rparen))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_expect
                      (param_get parser)
                      (call_i32 token_lparen))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
                  (do)))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_expect
                      (param_get parser)
                      (call_i32 token_ident))
                    (const_i32 0)))
                (then
                  (do
                    (return
                      (const_i64 -1))))
                (else
