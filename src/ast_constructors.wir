; ast_constructors.wir
; AST node constructor functions.
; Each ast_make_* function creates a new typed node in the AST,
; filling in the appropriate fields and returning the node index.

(core-module
  (core-version 1)
  (decls
    (fn
      ast_make_program
      (params
        (ast ptr)
        (first i64)
        (last i64)
        (count i64))
      (returns i64)
      (do
        (return
          (call_i64
            ast_push
            (param_get ast)
            (call_i32 ast_program)
            (const_i64 0)
            (param_get first)
            (param_get last)
            (param_get count)
            (const_i64 0)
            (const_i64 0)
            (const_i64 0)))))
    (fn
      ast_make_extern
      (params
        (ast ptr)
        (return_type i32)
        (param_first i64)
        (param_count i64)
        (name_start i64)
        (name_len i64))
      (returns i64)
      (do
        (return
          (call_i64
            ast_push
            (param_get ast)
            (call_i32 ast_extern)
            (cast_i32_to_i64
              (param_get return_type))
            (param_get param_first)
            (param_get param_count)
            (const_i64 0)
            (const_i64 0)
            (param_get name_start)
            (param_get name_len)))))
