; SPDX-License-Identifier: Apache-2.0
; ast_constructors.wir
;
; AST node constructor helpers.
;
; Responsibilities:
;   - append typed AST nodes to the shared storage array
;   - encode each node kind's field layout in one place
;   - preserve parser readability by hiding raw ast_push calls
;
; Constructors return node indices. They do not validate higher-level syntax.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; AST constructors
; =============================================================================

;
; ast_make_program
;
; Creates and appends an AST `program` node.
; The constructor documents the node field layout used by later compiler stages.
;
; Notes:
;   The field order here is part of the AST contract consumed by emitters.
;
; Parameters:
;   ast - AST container pointer.
;   first - first node index in a contiguous child range.
;   last - last node index in a contiguous child range.
;   count - number of nodes, bytes, or entries.
;
; Returns:
;   new AST node index on success.
;   -1 on allocation failure.
;
(fn ast_make_program
      (params
        (ast ptr)
        (first i64)
        (last i64)
        (count i64))
      (returns i64)
      (do
        (return
          (call_i64
            ast_push
            (param_get ast)
            (call_i32 ast_program)
            (const_i64 0)
            (param_get first)
            (param_get last)
            (param_get count)
            (const_i64 0)
            (const_i64 0)
            (const_i64 0)))))

;
; ast_make_extern
;
; Creates and appends an AST `extern` node.
; The constructor documents the node field layout used by later compiler stages.
;
; Notes:
;   The field order here is part of the AST contract consumed by emitters.
;
; Parameters:
;   ast - AST container pointer.
;   return_type - function return type id.
;   param_first - first parameter node index.
;   param_count - number of parameter nodes or parameter bindings.
;   name_start - source byte offset of the name.
;   name_len - name byte length.
;
; Returns:
;   new AST node index on success.
;   -1 on allocation failure.
;
(fn ast_make_extern
      (params
        (ast ptr)
        (return_type i32)
        (param_first i64)
        (param_count i64)
        (name_start i64)
        (name_len i64))
      (returns i64)
      (do
        (return
          (call_i64
            ast_push
            (param_get ast)
            (call_i32 ast_extern)
            (cast_i32_to_i64
              (param_get return_type))
            (param_get param_first)
            (param_get param_count)
            (const_i64 0)
            (const_i64 0)
            (param_get name_start)
            (param_get name_len)))))

