; ast_constructors.wir
;
; AST node constructor helpers.
;
; Responsibilities:
;   - append typed AST nodes to the shared storage array
;   - encode each node kind's field layout in one place
;   - preserve parser readability by hiding raw ast_push calls
;
; Constructors return node indices. They do not validate higher-level syntax.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; AST constructors
; =============================================================================

; ast_make_program
;
; Creates and appends an AST program node using the shared node layout.
;
; Notes:
;   This constructor centralizes field placement so parser code does not write
;   raw AST storage slots directly.
;
; Parameters:
;   ast - AST container pointer.
;   first - First node index in a contiguous range.
;   last - Last node index in a contiguous range.
;
;   count - Number of entries.
; Returns:
;   AST node index on success.
;   -1 on parse or allocation failure.
(fn ast_make_program
      (params
        (ast ptr)
        (first i64)
        (last i64)
        (count i64))
      (returns i64)
      (do
        (return
          (call_i64
            ast_push
            (param_get ast)
            (call_i32 ast_program)
            (const_i64 0)
            (param_get first)
            (param_get last)
            (param_get count)
            (const_i64 0)
            (const_i64 0)
            (const_i64 0)))))

; ast_make_extern
;
; Creates and appends an AST extern node using the shared node layout.
;
; Notes:
;   This constructor centralizes field placement so parser code does not write
;   raw AST storage slots directly.
;
; Parameters:
;   ast - AST container pointer.
;   return_type - Function return type id.
;   param_first - i64 parameter.
;   param_count - Number of parameter bindings.
;   name_start - i64 parameter.
;
;   name_len - Name byte length.
; Returns:
;   AST node index on success.
;   -1 on parse or allocation failure.
(fn ast_make_extern
      (params
        (ast ptr)
        (return_type i32)
        (param_first i64)
        (param_count i64)
        (name_start i64)
        (name_len i64))
      (returns i64)
      (do
        (return
          (call_i64
            ast_push
            (param_get ast)
            (call_i32 ast_extern)
            (cast_i32_to_i64
              (param_get return_type))
            (param_get param_first)
            (param_get param_count)
            (const_i64 0)
            (const_i64 0)
            (param_get name_start)
            (param_get name_len)))))

