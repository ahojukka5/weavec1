; ast_storage.wir
;
; AST node storage: allocation, growth, field layout, and node insertion.
;
; Responsibilities:
;   - define the AST container memory layout
;   - define the per-node memory layout
;   - allocate and free AST instances
;   - grow capacity on demand
;   - append new nodes and return their index
;
; Memory layout:
;
;   AST container (24 bytes):
;     offset  0: ptr   - pointer to node array
;     offset  8: i64   - node count (used)
;     offset 16: i64   - node capacity (allocated)
;
;   Node (64 bytes):
;     offset  0: i32   - kind (node type constant)
;     offset  8: i64   - op_type (operator or type id)
;     offset 16: i64   - a (first child or value field)
;     offset 24: i64   - b (second child or range end)
;     offset 32: i64   - c (third child or count field)
;     offset 40: i64   - d (fourth child, rarely used)
;     offset 48: i64   - text_start (source byte offset)
;     offset 56: i64   - text_len (source byte length)
;
; Design note:
;   The node layout is intentionally fixed-size and uniform.
;   Not every field is used by every node kind; unused fields are
;   always stored as zero. This simplifies allocation and traversal
;   at the cost of a fixed 64-byte footprint per node.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Layout constants
; =============================================================================

; ast_node_size
;
; Returns the size in bytes of a single AST node.
; All nodes use a fixed 64-byte layout regardless of kind.
;
; Returns:
;   64.

(fn
  ast_node_size
  (params)
  (returns i64)
  (do
    (return
      (const_i64 64))))

; ast_size
;
; Returns the size in bytes of the AST container header.
; The container holds a node pointer, a count, and a capacity.
;
; Returns:
;   24.

(fn
  ast_size
  (params)
  (returns i64)
  (do
    (return
      (const_i64 24))))

; ast_initial_capacity
;
; Returns the initial node capacity used when allocating a new AST.
; Chosen to avoid early reallocation for typical compilation units.
;
; Returns:
;   512.

(fn
  ast_initial_capacity
  (params)
  (returns i64)
  (do
    (return
      (const_i64 512))))

; =============================================================================
; AST container field address accessors
; =============================================================================

; ast_nodes_field
;
; Returns a pointer to the nodes field of the AST container.
; The nodes field holds a pointer to the node array.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   pointer to the nodes field (offset 0).

(fn
  ast_nodes_field
  (params
    (ast ptr))
  (returns ptr)
  (do
    (return
      (param_get ast))))

; ast_count_field
;
; Returns a pointer to the count field of the AST container.
; The count is the number of nodes currently stored.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   pointer to the count field (offset 8).

(fn
  ast_count_field
  (params
    (ast ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get ast)
        (const_i64 8)))))

; ast_capacity_field
;
; Returns a pointer to the capacity field of the AST container.
; The capacity is the total number of nodes that can be stored without realloc.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   pointer to the capacity field (offset 16).

(fn
  ast_capacity_field
  (params
    (ast ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get ast)
        (const_i64 16)))))

; =============================================================================
; AST container value accessors
; =============================================================================

; ast_nodes
;
; Returns the pointer to the node array stored in the AST container.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   pointer to the node array.

(fn
  ast_nodes
  (params
    (ast ptr))
  (returns ptr)
  (do
    (return
      (load_ptr
        (call_ptr
          ast_nodes_field
          (param_get ast))))))

; ast_count
;
; Returns the number of nodes currently stored in the AST.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   node count as i64.

(fn
  ast_count
  (params
    (ast ptr))
  (returns i64)
  (do
    (return
      (load_i64
        (call_ptr
          ast_count_field
          (param_get ast))))))

; ast_capacity
;
; Returns the allocated node capacity of the AST.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   capacity as i64.

(fn
  ast_capacity
  (params
    (ast ptr))
  (returns i64)
  (do
    (return
      (load_i64
        (call_ptr
          ast_capacity_field
          (param_get ast))))))

; =============================================================================
; AST container field setters
; =============================================================================

; ast_set_nodes
;
; Sets the node array pointer in the AST container.
; Used during initial allocation and reallocation.
;
; Parameters:
;   ast   - AST container pointer.
;   nodes - new node array pointer.
;
; Returns:
;   void.

(fn
  ast_set_nodes
  (params
    (ast ptr)
    (nodes ptr))
  (returns void)
  (do
    (store_ptr
      (call_ptr
        ast_nodes_field
        (param_get ast))
      (param_get nodes))
    (return_void)))

; ast_set_count
;
; Sets the node count in the AST container.
; Called after appending a new node to update the used count.
;
; Parameters:
;   ast   - AST container pointer.
;   count - new node count.
;
; Returns:
;   void.

(fn
  ast_set_count
  (params
    (ast ptr)
    (count i64))
  (returns void)
  (do
    (store_i64
      (call_ptr
        ast_count_field
        (param_get ast))
      (param_get count))
    (return_void)))

; ast_set_capacity
;
; Sets the capacity field in the AST container.
; Called after a successful realloc to record the new capacity.
;
; Parameters:
;   ast      - AST container pointer.
;   capacity - new capacity value.
;
; Returns:
;   void.

(fn
  ast_set_capacity
  (params
    (ast ptr)
    (capacity i64))
  (returns void)
  (do
    (store_i64
      (call_ptr
        ast_capacity_field
        (param_get ast))
      (param_get capacity))
    (return_void)))

; =============================================================================
; Node memory layout: field address accessors
; =============================================================================

; ast_node_at
;
; Returns a pointer to the node at the given index in the node array.
; Index is zero-based. No bounds checking is performed.
;
; Parameters:
;   ast   - AST container pointer.
;   index - zero-based node index.
;
; Returns:
;   pointer to the node at the given index.
;
; Invariants:
;   - index must be in [0, ast_count(ast)).

(fn
  ast_node_at
  (params
    (ast ptr)
    (index i64))
  (returns ptr)
  (do
    (return
      (ptr_add
        (call_ptr
          ast_nodes
          (param_get ast))
        (mul_i64
          (param_get index)
          (call_i64 ast_node_size))))))

; node_kind_field
;
; Returns a pointer to the kind field of a node.
; The kind field holds the AST node kind constant (i32).
;
; Parameters:
;   node - pointer to a node in the node array.
;
; Returns:
;   pointer to the kind field (offset 0 within node).

(fn
  node_kind_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (param_get node))))

; node_op_type_field
;
; Returns a pointer to the op_type field of a node.
; The op_type field holds either an operator id or a type id (i64).
;
; Parameters:
;   node - pointer to a node.
;
; Returns:
;   pointer to the op_type field (offset 8 within node).

(fn
  node_op_type_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 8)))))

; node_a_field
;
; Returns a pointer to the 'a' field of a node.
; 'a' is the first child index or primary value, depending on node kind.
;
; Parameters:
;   node - pointer to a node.
;
; Returns:
;   pointer to field a (offset 16 within node).

(fn
  node_a_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 16)))))

; node_b_field
;
; Returns a pointer to the 'b' field of a node.
; 'b' is the second child index or a range bound, depending on node kind.
;
; Parameters:
;   node - pointer to a node.
;
; Returns:
;   pointer to field b (offset 24 within node).

(fn
  node_b_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 24)))))

; node_c_field
;
; Returns a pointer to the 'c' field of a node.
; 'c' is the third child index or a count, depending on node kind.
;
; Parameters:
;   node - pointer to a node.
;
; Returns:
;   pointer to field c (offset 32 within node).

(fn
  node_c_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 32)))))

; node_d_field
;
; Returns a pointer to the 'd' field of a node.
; 'd' is the fourth child field; rarely used.
;
; Parameters:
;   node - pointer to a node.
;
; Returns:
;   pointer to field d (offset 40 within node).

(fn
  node_d_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 40)))))

; node_text_start_field
;
; Returns a pointer to the text_start field of a node.
; text_start holds the byte offset of the associated source text span.
;
; Parameters:
;   node - pointer to a node.
;
; Returns:
;   pointer to the text_start field (offset 48 within node).

(fn
  node_text_start_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 48)))))

; node_text_len_field
;
; Returns a pointer to the text_len field of a node.
; text_len holds the byte length of the associated source text span.
;
; Parameters:
;   node - pointer to a node.
;
; Returns:
;   pointer to the text_len field (offset 56 within node).

(fn
  node_text_len_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 56)))))

; =============================================================================
; AST container lifecycle
; =============================================================================

; ast_new
;
; Allocates and initializes a new AST container.
; Allocates the container header and an initial node array.
;
; Returns:
;   pointer to the new AST on success.
;   null on allocation failure.
;
; Notes:
;   The initial capacity is ast_initial_capacity() nodes.
;   Both the header and node array are heap-allocated separately.

(fn
  ast_new
  (params)
  (returns ptr)
  (do
    (let
      ast
      ptr
      (call_ptr
        malloc
        (call_i64 ast_size)))
    (if
      (condition
        (eq_ptr
          (local_get ast)
          (const_null)))
      (then
        (do
          (return
            (const_null))))
      (else
        (do)))
    (let
      capacity
      i64
      (call_i64 ast_initial_capacity))
    (let
      nodes
      ptr
      (call_ptr
        malloc
        (mul_i64
          (local_get capacity)
          (call_i64 ast_node_size))))
    (if
      (condition
        (eq_ptr
          (local_get nodes)
          (const_null)))
      (then
        (do
          (call_void
            free
            (local_get ast))
          (return
            (const_null))))
      (else
        (do)))
    (call_void
      ast_set_nodes
      (local_get ast)
      (local_get nodes))
    (call_void
      ast_set_count
      (local_get ast)
      (const_i64 0))
    (call_void
      ast_set_capacity
      (local_get ast)
      (local_get capacity))
    (return
      (local_get ast))))

; ast_free
;
; Frees an AST container and its node array.
; Safe to call with a null pointer (no-op).
;
; Parameters:
;   ast - AST container pointer, or null.
;
; Returns:
;   void.

(fn
  ast_free
  (params
    (ast ptr))
  (returns void)
  (do
    (if
      (condition
        (eq_ptr
          (param_get ast)
          (const_null)))
      (then
        (do
          (return_void)))
      (else
        (do)))
    (let
      nodes
      ptr
      (call_ptr
        ast_nodes
        (param_get ast)))
    (if
      (condition
        (ne_ptr
          (local_get nodes)
          (const_null)))
      (then
        (do
          (call_void
            free
            (local_get nodes))))
      (else
        (do)))
    (call_void
      free
      (param_get ast))
    (return_void)))

; =============================================================================
; Capacity management
; =============================================================================

; ast_reserve
;
; Ensures the AST has capacity for at least 'needed' nodes.
; If the current capacity is sufficient, returns immediately.
; Otherwise doubles capacity until the requirement is met.
;
; Parameters:
;   ast    - AST container pointer.
;   needed - minimum required node count.
;
; Returns:
;   0 on success (capacity is sufficient or was grown).
;   1 on reallocation failure.
;
; Notes:
;   Capacity is doubled on each growth step, not grown by exactly 'needed'.
;   This amortizes reallocation cost over many insertions.

(fn
  ast_reserve
  (params
    (ast ptr)
    (needed i64))
  (returns i32)
  (do
    (let
      capacity
      i64
      (call_i64
        ast_capacity
        (param_get ast)))
    (if
      (condition
        (le_i64
          (param_get needed)
          (local_get capacity)))
      (then
        (do
          (return
            (const_i32 0))))
      (else
        (do)))
    (let
      new_capacity
      i64
      (local_get capacity))
    (while
      (condition
        (lt_i64
          (local_get new_capacity)
          (param_get needed)))
      (do
        (set
          new_capacity
          (mul_i64
            (local_get new_capacity)
            (const_i64 2)))))
    (let
      new_nodes
      ptr
      (call_ptr
        realloc
        (call_ptr
          ast_nodes
          (param_get ast))
        (mul_i64
          (local_get new_capacity)
          (call_i64 ast_node_size))))
    (if
      (condition
        (eq_ptr
          (local_get new_nodes)
          (const_null)))
      (then
        (do
          (return
            (const_i32 1))))
      (else
        (do)))
    (call_void
      ast_set_nodes
      (param_get ast)
      (local_get new_nodes))
    (call_void
      ast_set_capacity
      (param_get ast)
      (local_get new_capacity))
    (return
      (const_i32 0))))

; =============================================================================
; Node insertion
; =============================================================================

; ast_push
;
; Appends a new node to the AST and returns its index.
; Grows the node array if necessary using ast_reserve.
;
; Parameters:
;   ast        - AST container pointer.
;   kind       - node kind constant.
;   op_or_type - operator or type id (stored in op_type field).
;   a          - first child index or value.
;   b          - second child index or range end.
;   c          - third child index or count.
;   d          - fourth child index (rarely used).
;   text_start - source byte offset for this node's text span.
;   text_len   - source byte length for this node's text span.
;
; Returns:
;   zero-based index of the new node on success.
;   -1 on allocation failure.
;
; Notes:
;   The returned index is stable for the lifetime of the AST.
;   It is used as a reference to this node throughout the compiler.

(fn
  ast_push
  (params
    (ast ptr)
    (kind i32)
    (op_or_type i64)
    (a i64)
    (b i64)
    (c i64)
    (d i64)
    (text_start i64)
    (text_len i64))
  (returns i64)
  (do
    (let
      count
      i64
      (call_i64
        ast_count
        (param_get ast)))
    (let
      needed
      i64
      (add_i64
        (local_get count)
        (const_i64 1)))
    (if
      (condition
        (ne_i32
          (call_i32
            ast_reserve
            (param_get ast)
            (local_get needed))
          (const_i32 0)))
      (then
        (do
          (return
            (const_i64 -1))))
      (else
        (do)))
    (let
      node
      ptr
      (call_ptr
        ast_node_at
        (param_get ast)
        (local_get count)))
    (store_i32
      (call_ptr
        node_kind_field
        (local_get node))
      (param_get kind))
    (store_i64
      (call_ptr
        node_op_type_field
        (local_get node))
      (param_get op_or_type))
    (store_i64
      (call_ptr
        node_a_field
        (local_get node))
      (param_get a))
    (store_i64
      (call_ptr
        node_b_field
        (local_get node))
      (param_get b))
    (store_i64
      (call_ptr
        node_c_field
        (local_get node))
      (param_get c))
    (store_i64
      (call_ptr
        node_d_field
        (local_get node))
      (param_get d))
    (store_i64
      (call_ptr
        node_text_start_field
        (local_get node))
      (param_get text_start))
    (store_i64
      (call_ptr
        node_text_len_field
        (local_get node))
      (param_get text_len))
    (call_void
      ast_set_count
      (param_get ast)
      (local_get needed))
    (return
      (local_get count))))
))
