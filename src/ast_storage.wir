; ast_storage.wir
;
; AST node storage: allocation, growth, field layout, and node insertion.
;
; Responsibilities:
;   - define the AST container memory layout
;   - define the per-node memory layout
;   - allocate and free AST instances
;   - grow capacity on demand
;   - append new nodes and return their index
;
; Memory layout:
;
;   AST container (24 bytes):
;     offset  0: ptr   - pointer to node array
;     offset  8: i64   - node count (used)
;     offset 16: i64   - node capacity (allocated)
;
;   Node (64 bytes):
;     offset  0: i32   - kind (node type constant)
;     offset  8: i64   - op_type (operator or type id)
;     offset 16: i64   - a (first child or value field)
;     offset 24: i64   - b (second child or range end)
;     offset 32: i64   - c (third child or count field)
;     offset 40: i64   - d (fourth child, rarely used)
;     offset 48: i64   - text_start (source byte offset)
;     offset 56: i64   - text_len (source byte length)
;
; Design note:
;   The node layout is intentionally fixed-size and uniform.
;   Not every field is used by every node kind; unused fields are
;   always stored as zero. This simplifies allocation and traversal
;   at the cost of a fixed 64-byte footprint per node.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Layout constants
; =============================================================================

;
; ast_node_size
;
; Returns the size in bytes of one AST node.
; AST nodes use one fixed-width record shape.
;
; Returns:
;   node size in bytes.
;
(fn ast_node_size
  (params)
  (returns i64)
  (do
    (return
      (const_i64 64))))

;
; ast_size
;
; Returns the size in bytes of the AST container header.
; The header stores the node pointer, count, and capacity.
;
; Returns:
;   container header size in bytes.
;
(fn ast_size
  (params)
  (returns i64)
  (do
    (return
      (const_i64 24))))

;
; ast_initial_capacity
;
; Returns the initial node capacity for a new AST.
; The bootstrap compiler starts with enough room for small modules.
;
; Returns:
;   initial node capacity.
;
(fn ast_initial_capacity
  (params)
  (returns i64)
  (do
    (return
      (const_i64 512))))

; =============================================================================
; AST container field address accessors
; =============================================================================

;
; ast_nodes_field
;
; Returns the address of the AST container `nodes` field.
; Field helpers centralize byte offsets for the manual storage layout.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   pointer to the `nodes` field.
;
(fn ast_nodes_field
  (params
    (ast ptr))
  (returns ptr)
  (do
    (return
      (param_get ast))))

;
; ast_count_field
;
; Returns the address of the AST container `count` field.
; Field helpers centralize byte offsets for the manual storage layout.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   pointer to the `count` field.
;
(fn ast_count_field
  (params
    (ast ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get ast)
        (const_i64 8)))))

;
; ast_capacity_field
;
; Returns the address of the AST container `capacity` field.
; Field helpers centralize byte offsets for the manual storage layout.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   pointer to the `capacity` field.
;
(fn ast_capacity_field
  (params
    (ast ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get ast)
        (const_i64 16)))))

; =============================================================================
; AST container value accessors
; =============================================================================

;
; ast_nodes
;
; Reads the node-array pointer from an AST container.
; Callers use this before computing per-node addresses.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   node-array pointer.
;
(fn ast_nodes
  (params
    (ast ptr))
  (returns ptr)
  (do
    (return
      (load_ptr
        (call_ptr
          ast_nodes_field
          (param_get ast))))))

;
; ast_count
;
; Reads the number of nodes currently stored in an AST.
; The count also becomes the next appended node index.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   current node count.
;
(fn ast_count
  (params
    (ast ptr))
  (returns i64)
  (do
    (return
      (load_i64
        (call_ptr
          ast_count_field
          (param_get ast))))))

;
; ast_capacity
;
; Reads the allocated node capacity of an AST.
; Reserve logic compares this against requested node counts.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   allocated node capacity.
;
(fn ast_capacity
  (params
    (ast ptr))
  (returns i64)
  (do
    (return
      (load_i64
        (call_ptr
          ast_capacity_field
          (param_get ast))))))

; =============================================================================
; AST container field setters
; =============================================================================

;
; ast_set_nodes
;
; Writes the AST container `nodes` field.
; Mutators keep raw record writes out of higher-level compiler code.
;
; Parameters:
;   ast - AST container pointer.
;   nodes - function parameter.
;
; Returns:
;   no value.
;
(fn ast_set_nodes
  (params
    (ast ptr)
    (nodes ptr))
  (returns void)
  (do
    (store_ptr
      (call_ptr
        ast_nodes_field
        (param_get ast))
      (param_get nodes))
    (return_void)))

;
; ast_set_count
;
; Writes the AST container `count` field.
; Mutators keep raw record writes out of higher-level compiler code.
;
; Parameters:
;   ast - AST container pointer.
;   count - number of nodes, bytes, or entries.
;
; Returns:
;   no value.
;
(fn ast_set_count
  (params
    (ast ptr)
    (count i64))
  (returns void)
  (do
    (store_i64
      (call_ptr
        ast_count_field
        (param_get ast))
      (param_get count))
    (return_void)))

;
; ast_set_capacity
;
; Writes the AST container `capacity` field.
; Mutators keep raw record writes out of higher-level compiler code.
;
; Parameters:
;   ast - AST container pointer.
;   capacity - allocated entry capacity.
;
; Returns:
;   no value.
;
(fn ast_set_capacity
  (params
    (ast ptr)
    (capacity i64))
  (returns void)
  (do
    (store_i64
      (call_ptr
        ast_capacity_field
        (param_get ast))
      (param_get capacity))
    (return_void)))

; =============================================================================
; Node memory layout: field address accessors
; =============================================================================

;
; ast_node_at
;
; Computes the address of a node by index.
; The address is derived from the fixed node size and base array pointer.
;
; Parameters:
;   ast - AST container pointer.
;   index - zero-based node, token, or byte index.
;
; Returns:
;   pointer to the requested node.
;
(fn ast_node_at
  (params
    (ast ptr)
    (index i64))
  (returns ptr)
  (do
    (return
      (ptr_add
        (call_ptr
          ast_nodes
          (param_get ast))
        (mul_i64
          (param_get index)
          (call_i64 ast_node_size))))))

;
; node_kind_field
;
; Returns the address of the AST node `kind` field.
; All node fields are fixed offsets within the 64-byte node record.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   node - AST node index.
;
; Returns:
;   pointer to the node `kind` field.
;
(fn node_kind_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (param_get node))))

;
; node_op_type_field
;
; Returns the address of the AST node `op_type` field.
; All node fields are fixed offsets within the 64-byte node record.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   node - AST node index.
;
; Returns:
;   pointer to the node `op_type` field.
;
(fn node_op_type_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 8)))))

;
; node_a_field
;
; Returns the address of the AST node `a` field.
; All node fields are fixed offsets within the 64-byte node record.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   node - AST node index.
;
; Returns:
;   pointer to the node `a` field.
;
(fn node_a_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 16)))))

;
; node_b_field
;
; Returns the address of the AST node `b` field.
; All node fields are fixed offsets within the 64-byte node record.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   node - AST node index.
;
; Returns:
;   pointer to the node `b` field.
;
(fn node_b_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 24)))))

;
; node_c_field
;
; Returns the address of the AST node `c` field.
; All node fields are fixed offsets within the 64-byte node record.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   node - AST node index.
;
; Returns:
;   pointer to the node `c` field.
;
(fn node_c_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 32)))))

;
; node_d_field
;
; Returns the address of the AST node `d` field.
; All node fields are fixed offsets within the 64-byte node record.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   node - AST node index.
;
; Returns:
;   pointer to the node `d` field.
;
(fn node_d_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 40)))))

;
; node_text_start_field
;
; Returns the address of the AST node `text_start` field.
; All node fields are fixed offsets within the 64-byte node record.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   node - AST node index.
;
; Returns:
;   pointer to the node `text_start` field.
;
(fn node_text_start_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 48)))))

;
; node_text_len_field
;
; Returns the address of the AST node `text_len` field.
; All node fields are fixed offsets within the 64-byte node record.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   node - AST node index.
;
; Returns:
;   pointer to the node `text_len` field.
;
(fn node_text_len_field
  (params
    (node ptr))
  (returns ptr)
  (do
    (return
      (ptr_add
        (param_get node)
        (const_i64 56)))))

; =============================================================================
; AST container lifecycle
; =============================================================================

;
; ast_new
;
; Allocates and initializes an AST container.
; The node array is allocated with the initial capacity and zero count.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Returns:
;   AST container pointer, or null on allocation failure.
;
(fn ast_new
  (params)
  (returns ptr)
  (do
    (let
      ast
      ptr
      (call_ptr
        malloc
        (call_i64 ast_size)))
    (if
      (condition
        (eq_ptr
          (local_get ast)
          (const_null)))
      (then
        (do
          (return
            (const_null))))
      (else
        (do)))
    (let
      capacity
      i64
      (call_i64 ast_initial_capacity))
    (let
      nodes
      ptr
      (call_ptr
        malloc
        (mul_i64
          (local_get capacity)
          (call_i64 ast_node_size))))
    (if
      (condition
        (eq_ptr
          (local_get nodes)
          (const_null)))
      (then
        (do
          (call_void
            free
            (local_get ast))
          (return
            (const_null))))
      (else
        (do)))
    (call_void
      ast_set_nodes
      (local_get ast)
      (local_get nodes))
    (call_void
      ast_set_count
      (local_get ast)
      (const_i64 0))
    (call_void
      ast_set_capacity
      (local_get ast)
      (local_get capacity))
    (return
      (local_get ast))))

;
; ast_free
;
; Releases heap storage owned by an AST container.
; Both node storage and the container header are freed.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   ast - AST container pointer.
;
; Returns:
;   no value.
;
(fn ast_free
  (params
    (ast ptr))
  (returns void)
  (do
    (if
      (condition
        (eq_ptr
          (param_get ast)
          (const_null)))
      (then
        (do
          (return_void)))
      (else
        (do)))
    (let
      nodes
      ptr
      (call_ptr
        ast_nodes
        (param_get ast)))
    (if
      (condition
        (ne_ptr
          (local_get nodes)
          (const_null)))
      (then
        (do
          (call_void
            free
            (local_get nodes))))
      (else
        (do)))
    (call_void
      free
      (param_get ast))
    (return_void)))

; =============================================================================
; Capacity management
; =============================================================================

;
; ast_reserve
;
; Ensures an AST can store at least the requested node count.
; Growth is explicit so append operations can write without hidden allocation.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   ast - AST container pointer.
;   needed - minimum required capacity.
;
; Returns:
;   0
;   on
;   success.
;   nonzero
;   on
;   allocation
;   failure.
;
(fn ast_reserve
  (params
    (ast ptr)
    (needed i64))
  (returns i32)
  (do
    (let
      capacity
      i64
      (call_i64
        ast_capacity
        (param_get ast)))
    (if
      (condition
        (le_i64
          (param_get needed)
          (local_get capacity)))
      (then
        (do
          (return
            (const_i32 0))))
      (else
        (do)))
    (let
      new_capacity
      i64
      (local_get capacity))
    (while
      (condition
        (lt_i64
          (local_get new_capacity)
          (param_get needed)))
      (do
        (set
          new_capacity
          (mul_i64
            (local_get new_capacity)
            (const_i64 2)))))
    (let
      new_nodes
      ptr
      (call_ptr
        realloc
        (call_ptr
          ast_nodes
          (param_get ast))
        (mul_i64
          (local_get new_capacity)
          (call_i64 ast_node_size))))
    (if
      (condition
        (eq_ptr
          (local_get new_nodes)
          (const_null)))
      (then
        (do
          (return
            (const_i32 1))))
      (else
        (do)))
    (call_void
      ast_set_nodes
      (param_get ast)
      (local_get new_nodes))
    (call_void
      ast_set_capacity
      (param_get ast)
      (local_get new_capacity))
    (return
      (const_i32 0))))

; =============================================================================
; Node insertion
; =============================================================================

;
; ast_push
;
; Appends one fully specified AST node to storage and returns its index.
; All constructors funnel through this helper to keep field placement consistent.
;
; Invariants:
;   - ast_reserve must provide capacity before writing the node.
;   - unused node fields are written as zero by callers.
;
; Notes:
;   This manual storage helper is intentionally direct so offsets stay auditable.
;
; Parameters:
;   ast - AST container pointer.
;   kind - token or AST kind id.
;   op_or_type - function parameter.
;   a - first AST payload field.
;   b - second AST payload field.
;   c - third AST payload field.
;   d - fourth AST payload field.
;   text_start - source byte offset of the text span.
;   text_len - text span byte length.
;
; Returns:
;   new AST node index on success.
;   -1 on allocation failure.
;
(fn ast_push
  (params
    (ast ptr)
    (kind i32)
    (op_or_type i64)
    (a i64)
    (b i64)
    (c i64)
    (d i64)
    (text_start i64)
    (text_len i64))
  (returns i64)
  (do
    (let
      count
      i64
      (call_i64
        ast_count
        (param_get ast)))
    (let
      needed
      i64
      (add_i64
        (local_get count)
        (const_i64 1)))
    (if
      (condition
        (ne_i32
          (call_i32
            ast_reserve
            (param_get ast)
            (local_get needed))
          (const_i32 0)))
      (then
        (do
          (return
            (const_i64 -1))))
      (else
        (do)))
    (let
      node
      ptr
      (call_ptr
        ast_node_at
        (param_get ast)
        (local_get count)))
    (store_i32
      (call_ptr
        node_kind_field
        (local_get node))
      (param_get kind))
    (store_i64
      (call_ptr
        node_op_type_field
        (local_get node))
      (param_get op_or_type))
    (store_i64
      (call_ptr
        node_a_field
        (local_get node))
      (param_get a))
    (store_i64
      (call_ptr
        node_b_field
        (local_get node))
      (param_get b))
    (store_i64
      (call_ptr
        node_c_field
        (local_get node))
      (param_get c))
    (store_i64
      (call_ptr
        node_d_field
        (local_get node))
      (param_get d))
    (store_i64
      (call_ptr
        node_text_start_field
        (local_get node))
      (param_get text_start))
    (store_i64
      (call_ptr
        node_text_len_field
        (local_get node))
      (param_get text_len))
    (call_void
      ast_set_count
      (param_get ast)
      (local_get needed))
    (return
      (local_get count))))
))
