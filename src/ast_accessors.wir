; SPDX-License-Identifier: Apache-2.0
; ast_accessors.wir
;
; AST node field accessor functions.
;
; Responsibilities:
;   - expose typed reads from the fixed AST node layout
;   - keep emitter and parser code independent of byte offsets
;   - centralize node field naming for auditability
;
; Callers are responsible for passing a valid AST pointer and node index.

(core-module
  (core-version 2)
  (decls

; =============================================================================
; AST field reads
; =============================================================================

;
; ast_kind_at
;
; Reads the `kind` field from a node in AST storage.
; This hides the fixed node byte layout from parser and emitter code.
;
; Parameters:
;   ast - AST container pointer.
;   index - zero-based node, token, or byte index.
;
; Returns:
;   node `kind` field value.
;
(fn ast_kind_at
      (params
        (ast ptr)
        (index i64))
      (returns i32)
      (do
        (return
          (load_i32
            (call_ptr
              node_kind_field
              (call_ptr
                ast_node_at
                (param_get ast)
                (param_get index)))))))

;
