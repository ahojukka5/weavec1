; ast_accessors.wir
; AST node field accessor functions.
; Provides high-level access to node properties like kind,
; operator/type, child references, and text spans.

(core-module
  (core-version 1)
  (decls
    (fn
      ast_kind_at
      (params
        (ast ptr)
        (index i64))
      (returns i32)
      (do
        (return
          (load_i32
            (call_ptr
              node_kind_field
              (call_ptr
                ast_node_at
                (param_get ast)
                (param_get index)))))))
    (fn
      ast_op_type_at
      (params
        (ast ptr)
        (index i64))
      (returns i64)
      (do
        (return
          (load_i64
            (call_ptr
              node_op_type_field
              (call_ptr
                ast_node_at
                (param_get ast)
                (param_get index)))))))
    (fn
      ast_a_at
      (params
        (ast ptr)
        (index i64))
      (returns i64)
      (do
        (return
          (load_i64
            (call_ptr
              node_a_field
              (call_ptr
                ast_node_at
                (param_get ast)
                (param_get index)))))))
    (fn
      ast_b_at
      (params
        (ast ptr)
        (index i64))
      (returns i64)
      (do
        (return
          (load_i64
            (call_ptr
              node_b_field
              (call_ptr
                ast_node_at
                (param_get ast)
                (param_get index)))))))
    (fn
      ast_c_at
      (params
        (ast ptr)
        (index i64))
      (returns i64)
      (do
        (return
          (load_i64
            (call_ptr
              node_c_field
              (call_ptr
                ast_node_at
                (param_get ast)
                (param_get index)))))))
    (fn
      ast_d_at
      (params
        (ast ptr)
        (index i64))
      (returns i64)
      (do
        (return
          (load_i64
            (call_ptr
              node_d_field
              (call_ptr
                ast_node_at
                (param_get ast)
                (param_get index)))))))
    (fn
      ast_text_start_at
      (params
        (ast ptr)
        (index i64))
      (returns i64)
      (do
        (return
          (load_i64
            (call_ptr
              node_text_start_field
              (call_ptr
                ast_node_at
                (param_get ast)
                (param_get index)))))))
    (fn
      ast_text_len_at
      (params
        (ast ptr)
        (index i64))
      (returns i64)
      (do
        (return
          (load_i64
            (call_ptr
              node_text_len_field
              (call_ptr
                ast_node_at
                (param_get ast)
                (param_get index)))))))
))
