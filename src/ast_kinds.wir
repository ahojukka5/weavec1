; SPDX-License-Identifier: Apache-2.0
; ast_kinds.wir
;
; AST node kind constants, type constants, and operator constants.
;
; Responsibilities:
;   - define integer constants for every AST node kind
;   - define integer constants for the WIR type system
;   - define integer constants for every WIR operator
;
; Design note:
;   WIR has no global constant declarations, so every constant is
;   represented as a zero-argument function returning an i32.
;   This is intentional: it keeps the language minimal and uniform.
;   Constants are inlined by the emitter during compilation.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; AST node kind constants
; =============================================================================

;
; ast_program
;
; Returns the AST node kind id for `program` nodes.
; Parser constructors store this id in each node kind field for emitter dispatch.
;
; Returns:
;   AST node kind id.
;
(fn ast_program
  (params)
  (returns i32)
  (do
    (return
      (const_i32 1))))

;
; ast_extern
