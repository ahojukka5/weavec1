; =============================================================================
; Pointer and cast operator constants
; =============================================================================

; op_ptr_add
;
; Operator id for pointer arithmetic (pointer + i64 byte offset).
; Maps to LLVM getelementptr i8.
;
; Returns:
;   operator constant 60.

(fn
  op_ptr_add
  (params)
  (returns i32)
  (do
    (return
      (const_i32 60))))

; op_cast_i64_to_i32
;
; Operator id for narrowing cast from i64 to i32.
; Maps to LLVM trunc.
;
; Returns:
;   operator constant 61.

(fn
  op_cast_i64_to_i32
  (params)
  (returns i32)
  (do
    (return
      (const_i32 61))))

; op_cast_i32_to_i64
;
; Operator id for sign-extending cast from i32 to i64.
; Maps to LLVM sext.
;
; Returns:
;   operator constant 62.

(fn
  op_cast_i32_to_i64
  (params)
  (returns i32)
  (do
    (return
      (const_i32 62))))

