; SPDX-License-Identifier: Apache-2.0
; parser_expect.wir
;
; Parser token cursor helpers.
;
; Responsibilities:
;   - expose the current token kind and source span
;   - advance or conditionally match tokens
;   - record parse errors when expected tokens are missing
;
; These helpers keep syntax routines concise and make error contracts uniform.

(core-module
  (core-version 2)
  (decls

; =============================================================================
; Token cursor reads
; =============================================================================

;
; parser_current_kind
;
; Reads the current token kind from parser state.
; This keeps parser routines independent of token-array offsets.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   current token kind id.
;
(fn parser_current_kind
      (params
        (parser ptr))
      (returns i32)
      (do
        (return
          (call_i32
            token_kind_at
            (call_ptr
              parser_tokens
              (param_get parser))
            (call_i64
              parser_index
              (param_get parser))))))

;
; parser_current_start
;
; Reads the current token source start offset.
; Parsers use this offset when constructing AST text spans.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   current token kind id.
;
(fn parser_current_start
      (params
        (parser ptr))
      (returns i64)
      (do
        (return
          (call_i64
            token_start_at
            (call_ptr
              parser_tokens
              (param_get parser))
            (call_i64
              parser_index
              (param_get parser))))))

;
; parser_current_length
;
; Reads the current token source length.
; Parsers store this length on AST nodes that carry names or strings.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   current token source byte offset.
;
(fn parser_current_length
      (params
        (parser ptr))
      (returns i64)
      (do
        (return
          (call_i64
            token_length_at
            (call_ptr
              parser_tokens
              (param_get parser))
            (call_i64
              parser_index
              (param_get parser))))))

;
; parser_peek_kind
;
; Reads the token kind one position ahead without advancing the cursor.
; Used to recognize optional empty lists such as (params ()).
;
(fn parser_peek_kind
      (params
        (parser ptr))
      (returns i32)
      (do
        (return
          (call_i32
            token_kind_at
            (call_ptr
              parser_tokens
              (param_get parser))
            (add_i64
              (call_i64
                parser_index
                (param_get parser))
              (const_i64 1))))))

; =============================================================================
; Token cursor movement
; =============================================================================

;
; parser_advance
;
; Advances the parser cursor by one token.
; The cursor is the only mutable parser position shared across parse routines.
;
; Parameters:
;   parser - parser state pointer.
;
; Returns:
;   current token byte length.
;
(fn parser_advance
      (params
        (parser ptr))
      (returns void)
      (do
        (call_void
          parser_set_index
          (param_get parser)
          (add_i64
            (call_i64
              parser_index
              (param_get parser))
            (const_i64 1)))
        (return_void)))

; =============================================================================
; Expectation helpers
; =============================================================================

;
; parser_match
;
; Consumes the current token when it matches the requested kind.
; Optional syntax uses this to branch without recording an error.
;
; Parameters:
;   parser - parser state pointer.
;   kind - token or AST kind id.
;
; Returns:
;   no value.
;
(fn parser_match
      (params
        (parser ptr)
        (kind i32))
      (returns bool)
      (do
        (return
          (eq_i32
            (call_i32
              parser_current_kind
              (param_get parser))
            (param_get kind)))))

;
; parser_expect
;
; Consumes the requested token kind or records a parse error.
; Required syntax uses this so parse failures share one error convention.
;
; Parameters:
;   parser - parser state pointer.
;   kind - token or AST kind id.
;
; Returns:
;   0 when the expected token was consumed.
;   nonzero after recording a parse error.
;
(fn parser_expect
      (params
        (parser ptr)
        (kind i32))
      (returns i32)
      (do
        (if
          (condition
            (call_bool
              parser_match
              (param_get parser)
              (param_get kind)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (return
                (const_i32 0))))
          (else
            (do
              (call_void
                parser_note_error_site
                (param_get parser))
              (return
                (const_i32 1)))))))

;
; parser_consume_optional_empty_paren_list
;
; After (params, consumes an optional empty child list written as ().
; Both (params) and (params ()) denote zero parameters.
;
(fn parser_consume_optional_empty_paren_list
      (params
        (parser ptr))
      (returns void)
      (do
        (if
          (condition
            (and_bool
              (call_bool
                parser_match
                (param_get parser)
                (call_i32 token_lparen))
              (eq_i32
                (call_i32
                  parser_peek_kind
                  (param_get parser))
                (call_i32 token_rparen))))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (if
                (condition
                  (ne_i32
                    (call_i32
                      parser_expect
                      (param_get parser)
                      (call_i32 token_rparen))
                    (const_i32 0)))
                (then
                  (do
                    (return_void)))
                (else
                  (do)))))
          (else
            (do)))
        (return_void)))
))
