; parser_expect.wir
;
; Parser token cursor helpers.
;
; Responsibilities:
;   - expose the current token kind and source span
;   - advance or conditionally match tokens
;   - record parse errors when expected tokens are missing
;
; These helpers keep syntax routines concise and make error contracts uniform.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Token cursor reads
; =============================================================================

; parser_current_kind
;
; Reads the current token kind from parser state.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   i32 result value.
(fn parser_current_kind
      (params
        (parser ptr))
      (returns i32)
      (do
        (return
          (call_i32
            token_kind_at
            (call_ptr
              parser_tokens
              (param_get parser))
            (call_i64
              parser_index
              (param_get parser))))))

; parser_current_start
;
; Reads the current token start from parser state.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   i64 result value.
(fn parser_current_start
      (params
        (parser ptr))
      (returns i64)
      (do
        (return
          (call_i64
            token_start_at
            (call_ptr
              parser_tokens
              (param_get parser))
            (call_i64
              parser_index
              (param_get parser))))))

; parser_current_length
;
; Reads the current token length from parser state.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   i64 result value.
(fn parser_current_length
      (params
        (parser ptr))
      (returns i64)
      (do
        (return
          (call_i64
            token_length_at
            (call_ptr
              parser_tokens
              (param_get parser))
            (call_i64
              parser_index
              (param_get parser))))))

; =============================================================================
; Token cursor movement
; =============================================================================

; parser_advance
;
; Provides parser behavior for advance.
;
;
; Parameters:
;   parser - Parser state pointer.
; Returns:
;   no value.
(fn parser_advance
      (params
        (parser ptr))
      (returns void)
      (do
        (call_void
          parser_set_index
          (param_get parser)
          (add_i64
            (call_i64
              parser_index
              (param_get parser))
            (const_i64 1)))
        (return_void)))

; =============================================================================
; Expectation helpers
; =============================================================================

; parser_match
;
; Provides parser behavior for match.
;
; Parameters:
;   parser - Parser state pointer.
;
;   kind - Integer kind id.
; Returns:
;   true when the predicate matches.
;   false otherwise.
(fn parser_match
      (params
        (parser ptr)
        (kind i32))
      (returns bool)
      (do
        (return
          (eq_i32
            (call_i32
              parser_current_kind
              (param_get parser))
            (param_get kind)))))

; parser_expect
;
; Provides parser behavior for expect.
;
; Parameters:
;   parser - Parser state pointer.
;
;   kind - Integer kind id.
; Returns:
;   0 on success or a successful false/no result when documented by the caller.
;   nonzero on failure or true/yes result depending on the predicate.
(fn parser_expect
      (params
        (parser ptr)
        (kind i32))
      (returns i32)
      (do
        (if
          (condition
            (call_bool
              parser_match
              (param_get parser)
              (param_get kind)))
          (then
            (do
              (call_void
                parser_advance
                (param_get parser))
              (return
                (const_i32 0))))
          (else
            (do
              (return
                (const_i32 1)))))))
))
