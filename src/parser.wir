              (eq_i32 (local_get op_id) (call_i32 op_call_void))))

          (then
            (block
              (call_void parser_advance
                (param_get parser))

              (if
                (ne_i32
                  (call_i32 parser_current_kind
                    (param_get parser))
                  (call_i32 token_ident))

                (then
                  (return
                    (const_i64 -1)))

                (else
                  (block)))

              (let call_name_start i64
                (call_i64 parser_current_start
                  (param_get parser)))

              (let call_name_len i64
                (call_i64 parser_current_length
                  (param_get parser)))

              (call_void parser_advance
                (param_get parser))

              (let call_arg_first i64
                (call_i64 ast_count
                  (call_ptr parser_ast
                    (param_get parser))))

              (let call_arg_count i64
                (const_i64 0))

              (while
                (not_bool
                  (call_bool parser_match
                    (param_get parser)
                    (call_i32 token_rparen)))

                (body
                  (block
                    (let call_arg i64
                      (call_i64 parser_parse_expression
                        (param_get parser)))

                    (if
                      (lt_i64
                        (local_get call_arg)
                        (const_i64 0))

                      (then
                        (return
                          (const_i64 -1)))

                      (else
                        (block)))

                    (set call_arg_count
                      (add_i64
                        (local_get call_arg_count)
                        (const_i64 1))))))

              (if
                (ne_i32
                  (call_i32 parser_expect
                    (param_get parser)
                    (call_i32 token_rparen))
                  (const_i32 0))

                (then
                  (return
                    (const_i64 -1)))

                (else
                  (block)))

              (return
                (call_i64 ast_make_call
                  (call_ptr parser_ast
                    (param_get parser))
                  (local_get op_id)
                  (local_get call_arg_first)
                  (local_get call_arg_count)
                  (local_get call_name_start)
                  (local_get call_name_len)))))

          (else
            (block)))

        (call_void parser_advance
          (param_get parser))

        ; parse arguments
        (let arg_first i64
          (call_i64 ast_count
            (call_ptr parser_ast
              (param_get parser))))

        (let arg_count i64
          (const_i64 0))

        (while
          (not_bool
            (call_bool parser_match
              (param_get parser)
              (call_i32 token_rparen)))

          (body
            (block
              (let arg i64
                (call_i64 parser_parse_expression
                  (param_get parser)))

              (if
                (lt_i64
                  (local_get arg)
                  (const_i64 0))

                (then
                  (return
                    (const_i64 -1)))

                (else
                  (block)))

              (set arg_count
                (add_i64
                  (local_get arg_count)
                  (const_i64 1))))))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_rparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        ; generic call-like AST node
        (return
          (call_i64 ast_make_call
            (call_ptr parser_ast
              (param_get parser))
            (local_get op_id)
            (local_get arg_first)
            (local_get arg_count)
            (local_get op_start)
            (local_get op_length)))))

    ; -------------------------------------------------------------------------
    ; Parse function
    ; -------------------------------------------------------------------------

    (fn parser_parse_function
      (params
        (parser ptr))
      (returns i64)
      (body
        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_lparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (eq_i32
            (call_i32 parser_current_kind
              (param_get parser))
            (call_i32 token_extern))

          (then
            (block
              (if
                (ne_i32
                  (call_i32 parser_skip_extern_opened
                    (param_get parser))
                  (const_i32 0))
                (then
                  (return
                    (const_i64 -1)))
                (else
                  (block)))

              (return
                (call_i64 ast_make_extern
                  (call_ptr parser_ast
                    (param_get parser))
                  (call_i32 type_void)
                  (const_i64 0)
                  (const_i64 0)
                  (const_i64 0)
                  (const_i64 0)))))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_fn))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_current_kind
              (param_get parser))
            (call_i32 token_ident))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (let name_start i64
          (call_i64 parser_current_start
            (param_get parser)))

        (let name_len i64
          (call_i64 parser_current_length
            (param_get parser)))

        (call_void parser_advance
          (param_get parser))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_lparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_params))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (let param_first i64
          (call_i64 ast_count
            (call_ptr parser_ast
              (param_get parser))))

        (let param_count i64
          (const_i64 0))

        (while
          (not_bool
            (call_bool parser_match
              (param_get parser)
              (call_i32 token_rparen)))

          (body
            (block
              (if
                (ne_i32
                  (call_i32 parser_expect
                    (param_get parser)
                    (call_i32 token_lparen))
                  (const_i32 0))

                (then
                  (return
                    (const_i64 -1)))

                (else
                  (block)))

              (if
                (ne_i32
                  (call_i32 parser_current_kind
                    (param_get parser))
                  (call_i32 token_ident))

                (then
                  (return
                    (const_i64 -1)))

                (else
                  (block)))

              (let param_name_start i64
                (call_i64 parser_current_start
                  (param_get parser)))

              (let param_name_len i64
                (call_i64 parser_current_length
                  (param_get parser)))

              (call_void parser_advance
                (param_get parser))

              (let type_id i32
                (call_i32 parser_parse_type
                  (param_get parser)))

              (if
                (lt_i32
                  (local_get type_id)
                  (const_i32 0))

                (then
                  (return
                    (const_i64 -1)))

                (else
                  (block)))

              (if
                (ne_i32
                  (call_i32 parser_expect
                    (param_get parser)
                    (call_i32 token_rparen))
                  (const_i32 0))

                (then
                  (return
                    (const_i64 -1)))

                (else
                  (block)))

              (call_i64 ast_make_param
                (call_ptr parser_ast
                  (param_get parser))
                (local_get type_id)
                (local_get param_name_start)
                (local_get param_name_len))

              (set param_count
                (add_i64
                  (local_get param_count)
                  (const_i64 1))))))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_rparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_lparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_returns))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (let return_type i32
          (call_i32 parser_parse_type
            (param_get parser)))

        (if
          (lt_i32
            (local_get return_type)
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_rparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_lparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_body))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (let body_first i64
          (call_i64 ast_count
            (call_ptr parser_ast
              (param_get parser))))

        (let body_last i64
          (const_i64 -1))

        (let body_count i64
          (const_i64 0))

        (while
          (not_bool
            (call_bool parser_match
              (param_get parser)
              (call_i32 token_rparen)))

          (body
            (block
              (let body_stmt i64
                (call_i64 parser_parse_stmt
                  (param_get parser)))

              (if
                (lt_i64
                  (local_get body_stmt)
                  (const_i64 0))

                (then
                  (return
                    (const_i64 -1)))

                (else
                  (block)))

              (set body_last
                (local_get body_stmt))

              (set body_count
                (add_i64
                  (local_get body_count)
                  (const_i64 1))))))

        (let body_node i64
          (call_i64 ast_make_block
            (call_ptr parser_ast
              (param_get parser))
            (local_get body_first)
            (local_get body_last)
            (local_get body_count)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_rparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_rparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (return
          (call_i64 ast_make_function
            (call_ptr parser_ast
              (param_get parser))
            (local_get return_type)
            (local_get param_first)
            (local_get param_count)
            (local_get body_node)
            (local_get name_start)
            (local_get name_len)))))

    ; -------------------------------------------------------------------------
    ; Parse top-level form
    ; -------------------------------------------------------------------------

    (fn parser_skip_extern_opened
      (params
        (parser ptr))
      (returns i32)
      (body
        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_extern))
            (const_i32 0))
          (then (return (const_i32 1)))
          (else (block)))

        (if
          (ne_i32
            (call_i32 parser_current_kind
              (param_get parser))
            (call_i32 token_ident))
          (then (return (const_i32 1)))
          (else (block)))

        (call_void parser_advance
          (param_get parser))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_lparen))
            (const_i32 0))
          (then (return (const_i32 1)))
          (else (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_params))
            (const_i32 0))
          (then (return (const_i32 1)))
          (else (block)))

        (while
          (not_bool
            (call_bool parser_match
              (param_get parser)
              (call_i32 token_rparen)))
          (body
            (block
              (if
                (ne_i32
                  (call_i32 parser_expect
                    (param_get parser)
                    (call_i32 token_lparen))
                  (const_i32 0))
                (then (return (const_i32 1)))
                (else (block)))

              (if
                (ne_i32
                  (call_i32 parser_current_kind
                    (param_get parser))
                  (call_i32 token_ident))
                (then (return (const_i32 1)))
                (else (block)))

              (call_void parser_advance
                (param_get parser))

              (if
                (lt_i32
                  (call_i32 parser_parse_type
                    (param_get parser))
                  (const_i32 0))
                (then (return (const_i32 1)))
                (else (block)))

              (if
                (ne_i32
                  (call_i32 parser_expect
                    (param_get parser)
                    (call_i32 token_rparen))
                  (const_i32 0))
                (then (return (const_i32 1)))
                (else (block))))))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_rparen))
            (const_i32 0))
          (then (return (const_i32 1)))
          (else (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_lparen))
            (const_i32 0))
          (then (return (const_i32 1)))
          (else (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_returns))
            (const_i32 0))
          (then (return (const_i32 1)))
          (else (block)))

        (if
          (lt_i32
            (call_i32 parser_parse_type
              (param_get parser))
            (const_i32 0))
          (then (return (const_i32 1)))
          (else (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_rparen))
            (const_i32 0))
          (then (return (const_i32 1)))
          (else (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_rparen))
            (const_i32 0))
          (then (return (const_i32 1)))
          (else (block)))

        (return
          (const_i32 0))))

    (fn parser_parse_toplevel
      (params
        (parser ptr))
      (returns i64)
      (body
        (if
          (ne_i32
            (call_i32 parser_current_kind
              (param_get parser))
            (call_i32 token_lparen))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_lparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_core_module))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_lparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_core_version))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_current_kind
              (param_get parser))
            (call_i32 token_int))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (let version i32
          (call_i32 token_value_at
            (call_ptr parser_tokens
              (param_get parser))
            (call_i64 parser_index
              (param_get parser))))

        (if
          (ne_i32
            (local_get version)
            (const_i32 1))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (call_void parser_advance
          (param_get parser))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_rparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_lparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_decls))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (let first i64
          (call_i64 ast_count
            (call_ptr parser_ast
              (param_get parser))))

        (let count i64
          (const_i64 0))

        (while
          (not_bool
            (call_bool parser_match
              (param_get parser)
              (call_i32 token_rparen)))

          (body
            (block
              (let decl i64
                (call_i64 parser_parse_function
                  (param_get parser)))

              (if
                (lt_i64
                  (local_get decl)
                  (const_i64 0))

                (then
                  (return
                    (const_i64 -1)))

                (else
                  (block)))

              (if
                (eq_i32
                  (call_i32 ast_kind_at
                    (call_ptr parser_ast
                      (param_get parser))
                    (local_get decl))
                  (call_i32 ast_function))
                (then
                  (set count
                    (add_i64
                      (local_get count)
                      (const_i64 1))))
                (else
                  (block))))))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_rparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_rparen))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (if
          (ne_i32
            (call_i32 parser_expect
              (param_get parser)
              (call_i32 token_eof))
            (const_i32 0))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (return
          (call_i64 ast_make_program
            (call_ptr parser_ast
              (param_get parser))
            (local_get first)
            (add_i64
              (local_get first)
              (local_get count))
            (local_get count)))))

    ; -------------------------------------------------------------------------
    ; Public entry point
    ; -------------------------------------------------------------------------

    (fn parse
      (params
        (parser ptr))
      (returns i64)
      (body
        (if
          (eq_ptr
            (param_get parser)
            (const_null))

          (then
            (return
              (const_i64 -1)))

          (else
            (block)))

        (return
          (call_i64 parser_parse_toplevel
            (param_get parser)))))))
