; driver.wir
;
; Compiler driver orchestration.
;
; Responsibilities:
;   - load source text when compiling files
;   - create parser and output buffers
;   - run parse and LLVM emission phases in order
;   - expose file, buffer, and string compilation entry points
;
; This module owns phase sequencing, not parsing or emission details.

(core-module
  (core-version 1)
  (decls

; =============================================================================
; Driver entry points
; =============================================================================

;
; driver_error
;
; Writes a driver-level error message and returns a failure code.
; Driver helpers use this for file IO and pipeline failures.
;
; Parameters:
;   message - message text pointer.
;
; Returns:
;   nonzero failure status.
;
(fn driver_error
      (params
        (message ptr))
      (returns i32)
      (do
        (call_i32
          puts
          (param_get message))
        (return
          (const_i32 1))))

;
; compile_buffer_to_buffer
;
; Runs the compiler pipeline for `buffer to buffer`.
; The driver owns phase order while parser and emitter modules own details.
;
; Parameters:
;   source_data - function parameter.
;   source_length_value - function parameter.
;   source_path - function parameter.
;   output - output buffer pointer.
;
; Returns:
;   0 on success.
;   nonzero on compile or IO failure.
;
(fn compile_buffer_to_buffer
      (params
        (source_data ptr)
        (source_length_value i64)
        (source_path ptr)
        (output ptr))
      (returns i32)
      (do
        (if
          (condition
            (or_bool
              (eq_ptr
                (param_get source_data)
                (const_null))
              (eq_ptr
                (param_get output)
                (const_null))))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          source
          ptr
          (call_ptr
            source_new
            (param_get source_data)
            (param_get source_length_value)
            (param_get source_path)))
        (if
          (condition
            (eq_ptr
              (local_get source)
              (const_null)))
          (then
            (do
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          tokens
          ptr
          (call_ptr tokens_new))
        (if
          (condition
            (eq_ptr
              (local_get tokens)
              (const_null)))
          (then
            (do
              (call_void
                source_free
                (local_get source))
              (return
                (const_i32 1))))
          (else
            (do)))
        (if
          (condition
            (ne_i32
              (call_i32
                lex
                (local_get source)
                (local_get tokens))
              (const_i32 0)))
          (then
            (do
              (call_void
                tokens_free
                (local_get tokens))
              (call_void
                source_free
                (local_get source))
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          tree
          ptr
          (call_ptr ast_new))
        (if
          (condition
            (eq_ptr
              (local_get tree)
              (const_null)))
          (then
            (do
              (call_void
                tokens_free
                (local_get tokens))
              (call_void
                source_free
                (local_get source))
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          parser
          ptr
          (call_ptr
            parser_new
            (local_get source)
            (local_get tokens)
            (local_get tree)))
        (if
          (condition
            (eq_ptr
              (local_get parser)
              (const_null)))
          (then
            (do
              (call_void
                ast_free
                (local_get tree))
              (call_void
                tokens_free
                (local_get tokens))
              (call_void
                source_free
                (local_get source))
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          program_node
          i64
          (call_i64
            parse
            (local_get parser)))
        (if
          (condition
            (lt_i64
              (local_get program_node)
              (const_i64 0)))
          (then
            (do
              (let
                parse_error_code
                i32
                (call_i32
                  parser_error_code
                  (local_get parser)))
              (call_void
                parser_free
                (local_get parser))
              (call_void
                ast_free
                (local_get tree))
              (call_void
                tokens_free
                (local_get tokens))
              (call_void
                source_free
                (local_get source))
              (if
                (condition
                  (eq_i32
                    (local_get parse_error_code)
                    (const_i32 1)))
                (then
                  (do
                    (call_i32
                      driver_error
                      (const_string_ptr "error: unknown operator"))
                    (return
                      (const_i32 1))))
                (else
                  (do)))
              (if
                (condition
                  (eq_i32
                    (local_get parse_error_code)
                    (const_i32 2)))
                (then
                  (do
                    (call_i32
                      driver_error
                      (const_string_ptr "error: invalid operator arity"))
                    (return
                      (const_i32 1))))
                (else
                  (do)))
              (call_i32
                driver_error
                (const_string_ptr "error: parse failed"))
              (return
                (const_i32 1))))
          (else
            (do)))
        (let
          emit_status
          i32
          (call_i32
            emit_llvm
            (local_get source)
            (local_get tree)
            (local_get program_node)
            (param_get output)))
        (if
          (condition
            (ne_i32
              (local_get emit_status)
              (const_i32 0)))
          (then
            (do
              (call_void
                parser_free
                (local_get parser))
              (call_void
                ast_free
                (local_get tree))
              (call_void
                tokens_free
                (local_get tokens))
              (call_void
                source_free
                (local_get source))
              (call_i32
                driver_error
                (const_string_ptr "error: emit llvm failed"))
              (return
                (const_i32 1))))
          (else
            (do)))
        (call_void
          parser_free
          (local_get parser))
        (call_void
          ast_free
          (local_get tree))
        (call_void
          tokens_free
          (local_get tokens))
        (call_void
          source_free
          (local_get source))
        (return
          (local_get emit_status))))

;
; compile_file
;
; Runs the compiler pipeline for `file`.
; The driver owns phase order while parser and emitter modules own details.
;
; Parameters:
;   input_path - input file path pointer.
;   output_path - output file path pointer.
;
; Returns:
;   0 on success.
;   nonzero on compile or IO failure.
;
(fn compile_file
      (params
        (input_path ptr)
        (output_path ptr))
      (returns i32)
      (do
        (return
          (call_i32
            compile_file_self_hosted
            (param_get input_path)
            (param_get output_path)))))

;
; compile_file_self_hosted
;
; Runs the compiler pipeline for `file self hosted`.
; The driver owns phase order while parser and emitter modules own details.
;
; Parameters:
;   input_path - input file path pointer.
;   output_path - output file path pointer.
;
; Returns:
;   0 on success.
;   nonzero on compile or IO failure.
;
(fn compile_file_self_hosted
      (params
        (input_path ptr)
        (output_path ptr))
      (returns i32)
      (do
        (if
          (condition
            (or_bool
              (eq_ptr
                (param_get input_path)
                (const_null))
              (eq_ptr
                (param_get output_path)
                (const_null))))
          (then
            (do
              (return
                (call_i32
                  driver_error
                  (const_string_ptr "error: invalid compiler arguments")))))
          (else
            (do)))
        (let
          length_storage
          ptr
          (call_ptr
            malloc
            (const_i64 8)))
        (if
          (condition
            (eq_ptr
              (local_get length_storage)
              (const_null)))
          (then
            (do
              (return
                (call_i32
                  driver_error
                  (const_string_ptr "error: could not allocate length storage")))))
          (else
            (do)))
        (store_i64
          (local_get length_storage)
          (const_i64 0))
        (let
          source_data
          ptr
          (call_ptr
            read_file
            (param_get input_path)
            (local_get length_storage)))
        (if
          (condition
            (eq_ptr
              (local_get source_data)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get length_storage))
              (return
                (call_i32
                  driver_error
                  (const_string_ptr "error: could not read input file")))))
          (else
            (do)))
        (let
          source_length_value
          i64
          (load_i64
            (local_get length_storage)))
        (call_void
          free
          (local_get length_storage))
        (let
          output
          ptr
          (call_ptr buffer_new))
        (if
          (condition
            (eq_ptr
              (local_get output)
              (const_null)))
          (then
            (do
              (call_void
                free
                (local_get source_data))
              (return
                (call_i32
                  driver_error
                  (const_string_ptr "error: could not allocate output buffer")))))
          (else
            (do)))
        (let
          status
          i32
          (call_i32
            compile_buffer_to_buffer
            (local_get source_data)
            (local_get source_length_value)
            (param_get input_path)
            (local_get output)))
        (if
          (condition
            (ne_i32
              (local_get status)
              (const_i32 0)))
          (then
            (do
              (call_void
                buffer_free
                (local_get output))
              (call_void
                free
                (local_get source_data))
              (return
                (call_i32
                  driver_error
                  (const_string_ptr "error: compilation failed")))))
          (else
            (do)))
        (let
          write_status
          i32
          (call_i32
            buffer_write_file
            (param_get output_path)
            (local_get output)))
        (if
          (condition
            (ne_i32
              (local_get write_status)
              (const_i32 0)))
          (then
            (do
              (call_void
                buffer_free
                (local_get output))
              (call_void
                free
                (local_get source_data))
              (return
                (call_i32
                  driver_error
                  (const_string_ptr "error: could not write output file")))))
          (else
            (do)))
        (call_void
          buffer_free
          (local_get output))
        (call_void
          free
          (local_get source_data))
        (return
          (const_i32 0))))

;
; compile_string
;
; Runs the compiler pipeline for `string`.
; The driver owns phase order while parser and emitter modules own details.
;
; Parameters:
;   source_text - null-terminated source text pointer.
;
; Returns:
;   0 on success.
;   nonzero on compile or IO failure.
;
(fn compile_string
      (params
        (source_text ptr))
      (returns ptr)
      (do
        (if
          (condition
            (eq_ptr
              (param_get source_text)
              (const_null)))
          (then
            (do
              (return
                (const_null))))
          (else
            (do)))
        (let
          output
          ptr
          (call_ptr buffer_new))
        (if
          (condition
            (eq_ptr
              (local_get output)
              (const_null)))
          (then
            (do
              (return
                (const_null))))
          (else
            (do)))
        (let
          length
          i64
          (call_i64
            strlen
            (param_get source_text)))
        (let
          status
          i32
          (call_i32
            compile_buffer_to_buffer
            (param_get source_text)
            (local_get length)
            (const_null)
            (local_get output)))
        (if
          (condition
            (ne_i32
              (local_get status)
              (const_i32 0)))
          (then
            (do
              (call_void
                buffer_free
                (local_get output))
              (return
                (const_null))))
          (else
            (do)))
        (return
          (local_get output))))))
